@model PopularRoutinesReportViewModel
@* Popular routines (UC27), shared by the Trainer and Admin areas' ReportsController. *@
@{
    ViewData["Title"] = "Popular routines";
    ViewData["Parent"] = User.IsInRole(AppRoles.Admin) ? "Insights" : "Reports";
    var toolbar = new ReportToolbarViewModel { Range = Model.Range, ReportKey = HealthTrack.Services.ReportService.PopularRoutines };
    var chart = new ChartCardViewModel
    {
        Title = "Top exercises by times logged", Series = Model.Chart, LabelHeader = "Exercise",
        EmptyText = "No exercises were logged in this period."
    };
}

<div class="page-head">
    <div class="intro">
        <span class="eyebrow">Report</span>
        <h1 class="h1 page-title">Popular routines</h1>
        <p>@(Model.AllClients ? "Every client" : "Your assigned clients"), @Model.Range.Text: routine templates by the clients following them, the exercises logged most and each category's share.</p>
    </div>
</div>

<partial name="_ReportToolbar" model="toolbar" />

<section class="card flush">
    <div class="card-head pad"><h2 class="h3">Routine templates</h2></div>
    @if (Model.Routines.Count == 0)
    {
        <p class="small muted card-pad-bottom">No routine templates yet. Trainers create them under Templates and assign copies to clients.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Template</th><th scope="col">Difficulty</th><th scope="col" class="r">Clients assigned</th><th scope="col" class="r">Active plans</th><th scope="col" class="r">Adherence</th></tr></thead>
                <tbody class="num">
                    @foreach (var routine in Model.Routines)
                    {
                        <tr>
                            <th scope="row">@routine.Title<span class="sub">by @routine.AuthorName</span></th>
                            <td><span class="badge diff-@((int)routine.Difficulty)">@routine.Difficulty.GetDisplayName()</span></td>
                            <td class="r">@routine.ClientsAssigned</td>
                            <td class="r">@routine.ActivePlans</td>
                            <td class="r">@(routine.AdherencePercent is { } adherence ? adherence + "%" : "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="grid g-2">
    <partial name="_ChartCard" model="chart" />
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">Share of each exercise category</h2></div>
        @if (Model.Categories.Count == 0)
        {
            <p class="small muted card-pad-bottom">Nothing logged in this period.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table compact">
                    <thead><tr><th scope="col">Category</th><th scope="col" class="r">Times logged</th><th scope="col">Share</th></tr></thead>
                    <tbody class="num">
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <th scope="row">@category.Label</th>
                                <td class="r">@category.Count</td>
                                <td><div class="load"><div class="bar"><i data-progress-width="@Math.Round(category.Percent)"></i></div><span class="pct">@category.Percent.ToString("0.0")%</span></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (Model.TopExercises.Count > 0)
{
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">Top 10 exercises</h2></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Exercise</th><th scope="col">Category</th><th scope="col" class="r">Times logged</th><th scope="col" class="r">Minutes</th><th scope="col" class="r">kcal burned</th></tr></thead>
                <tbody class="num">
                    @foreach (var exercise in Model.TopExercises)
                    {
                        <tr>
                            <th scope="row"><span class="cell-person"><img class="thumb thumb-sm" src="@ExercisePhotos.For(exercise.ExerciseName, exercise.Category)" alt="" />@exercise.ExerciseName</span></th>
                            <td>@exercise.Category.GetDisplayName()</td>
                            <td class="r">@exercise.TimesLogged</td>
                            <td class="r">@exercise.TotalMinutes.ToString("N0")</td>
                            <td class="r">@exercise.CaloriesBurned.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
