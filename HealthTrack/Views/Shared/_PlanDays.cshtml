@model IReadOnlyList<PlanDayViewModel>
@inject IClock Clock
@* A plan's training days as cards with photos: the client's week and the trainer's template preview. On the client's
   own plan (days with a date) each card says whether the day is done, today or still to come. *@
<div class="grid g-3">
    @foreach (var day in Model.Where(d => !d.IsRestDay))
    {
        <section class="card vs gp-16 @(day.IsToday && day.Date is not null ? "is-today" : string.Empty)">
            <div class="card-head">
                <h2 class="h2">@day.DayOfWeek</h2>
                @if (day.Date is { } date)
                {
                    if (day.IsLogged)
                    {
                        <span class="badge b-green">@Icons.Svg("check", 14)Done</span>
                    }
                    else if (day.IsToday)
                    {
                        <span class="badge b-accent">Today</span>
                    }
                    else if (date > Clock.Today)
                    {
                        <span class="badge">Coming up</span>
                    }
                    else
                    {
                        <span class="badge">Not logged</span>
                    }
                }
            </div>
            <ol class="list">
                @foreach (var line in day.Lines)
                {
                    <li class="hrow items-start">
                        <img class="thumb" src="@ExercisePhotos.For(line.ExerciseName, line.Category)" alt="" />
                        <div class="meal-line">
                            <div class="strong">@line.ExerciseName</div>
                            <div class="small muted">@line.Prescription</div>
                            @if (!string.IsNullOrEmpty(line.Notes))
                            {
                                <div class="xs subtle line-note">@line.Notes</div>
                            }
                            else if (line.Equipment is not null)
                            {
                                <div class="xs subtle">@line.Equipment</div>
                            }
                        </div>
                    </li>
                }
            </ol>
            @if (day.IsToday && day.Date is not null && !day.IsLogged)
            {
                <a class="btn btn-primary btn-block mt-auto-btn" asp-area="Client" asp-controller="Workouts" asp-action="Today">Start today's workout</a>
            }
        </section>
    }
</div>
