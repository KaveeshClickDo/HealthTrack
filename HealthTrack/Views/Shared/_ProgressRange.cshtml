@model ProgressRangeViewModel
@{
    // Live: the client's page re-fetches the chart data in place; otherwise the form reloads the page (trainer).
    var live = ViewData["LiveRange"] as bool? == true;
    var clientId = ViewData["ClientId"] as int?;
    var custom = Model.Range == ProgressRangeViewModel.Custom;
    var choices = new[]
    {
        (Value: ProgressRangeViewModel.FourWeeks, Text: "4 weeks"),
        (Value: ProgressRangeViewModel.ThreeMonths, Text: "3 months"),
        (Value: ProgressRangeViewModel.Custom, Text: "Custom")
    };
}
@* The range picker of the progress pages; wwwroot/js/progress-charts.js shows the custom dates and applies the range. *@
<form method="get" id="progress-range" class="card range-bar" data-live-range="@(live ? "true" : null)">
    @if (clientId is { } id)
    {
        <input type="hidden" name="clientId" value="@id" />
    }
    <div class="range-row">
        <div class="hrow gap-10">
            <span class="small subtle">Show</span>
            <div class="seg" role="group" aria-label="Range">
                @foreach (var choice in choices)
                {
                    <input type="radio" class="btn-check" name="range" id="range-@choice.Value" value="@choice.Value"
                           checked="@(Model.Range == choice.Value)" autocomplete="off" />
                    <label class="btn btn-ghost btn-sm" for="range-@choice.Value">@choice.Text</label>
                }
            </div>
        </div>
        <div class="hrow wrap gp-8 items-end" data-custom-range hidden="@(!custom)">
            <div>
                <label for="range-from" class="xs subtle">From</label>
                <input type="date" id="range-from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="input input-sm" disabled="@(!custom)" />
            </div>
            <div>
                <label for="range-to" class="xs subtle">To</label>
                <input type="date" id="range-to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="input input-sm" disabled="@(!custom)" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
        </div>
        <span class="small muted ml-auto hrow gp-6">@Icons.Svg("calendar", 16)<span data-range-text>@Model.From.ToString("dd MMM yyyy") &ndash; @Model.To.ToString("dd MMM yyyy")</span></span>
    </div>
</form>
