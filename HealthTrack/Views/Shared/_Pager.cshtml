@model PagerViewModel
@* Page links for a 20-row list; the links keep the list's filters. *@
@if (Model.TotalPages > 1)
{
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3" aria-label="Pages">
        <span class="small text-muted">Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount in total</span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-all-route-data="Model.For(Model.Page - 1)">Previous</a>
            </li>
            @for (var number = first; number <= last; number++)
            {
                <li class="page-item @(number == Model.Page ? "active" : string.Empty)">
                    <a class="page-link" asp-all-route-data="Model.For(number)" aria-current="@(number == Model.Page ? "page" : null)">@number</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-all-route-data="Model.For(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else if (Model.TotalCount > 0)
{
    <p class="small text-muted mt-3 mb-0">@Model.TotalCount in total</p>
}
