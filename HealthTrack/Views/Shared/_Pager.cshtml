@model PagerViewModel
@* The foot of a 20-row list card: where we are, and page links that keep the list's filters. Place it inside the
   .card.flush, after the table. *@
@if (Model.TotalPages > 1)
{
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="card-foot" aria-label="Pages">
        <span>Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount in total</span>
        <div class="actions gap-s">
            @if (Model.Page > 1)
            {
                <a class="btn btn-ghost btn-sm" asp-all-route-data="Model.For(Model.Page - 1)">Previous</a>
            }
            else
            {
                <span class="btn btn-ghost btn-sm" aria-disabled="true" disabled>Previous</span>
            }
            @for (var number = first; number <= last; number++)
            {
                if (number == Model.Page)
                {
                    <a class="btn btn-secondary btn-sm pager-current" asp-all-route-data="Model.For(number)" aria-current="page">@number</a>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm" asp-all-route-data="Model.For(number)">@number</a>
                }
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-ghost btn-sm" asp-all-route-data="Model.For(Model.Page + 1)">Next</a>
            }
            else
            {
                <span class="btn btn-ghost btn-sm" aria-disabled="true" disabled>Next</span>
            }
        </div>
    </nav>
}
else if (Model.TotalCount > 0)
{
    <div class="card-foot"><span>@Model.TotalCount in total</span></div>
}
