@model EngagementReportViewModel
@* Engagement (UC27), shared by the Trainer and Admin areas' ReportsController; administrators also get the trainer workload. *@
@{
    ViewData["Title"] = "Engagement";
    ViewData["Parent"] = Model.AllClients ? "Insights" : "Reports";
    var toolbar = new ReportToolbarViewModel { Range = Model.Range, ReportKey = HealthTrack.Services.ReportService.Engagement };
    var chart = new ChartCardViewModel
    {
        Title = Model.AllClients ? "Logins per day" : "Your clients' logins per day", Series = Model.Chart,
        EmptyText = "No logins in this period."
    };
}

<div class="page-head">
    <div class="intro">
        <span class="eyebrow">Report</span>
        <h1 class="h1 page-title">Engagement</h1>
        <p>@(Model.AllClients ? "Everyone" : "Your assigned clients"), @Model.Range.Text: how actively clients log their workouts, meals and measurements, how often people sign in, and how appointments went.</p>
    </div>
</div>

<partial name="_ReportToolbar" model="toolbar" />

<div class="grid g-4">
    <div class="card stat"><span class="stat-label"><span class="stat-icon i-blue">@Icons.Svg("users", 18)</span>Clients</span><span class="kpi">@Model.ClientsInScope</span></div>
    <div class="card stat"><span class="stat-label"><span class="stat-icon i-green">@Icons.Svg("activity", 18)</span>Active in the last 7 days</span><span class="kpi">@Model.ActiveClients</span><span class="stat-meta">Any log up to @Model.Range.To.ToString("d MMM yyyy")</span></div>
    <div class="card stat"><span class="stat-label"><span class="stat-icon" data-tone="violet">@Icons.Svg("log-in", 18)</span>Logins</span><span class="kpi">@Model.Weeks.Sum(w => w.Logins)</span></div>
    <div class="card stat"><span class="stat-label"><span class="stat-icon" data-tone="amber">@Icons.Svg("calendar", 18)</span>Appointments</span><span class="kpi">@Model.AppointmentsByStatus.Sum(a => a.Count)</span></div>
</div>

<section class="card flush">
    <div class="card-head pad"><h2 class="h3">Week by week</h2></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th scope="col">Week of</th><th scope="col" class="r">Active clients</th><th scope="col" class="r">Workouts</th><th scope="col" class="r">Meals</th><th scope="col" class="r">Measurements</th><th scope="col" class="r">Logs per client</th><th scope="col" class="r">Logins</th></tr></thead>
            <tbody class="num">
                @foreach (var week in Model.Weeks)
                {
                    <tr>
                        <th scope="row" class="nowrap">@week.WeekStart.ToString("d MMM yyyy")</th>
                        <td class="r">@week.ActiveClients</td>
                        <td class="r">@week.WorkoutLogs</td>
                        <td class="r">@week.MealLogs</td>
                        <td class="r">@week.Measurements</td>
                        <td class="r">@week.LogsPerClient.ToString("0.0")</td>
                        <td class="r">@week.Logins</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="grid g-3">
    <partial name="_ChartCard" model="chart" />
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">Appointments by status</h2></div>
        <div class="table-wrap">
            <table class="table compact">
                <tbody class="num">
                    @foreach (var status in Model.AppointmentsByStatus)
                    {
                        <tr><th scope="row">@status.Label</th><td class="r">@status.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">@(Model.AllClients ? "Registrations" : "Your clients' registrations") by month</h2></div>
        <div class="table-wrap">
            <table class="table compact">
                <tbody class="num">
                    @foreach (var month in Model.RegistrationsByMonth)
                    {
                        <tr><th scope="row">@month.Label</th><td class="r">@month.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (Model.AllClients)
{
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">Trainer workload</h2></div>
        @if (Model.TrainerWorkload.Count == 0)
        {
            <p class="small muted card-pad-bottom">No approved professionals yet.</p>
        }
        else
        {
            <partial name="_TrainerWorkloadTable" model="Model.TrainerWorkload" />
        }
    </section>
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
