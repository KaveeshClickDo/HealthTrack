@model ReportToolbarViewModel
@* The date range (a GET form back to the same report), Export CSV and Print; hidden when printing, which shows the period
   as text instead. *@
<form method="get" class="card report-toolbar no-print">
    <div class="field">
        <label for="from" class="label">From</label>
        <input type="date" id="from" name="from" value="@Model.Range.From.ToString("yyyy-MM-dd")" class="input" required />
    </div>
    <div class="field">
        <label for="to" class="label">To</label>
        <input type="date" id="to" name="to" value="@Model.Range.To.ToString("yyyy-MM-dd")" class="input" required />
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-primary">Show</button>
        <a class="btn btn-secondary" asp-action="ExportCsv" asp-route-report="@Model.ReportKey"
           asp-route-from="@Model.Range.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.Range.To.ToString("yyyy-MM-dd")">@Icons.Svg("download", 18)Export CSV</a>
        <button type="button" class="btn btn-ghost" data-print>@Icons.Svg("printer", 18)Print</button>
    </div>
</form>
<p class="print-only">Period: @Model.Range.Text</p>
