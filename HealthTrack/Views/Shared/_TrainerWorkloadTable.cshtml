@model IReadOnlyList<TrainerWorkloadRow>
@* The trainer workload table, in the trainer workload report and at the end of the administrator's engagement report. *@
<div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Professional</th>
                <th scope="col" class="text-end">Active clients</th>
                <th scope="col">Load</th>
                <th scope="col" class="text-end">Appointments</th>
                <th scope="col" class="text-end">Completed</th>
                <th scope="col" class="text-end">Plans created</th>
                <th scope="col" class="text-end">Feedback given</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <th scope="row" class="fw-normal">
                        @row.TrainerName
                        <div class="small text-muted">@row.ProfessionalType.GetDisplayName()</div>
                    </th>
                    <td class="text-end">@row.ActiveClients of @row.MaxClients</td>
                    <td class="report-load">
                        <div class="progress" role="progressbar" aria-label="@row.TrainerName's load" aria-valuenow="@row.LoadPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(row.ActiveClients >= row.MaxClients ? "bg-danger" : string.Empty)" data-progress-width="@row.LoadPercent">@row.LoadPercent%</div>
                        </div>
                    </td>
                    <td class="text-end">@row.Appointments</td>
                    <td class="text-end">@row.AppointmentsCompleted</td>
                    <td class="text-end">@row.PlansCreated</td>
                    <td class="text-end">@row.FeedbackGiven</td>
                </tr>
            }
        </tbody>
    </table>
</div>
