@model TrainerWorkloadReportViewModel
@* Trainer workload (UC27, administrators only). *@
@{
    ViewData["Title"] = "Trainer workload";
    var toolbar = new ReportToolbarViewModel { Range = Model.Range, ReportKey = HealthTrack.Services.ReportService.TrainerWorkload };
    var chart = new ChartCardViewModel
    {
        Title = "Active clients and capacity", Series = Model.Chart, LabelHeader = "Professional",
        EmptyText = "No approved professionals yet."
    };
}

<h1 class="h2 mb-1">Trainer workload</h1>
<p class="text-muted mb-3">
    Each approved professional's clients against their capacity, and the appointments, plans and feedback of @Model.Range.Text.
</p>

<partial name="_ReportToolbar" model="toolbar" />

@if (Model.Rows.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            No approved professionals yet. <a asp-controller="TrainerApprovals" asp-action="Index">Review applications</a>.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <partial name="_TrainerWorkloadTable" model="Model.Rows" />
    </div>
    <div class="row">
        <div class="col-lg-8">
            <partial name="_ChartCard" model="chart" />
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
