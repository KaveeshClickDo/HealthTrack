@model ClientPerformanceReportViewModel
@* Client performance (UC27), shared by the Trainer and Admin areas' ReportsController. *@
@{
    ViewData["Title"] = "Client performance";
    var toolbar = new ReportToolbarViewModel { Range = Model.Range, ReportKey = HealthTrack.Services.ReportService.ClientPerformance };
    var chart = new ChartCardViewModel
    {
        Title = "Workout adherence by client (%)", Series = Model.Chart, LabelHeader = "Client",
        EmptyText = "No client had workouts scheduled in this period."
    };

    string Kg(decimal? value) => value is { } kg ? kg.ToString("0.0") : "–";
    string Signed(decimal? value) => value is { } kg ? (kg > 0 ? "+" : string.Empty) + kg.ToString("0.0") : "–";
}

<h1 class="h2 mb-1">Client performance</h1>
<p class="text-muted mb-3">
    @(Model.AllClients ? "Every client" : "Your assigned clients"), @Model.Range.Text: weight and BMI at the start and now,
    workouts, adherence, eating against the diet target, calories burned and appointments attended.
</p>

<partial name="_ReportToolbar" model="toolbar" />

@if (Model.Rows.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            @(Model.AllClients ? "There are no clients yet." : "No clients are assigned to you yet, so there is nothing to report.")
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Client</th>
                        <th scope="col" class="text-end">Weight (kg)</th>
                        <th scope="col" class="text-end">Change</th>
                        <th scope="col" class="text-end">BMI</th>
                        <th scope="col" class="text-end">Workouts</th>
                        <th scope="col" class="text-end">Adherence</th>
                        <th scope="col" class="text-end">kcal a day / target</th>
                        <th scope="col" class="text-end">kcal burned</th>
                        <th scope="col" class="text-end">Appointments attended</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row" class="fw-normal">
                                @row.ClientName
                                @if (Model.AllClients)
                                {
                                    <div class="small text-muted">@(row.TrainerName ?? "Unassigned")</div>
                                }
                            </th>
                            <td class="text-end text-nowrap">@Kg(row.StartWeightKg) → @Kg(row.LatestWeightKg)</td>
                            <td class="text-end">@Signed(row.WeightChangeKg)</td>
                            <td class="text-end text-nowrap">@Kg(row.StartBmi) → @Kg(row.LatestBmi)</td>
                            <td class="text-end">@row.WorkoutsCompleted</td>
                            <td class="text-end">@(row.AdherencePercent is { } adherence ? adherence + "%" : "–")</td>
                            <td class="text-end text-nowrap">
                                @(row.AverageDailyCalories?.ToString("N0") ?? "–") / @(row.AverageDailyTarget?.ToString("N0") ?? "–")
                            </td>
                            <td class="text-end">@row.CaloriesBurned.ToString("N0")</td>
                            <td class="text-end">@row.AppointmentsAttended</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <partial name="_ChartCard" model="chart" />
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
