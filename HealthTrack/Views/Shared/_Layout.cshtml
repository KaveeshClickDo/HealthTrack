@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;

    // Highlights the sidebar link of the page being shown.
    string Active(string area, string controller, string? action = null) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "is-active" : string.Empty;

    var userName = User.Identity?.Name ?? string.Empty;
    var initials = userName.Length >= 2 ? userName[..2] : userName;
    var roleLabel = User.IsInRole(AppRoles.Admin) ? "Administrator" : User.IsInRole(AppRoles.Trainer) ? "Trainer" : "Client";
    var avatarClass = User.IsInRole(AppRoles.Admin) ? "avatar-admin" : User.IsInRole(AppRoles.Trainer) ? "avatar-trainer" : string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="preload" href="~/lib/fonts/archivo/archivo-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#main-content">Skip to content</a>

    @if (signedIn)
    {
        <div class="ht-app">
            <aside class="ht-side">
                <a class="ht-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="ht-logo">@Icons.Svg("logo")</span>
                    HealthTrack
                    @if (!User.IsInRole(AppRoles.Client))
                    {
                        <span class="ht-role">@(User.IsInRole(AppRoles.Admin) ? "Admin" : "Trainer")</span>
                    }
                </a>

                <nav class="ht-nav" aria-label="Main">
                    @if (User.IsInRole(AppRoles.Client))
                    {
                        <a class="@Active("Client", "Dashboard")" asp-area="Client" asp-controller="Dashboard" asp-action="Index">@Icons.Svg("dashboard")Dashboard</a>
                        <p class="ht-nav-label">Training</p>
                        <a class="@Active("Client", "Workouts", "Today")" asp-area="Client" asp-controller="Workouts" asp-action="Today">@Icons.Svg("play")Today's workout</a>
                        <a class="@Active("Client", "Workouts", "MyPlan")" asp-area="Client" asp-controller="Workouts" asp-action="MyPlan">@Icons.Svg("clipboard")Workout plan</a>
                        <a class="@Active("Client", "Workouts", "History")" asp-area="Client" asp-controller="Workouts" asp-action="History">@Icons.Svg("history")Workout history</a>
                        <p class="ht-nav-label">Nutrition</p>
                        <a class="@Active("Client", "Diet", "MyPlan")" asp-area="Client" asp-controller="Diet" asp-action="MyPlan">@Icons.Svg("apple")Diet plan</a>
                        <a class="@Active("Client", "Diet", "LogMeal")" asp-area="Client" asp-controller="Diet" asp-action="LogMeal">@Icons.Svg("utensils")Log a meal</a>
                        <a class="@Active("Client", "Diet", "History")" asp-area="Client" asp-controller="Diet" asp-action="History">@Icons.Svg("list")Meal history</a>
                        <p class="ht-nav-label">Health</p>
                        <a class="@Active("Client", "Progress")" asp-area="Client" asp-controller="Progress" asp-action="Index">@Icons.Svg("trending-up")Progress</a>
                        <a class="@Active("Client", "Measurements")" asp-area="Client" asp-controller="Measurements" asp-action="Index">@Icons.Svg("ruler")Measurements</a>
                        <a class="@Active("Client", "Profile")" asp-area="Client" asp-controller="Profile" asp-action="Edit">@Icons.Svg("shield")Health profile</a>
                        <p class="ht-nav-label">Coaching</p>
                        <a class="@Active("Client", "Appointments")" asp-area="Client" asp-controller="Appointments" asp-action="Index">@Icons.Svg("calendar")Appointments</a>
                        <a class="@Active("Client", "Feedback")" asp-area="Client" asp-controller="Feedback" asp-action="Index">@Icons.Svg("message")Feedback</a>
                    }
                    else if (User.IsInRole(AppRoles.Trainer))
                    {
                        <a class="@Active("Trainer", "Dashboard")" asp-area="Trainer" asp-controller="Dashboard" asp-action="Index">@Icons.Svg("dashboard")Dashboard</a>
                        <p class="ht-nav-label">Coaching</p>
                        <a class="@Active("Trainer", "Clients")" asp-area="Trainer" asp-controller="Clients" asp-action="Index">@Icons.Svg("users")Clients</a>
                        <a class="@Active("Trainer", "Appointments")" asp-area="Trainer" asp-controller="Appointments" asp-action="Index">@Icons.Svg("calendar")Appointments</a>
                        <a class="@Active("Trainer", "Availability")" asp-area="Trainer" asp-controller="Availability" asp-action="Index">@Icons.Svg("clock")Availability</a>
                        <p class="ht-nav-label">Planning</p>
                        <a class="@(currentAction == "Templates" ? string.Empty : Active("Trainer", "WorkoutPlans"))" asp-area="Trainer" asp-controller="WorkoutPlans" asp-action="Index">@Icons.Svg("clipboard")Workout plans</a>
                        <a class="@Active("Trainer", "WorkoutPlans", "Templates")" asp-area="Trainer" asp-controller="WorkoutPlans" asp-action="Templates">@Icons.Svg("copy")Templates</a>
                        <a class="@Active("Trainer", "DietPlans")" asp-area="Trainer" asp-controller="DietPlans" asp-action="Index">@Icons.Svg("apple")Diet plans</a>
                        <p class="ht-nav-label">Reports</p>
                        <a class="@Active("Trainer", "Reports", "ClientPerformance")" asp-area="Trainer" asp-controller="Reports" asp-action="ClientPerformance">@Icons.Svg("trending-up")Client performance</a>
                        <a class="@Active("Trainer", "Reports", "PopularRoutines")" asp-area="Trainer" asp-controller="Reports" asp-action="PopularRoutines">@Icons.Svg("flame")Popular routines</a>
                        <a class="@Active("Trainer", "Reports", "Engagement")" asp-area="Trainer" asp-controller="Reports" asp-action="Engagement">@Icons.Svg("activity")Engagement</a>
                    }
                    else if (User.IsInRole(AppRoles.Admin))
                    {
                        <a class="@Active("Admin", "Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Icons.Svg("dashboard")Dashboard</a>
                        <p class="ht-nav-label">People</p>
                        <a class="@Active("Admin", "Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">@Icons.Svg("users")Users</a>
                        <a class="@Active("Admin", "TrainerApprovals")" asp-area="Admin" asp-controller="TrainerApprovals" asp-action="Index">@Icons.Svg("user-check")Trainer approvals</a>
                        <a class="@Active("Admin", "Assignments")" asp-area="Admin" asp-controller="Assignments" asp-action="Index">@Icons.Svg("link")Assignments</a>
                        <p class="ht-nav-label">Library</p>
                        <a class="@Active("Admin", "Library", "Exercises")" asp-area="Admin" asp-controller="Library" asp-action="Exercises">@Icons.Svg("dumbbell")Exercises</a>
                        <a class="@Active("Admin", "Library", "Foods")" asp-area="Admin" asp-controller="Library" asp-action="Foods">@Icons.Svg("apple")Foods</a>
                        <p class="ht-nav-label">Insights</p>
                        <a class="@Active("Admin", "Reports", "ClientPerformance")" asp-area="Admin" asp-controller="Reports" asp-action="ClientPerformance">@Icons.Svg("trending-up")Client performance</a>
                        <a class="@Active("Admin", "Reports", "PopularRoutines")" asp-area="Admin" asp-controller="Reports" asp-action="PopularRoutines">@Icons.Svg("flame")Popular routines</a>
                        <a class="@Active("Admin", "Reports", "Engagement")" asp-area="Admin" asp-controller="Reports" asp-action="Engagement">@Icons.Svg("activity")Engagement</a>
                        <a class="@Active("Admin", "Reports", "TrainerWorkload")" asp-area="Admin" asp-controller="Reports" asp-action="TrainerWorkload">@Icons.Svg("gauge")Trainer workload</a>
                        <a class="@Active("Admin", "AuditLog")" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">@Icons.Svg("scroll")Audit log</a>
                    }
                    <p class="ht-nav-label">Account</p>
                    <a class="@Active("", "Notifications", "Preferences")" asp-area="" asp-controller="Notifications" asp-action="Preferences">@Icons.Svg("sliders")Notification settings</a>
                    <a class="@Active("", "Manage")" asp-area="" asp-controller="Manage" asp-action="Index">@Icons.Svg("user")Manage account</a>
                </nav>

                <a class="ht-me" asp-area="" asp-controller="Manage" asp-action="Index">
                    <span class="avatar @avatarClass" aria-hidden="true">@initials</span>
                    <span class="who"><b>@userName</b><span>@roleLabel</span></span>
                </a>
            </aside>

            <div class="ht-main">
                <header class="ht-top">
                    <div class="ht-crumbs">@ViewData["Title"]</div>
                    <div class="ht-top-actions">
                        <span class="small text-muted d-none d-sm-inline">@DateTime.Now.ToString("ddd d MMM")</span>
                        <a class="icon-btn @(Active("", "Notifications", "Index").Length > 0 ? "active" : string.Empty)" asp-area="" asp-controller="Notifications" asp-action="Index" aria-label="Notifications"
                           data-notification-bell
                           data-poll-url="@Url.Action("Poll", "Notifications", new { area = "" })"
                           data-mark-read-url="@Url.Action("MarkAsRead", "Notifications", new { area = "" })">
                            @Icons.Svg("bell")
                            <span id="notification-count" class="badge-dot d-none">0</span>
                        </a>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="icon-btn" aria-label="Log out" title="Log out">@Icons.Svg("log-out")</button>
                        </form>
                    </div>
                </header>

                <main id="main-content" class="ht-content">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>

                <footer class="ht-foot">
                    <span>&copy; @DateTime.Now.Year HealthTrack</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy notice</a>
                </footer>
            </div>
        </div>

        @* Toasts for new notifications (healthtrack.js); the token signs the toast's mark-as-read POST. *@
        <div id="notification-toasts" class="toast-container position-fixed bottom-0 end-0 p-3">
            @Html.AntiForgeryToken()
        </div>
    }
    else
    {
        <div class="d-flex flex-column min-vh-100">
            <header class="border-bottom">
                <nav class="container site-nav" aria-label="Main">
                    <a class="ht-brand px-0" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="ht-logo">@Icons.Svg("logo")</span>
                        HealthTrack
                    </a>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted d-none d-md-inline me-1">Already have an account?</span>
                        <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                    </div>
                </nav>
            </header>

            <main id="main-content" class="flex-grow-1 py-5">
                <div class="container">
                    <partial name="_Alerts" />
                    @RenderBody()
                </div>
            </main>

            <footer class="site-foot">
                <div class="container d-flex flex-wrap justify-content-between gap-2">
                    <span>&copy; @DateTime.Now.Year HealthTrack</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy notice</a>
                </div>
            </footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/healthtrack.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
