@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? string.Empty;

    // Highlights the top-level link of the page being shown.
    string Active(string area, string controller, string? action = null) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#main-content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">&#9829;</span> HealthTrack
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                        aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole(AppRoles.Client))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Client", "Dashboard")" asp-area="Client" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">My plans</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Workouts" asp-action="MyPlan">Workout plan</a></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Diet" asp-action="MyPlan">Diet plan</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Log</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Workouts" asp-action="Today">Today's workout</a></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Diet" asp-action="LogMeal">Log a meal</a></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Measurements" asp-action="Create">Add a measurement</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Workouts" asp-action="History">Workout history</a></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Diet" asp-action="History">Meal history</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Client", "Progress") @Active("Client", "Measurements")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Progress</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Progress" asp-action="Index">Charts</a></li>
                                    <li><a class="dropdown-item" asp-area="Client" asp-controller="Measurements" asp-action="Index">Measurements</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Client", "Appointments")" asp-area="Client" asp-controller="Appointments" asp-action="Index">Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Client", "Feedback")" asp-area="Client" asp-controller="Feedback" asp-action="Index">Feedback</a>
                            </li>
                        }
                        else if (User.IsInRole(AppRoles.Trainer))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "Dashboard")" asp-area="Trainer" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "Clients")" asp-area="Trainer" asp-controller="Clients" asp-action="Index">Clients</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Templates" ? string.Empty : Active("Trainer", "WorkoutPlans"))" asp-area="Trainer" asp-controller="WorkoutPlans" asp-action="Index">Workout plans</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "WorkoutPlans", "Templates")" asp-area="Trainer" asp-controller="WorkoutPlans" asp-action="Templates">Templates</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "DietPlans")" asp-area="Trainer" asp-controller="DietPlans" asp-action="Index">Diet plans</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "Appointments")" asp-area="Trainer" asp-controller="Appointments" asp-action="Index">Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Trainer", "Availability")" asp-area="Trainer" asp-controller="Availability" asp-action="Index">Availability</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Trainer", "Reports")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Trainer" asp-controller="Reports" asp-action="ClientPerformance">Client performance</a></li>
                                    <li><a class="dropdown-item" asp-area="Trainer" asp-controller="Reports" asp-action="PopularRoutines">Popular routines</a></li>
                                    <li><a class="dropdown-item" asp-area="Trainer" asp-controller="Reports" asp-action="Engagement">Engagement</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin", "Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin", "Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin", "TrainerApprovals")" asp-area="Admin" asp-controller="TrainerApprovals" asp-action="Index">Trainer approvals</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin", "Assignments")" asp-area="Admin" asp-controller="Assignments" asp-action="Index">Assignments</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Admin", "Library")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Library</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Library" asp-action="Exercises">Exercises</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Library" asp-action="Foods">Foods</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Admin", "Reports")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="ClientPerformance">Client performance</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="PopularRoutines">Popular routines</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="Engagement">Engagement</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="TrainerWorkload">Trainer workload</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin", "AuditLog")" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">Audit log</a>
                            </li>
                        }
                    </ul>

                    @if (signedIn)
                    {
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link position-relative px-lg-3 @Active("", "Notifications", "Index")" asp-area="" asp-controller="Notifications" asp-action="Index" aria-label="Notifications"
                                   data-notification-bell
                                   data-poll-url="@Url.Action("Poll", "Notifications", new { area = "" })"
                                   data-mark-read-url="@Url.Action("MarkAsRead", "Notifications", new { area = "" })">
                                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                    </svg>
                                    <span class="d-lg-none ms-1">Notifications</span>
                                    <span id="notification-count" class="badge rounded-pill bg-danger notification-badge d-none">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Manage" asp-action="Index">Manage account</a></li>
                                    @if (User.IsInRole(AppRoles.Client))
                                    {
                                        <li><a class="dropdown-item" asp-area="Client" asp-controller="Profile" asp-action="Edit">Health profile</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Notifications" asp-action="Preferences">Notification settings</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="flex-grow-1 py-4">
        <div class="container">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-white py-3">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small text-muted">
            <span>&copy; @DateTime.Now.Year HealthTrack</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy notice</a>
        </div>
    </footer>

    @if (signedIn)
    {
        @* Toasts for new notifications (healthtrack.js); the token signs the toast's mark-as-read POST. *@
        <div id="notification-toasts" class="toast-container position-fixed bottom-0 end-0 p-3">
            @Html.AntiForgeryToken()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/healthtrack.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
