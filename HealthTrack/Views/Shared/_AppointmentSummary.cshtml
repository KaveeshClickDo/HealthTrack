@model AppointmentListItemViewModel
@{
    // A meeting link is shown as a link only when it really is a web address, so a typed "javascript:" can't run.
    var isLink = Uri.TryCreate(Model.Location, UriKind.Absolute, out var url)
        && (url.Scheme == Uri.UriSchemeHttps || url.Scheme == Uri.UriSchemeHttp);
    var showClient = ViewData["ShowClient"] as bool? == true;
}
@* One appointment's facts, shared by the client's and the professional's pages. *@
<dl class="kv">
    <dt>When</dt>
    <dd>@Model.StartDateTime.ToString("dddd d MMM yyyy") · @Model.StartDateTime.ToString("HH:mm") – @Model.EndDateTime.ToString("HH:mm") <span class="subtle">(@Model.DurationMinutes minutes)</span></dd>
    <dt>Status</dt>
    <dd><span class="badge @StatusBadges.For(Model.Status)">@Model.Status.GetDisplayName()</span></dd>
    <dt>Type</dt>
    <dd>@Model.AppointmentType.GetDisplayName() · @Model.Mode.GetDisplayName()</dd>
    @if (showClient)
    {
        <dt>Client</dt>
        <dd><span class="hrow"><span class="avatar av-sm av-client">@Model.ClientName.Initials()</span>@Model.ClientName</span></dd>
    }
    else
    {
        <dt>Professional</dt>
        <dd><span class="hrow"><span class="avatar av-sm av-trainer">@Model.TrainerName.Initials()</span>@Model.TrainerName <span class="subtle">· @Model.ProfessionalType.GetDisplayName()</span></span></dd>
    }
    <dt>Where</dt>
    <dd>
        @if (Model.Location is null)
        {
            <span class="subtle">@(Model.Status == AppointmentStatus.Pending ? "Given when approved" : "Not given")</span>
        }
        else if (isLink)
        {
            <a class="link-inline" href="@url" rel="noopener noreferrer" target="_blank">@Model.Location@Icons.Svg("external-link", 14)</a>
        }
        else
        {
            @Model.Location
        }
    </dd>
    <dt>Reason for booking</dt>
    <dd class="text-prewrap">@(Model.ClientReason ?? "None given")</dd>
    @if (Model.CancellationReason is not null)
    {
        <dt>@(Model.Status == AppointmentStatus.Rejected ? "Why it was declined" : "Why it was cancelled")</dt>
        <dd class="text-prewrap">@Model.CancellationReason</dd>
    }
</dl>
