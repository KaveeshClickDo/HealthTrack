@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var isBadRequest = statusCode == 400;
    ViewData["Title"] = isBadRequest ? "Request not accepted" : "Something went wrong";
}

@* Never shows exception details; the reference lets an administrator find the request in the server log. *@
<div class="error-page text-center mx-auto">
    <p class="error-code mb-3">@statusCode</p>
    @if (isBadRequest)
    {
        <h1 class="h3">We couldn't accept that request</h1>
        <p class="text-muted">The form may have expired. Go back, reload the page and try again.</p>
    }
    else
    {
        <h1 class="h3">Something went wrong</h1>
        <p class="text-muted">Sorry, we couldn't complete your request. Please try again in a moment.</p>
    }
    <p class="small text-muted">Reference: <code>@Context.TraceIdentifier</code></p>
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Go to the home page</a>
</div>
