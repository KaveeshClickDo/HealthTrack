@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var isBadRequest = statusCode == 400;
    ViewData["Title"] = isBadRequest ? "Request not accepted" : "Something went wrong";
    ViewData["PublicShell"] = "plain";
}

@* Never shows exception details; the reference lets an administrator find the request in the server log. *@
<div class="container error-wrap">
    <div class="error-box">
        <span class="stat-icon i-red">@Icons.Svg("alert-triangle", 26)</span>
        <p class="display error-code" aria-hidden="true">@statusCode</p>
        @if (isBadRequest)
        {
            <h1 class="h1">We couldn't accept that request</h1>
            <p class="lead">The form may have expired. Go back, reload the page and try again.</p>
        }
        else
        {
            <h1 class="h1">Something went wrong on our side</h1>
            <p class="lead">Sorry — we couldn't complete your request. Please try again in a moment.</p>
        }
        <div class="hrow wrap error-ref">
            <span class="xs subtle">Reference</span>
            <code class="mono small">@Context.TraceIdentifier</code>
        </div>
        <p class="xs subtle">If this keeps happening, share the reference with your administrator.</p>
        <div class="actions">
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Home" asp-action="Index">Go to the home page</a>
        </div>
    </div>
</div>
