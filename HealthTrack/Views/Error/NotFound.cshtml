@{
    ViewData["Title"] = "Page not found";
}

<div class="error-page text-center mx-auto">
    <p class="error-code mb-3">404</p>
    <h1 class="h3">We couldn't find that page</h1>
    <p class="text-muted">The link may be out of date, or the page may not be available to your account.</p>
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Go to the home page</a>
</div>
