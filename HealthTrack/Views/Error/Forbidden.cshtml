@{
    ViewData["Title"] = "Access denied";
}

<div class="error-page text-center mx-auto">
    <p class="display-4 fw-semibold text-primary mb-2">403</p>
    <h1 class="h3">This page isn't available to your account</h1>
    <p class="text-muted">It belongs to another kind of account. Your own pages are on your dashboard.</p>
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Go to my dashboard</a>
</div>
