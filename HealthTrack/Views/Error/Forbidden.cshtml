@{
    ViewData["Title"] = "Access denied";
    ViewData["PublicShell"] = "plain";
}

<div class="container error-wrap">
    <div class="error-box">
        <span class="stat-icon i-amber">@Icons.Svg("lock", 26)</span>
        <p class="display error-code" aria-hidden="true">403</p>
        <h1 class="h1">This page isn't available to your account</h1>
        <p class="lead">It belongs to a different kind of account. Everything you can use is on your dashboard.</p>
        <div class="actions">
            @* Home sends a signed-in user to their own dashboard. *@
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Home" asp-action="Index">Go to my dashboard</a>
        </div>
    </div>
</div>
