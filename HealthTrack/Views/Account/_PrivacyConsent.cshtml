@model RegisterViewModel
@* BR-02: the privacy notice must be accepted to register. *@
<div class="field">
    <label class="check" for="AcceptPrivacy">
        <input asp-for="AcceptPrivacy" />
        <span>I have read and accept the <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">privacy notice</a> (opens in a new tab).</span>
    </label>
    <span asp-validation-for="AcceptPrivacy" class="error-text"></span>
</div>
