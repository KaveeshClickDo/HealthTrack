@model LoginViewModel
@inject HealthTrack.Helpers.IClock Clock
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<div class="auth">
    <main id="main-content" class="auth-main">
        <a class="ht-brand" asp-controller="Home" asp-action="Index">
            <span class="ht-logo">@Icons.Svg("logo")</span>
            HealthTrack
        </a>

        <div class="auth-center">
            <div class="auth-form">
                <div class="auth-intro">
                    <h1 class="display auth-title">Welcome back</h1>
                    <p class="lead">Log in to pick up where you left off.</p>
                </div>

                <partial name="_Alerts" />

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="All" role="alert"></div>
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div class="field">
                        <label asp-for="Email" class="label"></label>
                        <div class="input-wrap">
                            <span class="lead-icon">@Icons.Svg("mail", 18)</span>
                            <input asp-for="Email" class="input" autocomplete="username" placeholder="you@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Password" class="label"></label>
                        <div class="input-wrap">
                            <span class="lead-icon">@Icons.Svg("lock", 18)</span>
                            <input asp-for="Password" class="input" autocomplete="current-password" placeholder="Your password" />
                        </div>
                        <span asp-validation-for="Password" class="error-text"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
                </form>

                <div class="divider"></div>
                <div class="auth-links">
                    <p class="muted">New to HealthTrack? <a class="link-strong" asp-action="Register">Create an account</a></p>
                    <p class="small subtle">Coaching clients? <a asp-action="RegisterTrainer">Apply as a professional</a></p>
                </div>
            </div>
        </div>

        <div class="between wrap xs subtle auth-foot">
            <span>&copy; @Clock.Now.Year HealthTrack</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy notice</a>
        </div>
    </main>

    <aside class="frame auth-photo" aria-hidden="true">
        <img class="photo" src="@ExercisePhotos.Hero("treadmill")" alt="" />
        <div class="veil"></div>
        <div class="overlay">
            <div class="card auth-chip">
                <span class="stat-icon">@Icons.Svg("play", 18)</span>
                <div><div class="small strong">Today · Beginner full body</div><div class="xs subtle">Stationary cycling · Seated cable row</div></div>
            </div>
            <p class="display auth-photo-title">Your plan is ready when you are.</p>
            <p class="muted auth-photo-text">Today's workout, your meals and messages from your coach — waiting where you left them.</p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
