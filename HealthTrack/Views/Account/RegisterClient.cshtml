@model RegisterClientViewModel
@{
    ViewData["Title"] = "Register as a client";
    ViewData["PublicShell"] = "register";
}

<div class="container page-pad">
    <div class="split reg-split">
        <aside class="aside reg-aside">
            <a class="back" asp-action="Register">@Icons.Svg("arrow-left", 16)Choose a different account</a>
            <div class="vs gp-12">
                <h1 class="display reg-title">Create your client account</h1>
                <p class="muted">Your account is ready straight away. An administrator then matches you with a trainer who builds your plan.</p>
            </div>
            <ol class="reg-steps">
                <li><a href="#about" class="hrow is-current"><span class="avatar av-sm">1</span><span class="strong">About you</span></a></li>
                <li><a href="#health" class="hrow"><span class="avatar av-sm">2</span>Your health profile</a></li>
                <li><a href="#medical" class="hrow"><span class="avatar av-sm">3</span>Medical details <span class="subtle small">· optional</span></a></li>
                <li><a href="#emergency" class="hrow"><span class="avatar av-sm">4</span>Emergency contact <span class="subtle small">· optional</span></a></li>
            </ol>
            <div class="alert on-surface">
                <span class="accent">@Icons.Svg("lock", 18)</span>
                <span class="small muted">Medical details are encrypted before they're stored. You can download or delete your data at any time.</span>
            </div>
            <p class="small subtle">Coaching clients yourself? <a asp-action="RegisterTrainer">Register as a professional</a></p>
        </aside>

        <form class="main gp-20" asp-action="RegisterClient" method="post" novalidate>
            <div asp-validation-summary="All" role="alert"></div>

            <section id="about" class="card form-card">
                <div class="vs gp-4"><span class="eyebrow">Step 1</span><h2 class="h2">About you</h2></div>
                <partial name="_AccountFields" model="Model" />
            </section>

            <section id="health" class="card form-card">
                <div class="vs gp-4">
                    <span class="eyebrow">Step 2</span>
                    <h2 class="h2">Your health profile</h2>
                    <p class="small subtle">Your height and weight become your first measurement and set your suggested calorie target.</p>
                </div>
                <fieldset class="field">
                    <legend class="label legend-gap">What's your main goal?</legend>
                    <div class="pill-grid">
                        @foreach (var goal in Enum.GetValues<FitnessGoal>())
                        {
                            <span class="pill">
                                <input type="radio" asp-for="FitnessGoal" value="@goal" id="goal-@goal" />
                                <label for="goal-@goal">@goal.GetDisplayName()</label>
                            </span>
                        }
                    </div>
                    <span asp-validation-for="FitnessGoal" class="error-text"></span>
                </fieldset>
                <div class="form-grid">
                    <div class="field full">
                        <label asp-for="ActivityLevel" class="label">How active are you day to day?</label>
                        <select asp-for="ActivityLevel" asp-items="Html.GetEnumSelectList<ActivityLevel>()" class="select">
                            <option value="">Choose…</option>
                        </select>
                        <span asp-validation-for="ActivityLevel" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="HeightCm" class="label">Height</label>
                        <div class="input-wrap">
                            <input asp-for="HeightCm" type="number" step="0.1" min="50" max="250" class="input" />
                            <span class="unit">cm</span>
                        </div>
                        <span asp-validation-for="HeightCm" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="WeightKg" class="label">Weight</label>
                        <div class="input-wrap">
                            <input asp-for="WeightKg" type="number" step="0.1" min="20" max="350" class="input" />
                            <span class="unit">kg</span>
                        </div>
                        <span asp-validation-for="WeightKg" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="TargetWeightKg" class="label">Target weight <span class="opt">Optional</span></label>
                        <div class="input-wrap">
                            <input asp-for="TargetWeightKg" type="number" step="0.1" min="30" max="300" class="input" />
                            <span class="unit">kg</span>
                        </div>
                        <span asp-validation-for="TargetWeightKg" class="error-text"></span>
                    </div>
                </div>
            </section>

            <section id="medical" class="card form-card">
                <div class="vs gp-4">
                    <span class="eyebrow">Step 3 · Optional</span>
                    <div class="hrow wrap"><h2 class="h2">Medical details</h2><span class="badge b-accent">@Icons.Svg("lock", 14)Encrypted</span></div>
                    <p class="small subtle">Your trainer sees these so your plan stays safe for you. You can turn sharing off in your health profile at any time.</p>
                </div>
                <div class="form-grid">
                    <div class="field full">
                        <label asp-for="MedicalConditions" class="label"></label>
                        <textarea asp-for="MedicalConditions" class="textarea" placeholder="For example, asthma or a past knee injury"></textarea>
                        <span asp-validation-for="MedicalConditions" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Allergies" class="label"></label>
                        <textarea asp-for="Allergies" class="textarea"></textarea>
                        <span asp-validation-for="Allergies" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CurrentMedications" class="label"></label>
                        <textarea asp-for="CurrentMedications" class="textarea" placeholder="Name and dose"></textarea>
                        <span asp-validation-for="CurrentMedications" class="error-text"></span>
                    </div>
                </div>
            </section>

            <section id="emergency" class="card form-card">
                <div class="vs gp-4"><span class="eyebrow">Step 4 · Optional</span><h2 class="h2">Emergency contact</h2></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="EmergencyContactName" class="label">Name</label>
                        <input asp-for="EmergencyContactName" class="input" />
                        <span asp-validation-for="EmergencyContactName" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="EmergencyContactPhone" class="label">Phone number</label>
                        <input asp-for="EmergencyContactPhone" type="tel" class="input" />
                        <span asp-validation-for="EmergencyContactPhone" class="error-text"></span>
                    </div>
                </div>
            </section>

            <div class="card vs gp-20">
                <partial name="_PrivacyConsent" model="Model" />
                <div class="between wrap">
                    <span class="small subtle">You can change all of this later.</span>
                    <button type="submit" class="btn btn-primary btn-lg">Create my account @Icons.Svg("arrow-right", 18)</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
