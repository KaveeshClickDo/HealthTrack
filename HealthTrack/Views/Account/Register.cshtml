@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h2 mb-2">Create your HealthTrack account</h1>
        <p class="text-muted mb-4">Choose the kind of account you need. Already registered? <a asp-action="Login">Log in</a>.</p>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm choice-card">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h4">I'm a client</h2>
                        <p class="text-muted flex-grow-1">
                            Track your workouts, meals and measurements, follow plans from your trainer and book appointments.
                            Your account is ready straight away.
                        </p>
                        <a class="btn btn-primary stretched-link" asp-action="RegisterClient">Register as a client</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 shadow-sm choice-card">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h4">I'm a trainer or health professional</h2>
                        <p class="text-muted flex-grow-1">
                            Fitness trainers, nutritionists, physiotherapists and medical doctors coach clients and take appointments.
                            An administrator checks your details before your first login.
                        </p>
                        <a class="btn btn-outline-primary stretched-link" asp-action="RegisterTrainer">Register as a professional</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
