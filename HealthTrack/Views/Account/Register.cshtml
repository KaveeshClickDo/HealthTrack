@{
    ViewData["Title"] = "Create an account";
    ViewData["PublicShell"] = "register";
}

<div class="container choose">
    <div class="choose-head">
        <span class="eyebrow">Get started</span>
        <h1 class="display choose-title">Create your HealthTrack account</h1>
        <p class="lead">Choose the account that fits you. It only takes a couple of minutes.</p>
    </div>

    <div class="choose-grid">
        <article class="card flush choose-card">
            <div class="frame choose-photo">
                <img class="photo" src="@ExercisePhotos.For("Push-up")" alt="Man doing a push-up on a gym floor" />
                <div class="shade"></div>
                <span class="badge b-green"><span class="dot"></span>Ready straight away</span>
            </div>
            <div class="choose-body">
                <h2 class="h2">I want to get fitter</h2>
                <p class="muted">Track your workouts, meals and measurements, follow plans from your trainer and book sessions when you need them.</p>
                <ul class="checklist">
                    <li class="hrow small">@Icons.Svg("check", 18)Workout and diet plans from a professional</li>
                    <li class="hrow small">@Icons.Svg("check", 18)Charts of your weight, BMI and vitals</li>
                    <li class="hrow small">@Icons.Svg("check", 18)Reminders for workouts, meals and sessions</li>
                </ul>
                <a class="btn btn-primary btn-lg btn-block mt-auto-btn" asp-action="RegisterClient">Register as a client</a>
            </div>
        </article>

        <article class="card flush choose-card">
            <div class="frame choose-photo">
                <img class="photo" src="@ExercisePhotos.Hero("kettlebell")" alt="Man getting ready to swing a kettlebell in a gym" />
                <div class="shade"></div>
                <span class="badge b-amber"><span class="dot"></span>Checked by our team first</span>
            </div>
            <div class="choose-body">
                <h2 class="h2">I'm a trainer or health professional</h2>
                <p class="muted">Fitness trainers, nutritionists, physiotherapists and medical doctors coach clients and take appointments here.</p>
                <ul class="checklist">
                    <li class="hrow small">@Icons.Svg("check", 18)Plans, templates and feedback for your clients</li>
                    <li class="hrow small">@Icons.Svg("check", 18)Bookings only inside your availability</li>
                    <li class="hrow small">@Icons.Svg("check", 18)An administrator approves you before your first login</li>
                </ul>
                <a class="btn btn-secondary btn-lg btn-block mt-auto-btn" asp-action="RegisterTrainer">Register as a professional</a>
            </div>
        </article>
    </div>
</div>
