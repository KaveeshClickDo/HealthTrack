@model RegisterViewModel
@* The fields both registration forms share (spec 1.3), as the first form card. *@
<div class="form-grid">
    <div class="field">
        <label asp-for="FirstName" class="label"></label>
        <input asp-for="FirstName" class="input" autocomplete="given-name" />
        <span asp-validation-for="FirstName" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="LastName" class="label"></label>
        <input asp-for="LastName" class="input" autocomplete="family-name" />
        <span asp-validation-for="LastName" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="Email" class="label"></label>
        <input asp-for="Email" class="input" autocomplete="email" />
        <span class="hint">You'll use this to log in.</span>
        <span asp-validation-for="Email" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="PhoneNumber" class="label">Phone number <span class="opt">Optional</span></label>
        <input asp-for="PhoneNumber" type="tel" class="input" autocomplete="tel" placeholder="+94 77 123 4567" />
        <span asp-validation-for="PhoneNumber" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="Password" class="label"></label>
        <input asp-for="Password" class="input" autocomplete="new-password" />
        <span class="hint">At least 8 characters, with upper and lower case letters, a number and a symbol.</span>
        <span asp-validation-for="Password" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword" class="label"></label>
        <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" placeholder="Type it again" />
        <span asp-validation-for="ConfirmPassword" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="DateOfBirth" class="label"></label>
        <input asp-for="DateOfBirth" class="input" autocomplete="bday" />
        <span class="hint">You must be 16 or older.</span>
        <span asp-validation-for="DateOfBirth" class="error-text"></span>
    </div>
    <div class="field">
        <label asp-for="Gender" class="label"></label>
        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="select">
            <option value="">Choose…</option>
        </select>
        <span asp-validation-for="Gender" class="error-text"></span>
    </div>
</div>
