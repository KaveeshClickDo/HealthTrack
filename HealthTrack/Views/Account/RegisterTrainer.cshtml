@model RegisterTrainerViewModel
@{
    ViewData["Title"] = "Register as a professional";
    ViewData["PublicShell"] = "register";
}

<div class="container page-pad">
    <div class="split reg-split">
        <aside class="aside reg-aside">
            <a class="back" asp-action="Register">@Icons.Svg("arrow-left", 16)Choose a different account</a>
            <div class="vs gp-12">
                <h1 class="display reg-title">Apply to coach on HealthTrack</h1>
                <p class="muted">For fitness trainers, nutritionists, physiotherapists and medical doctors.</p>
            </div>
            <div class="card vs gp-18">
                <span class="h3">What happens next</span>
                <ol class="vs gp-16 next-steps">
                    <li class="hrow items-start"><span class="avatar av-sm">1</span><div><div class="small strong">Send your application</div><div class="xs subtle">It takes about three minutes.</div></div></li>
                    <li class="hrow items-start"><span class="avatar av-sm">2</span><div><div class="small strong">We check your details</div><div class="xs subtle">An administrator reviews your qualifications and licence.</div></div></li>
                    <li class="hrow items-start"><span class="avatar av-sm">3</span><div><div class="small strong">Start coaching</div><div class="xs subtle">Once approved, you can log in and clients are assigned to you.</div></div></li>
                </ol>
            </div>
            <p class="small subtle">Looking to track your own health? <a asp-action="RegisterClient">Register as a client</a></p>
        </aside>

        <form class="main gp-20" asp-action="RegisterTrainer" method="post" novalidate>
            <div asp-validation-summary="All" role="alert"></div>

            <section id="about" class="card form-card">
                <div class="vs gp-4"><span class="eyebrow">Step 1</span><h2 class="h2">About you</h2></div>
                <partial name="_AccountFields" model="Model" />
            </section>

            <section id="professional" class="card form-card">
                <div class="vs gp-4">
                    <span class="eyebrow">Step 2</span>
                    <h2 class="h2">Your practice</h2>
                    <p class="small subtle">Clients see your profession, specialisation and bio when they book a session with you.</p>
                </div>
                <fieldset class="field" data-profession data-fitness-trainer="@ProfessionalType.FitnessTrainer">
                    <legend class="label legend-gap">Profession</legend>
                    <div class="choice-grid">
                        @foreach (var type in Enum.GetValues<ProfessionalType>())
                        {
                            <label class="choice" for="type-@type">
                                <input type="radio" asp-for="ProfessionalType" value="@type" id="type-@type" />
                                <span class="choice-text">
                                    <span class="strong">@type.GetDisplayName()</span>
                                    <span class="xs subtle">@(type == ProfessionalType.FitnessTrainer ? "Licence optional" : "Licence required")</span>
                                </span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="ProfessionalType" class="error-text"></span>
                </fieldset>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Specialization" class="label"></label>
                        <input asp-for="Specialization" class="input" placeholder="For example, strength and conditioning" />
                        <span asp-validation-for="Specialization" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="YearsOfExperience" class="label"></label>
                        <input asp-for="YearsOfExperience" type="number" min="0" max="60" class="input" />
                        <span asp-validation-for="YearsOfExperience" class="error-text"></span>
                    </div>
                    <div class="field full">
                        <label asp-for="Qualifications" class="label"></label>
                        <textarea asp-for="Qualifications" class="textarea"></textarea>
                        <span class="hint">Certificates and degrees, separated by semicolons.</span>
                        <span asp-validation-for="Qualifications" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="LicenseNumber" class="label">Licence number <span id="licence-required" class="badge b-amber in-label d-none">Required for your profession</span></label>
                        <input asp-for="LicenseNumber" class="input" data-required-message="@RegisterTrainerViewModel.LicenseRequiredMessage" />
                        <span class="hint">Needed for nutritionists, physiotherapists and medical doctors.</span>
                        <span asp-validation-for="LicenseNumber" class="error-text"></span>
                    </div>
                    <div class="field full">
                        <label asp-for="Bio" class="label">Short bio <span class="opt">Optional</span></label>
                        <textarea asp-for="Bio" class="textarea"></textarea>
                        <span class="hint">Two or three sentences about how you work with clients.</span>
                        <span asp-validation-for="Bio" class="error-text"></span>
                    </div>
                </div>
            </section>

            <div class="card vs gp-20">
                <partial name="_PrivacyConsent" model="Model" />
                <div class="between wrap">
                    <span class="small subtle">We'll let you know as soon as your account is approved.</span>
                    <button type="submit" class="btn btn-primary btn-lg">Send my application</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register-trainer.js" asp-append-version="true"></script>
}
