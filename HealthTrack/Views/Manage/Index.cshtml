@model AccountSummaryViewModel
@{
    ViewData["Title"] = "Manage account";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h2 mb-4">@ViewData["Title"]</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 class="h5 mb-1">@Model.FullName</h2>
                        <span class="badge text-bg-light border">@Model.Role</span>
                        <span class="badge @(Model.AccountStatus == AccountStatus.Active ? "text-bg-success" : "text-bg-warning")">@Model.AccountStatus.GetDisplayName()</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary" asp-action="EditProfile">Edit details</a>
                        <a class="btn btn-outline-primary" asp-action="ChangePassword">Change password</a>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone number</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "Not given")</dd>

                    <dt class="col-sm-4">Date of birth</dt>
                    <dd class="col-sm-8">@Model.DateOfBirth.ToString("dd MMM yyyy") (age @Model.Age)</dd>

                    <dt class="col-sm-4">Gender</dt>
                    <dd class="col-sm-8">@Model.Gender.GetDisplayName()</dd>

                    <dt class="col-sm-4">Member since</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Last login</dt>
                    <dd class="col-sm-8">@(Model.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "This is your first visit")</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6">Reminders and notifications</h2>
                <p class="text-muted small mb-2">Choose which reminders you get and whether copies are sent by email.</p>
                <a asp-area="" asp-controller="Notifications" asp-action="Preferences">Notification settings</a>
            </div>
        </div>
    </div>
</div>
