@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Parent"] = "Your account";
    ViewData["ParentUrl"] = Url.Action("Index");
    ViewData["ContentClass"] = "narrow-pw";
}

<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16)Back to your account</a>
<div class="page-head">
    <div class="intro">
        <h1 class="h1">Change your password</h1>
        <p>Choose a strong password you don't use anywhere else.</p>
    </div>
</div>

<div class="split">
    <form class="main card gp-20" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <div class="field">
            <label asp-for="CurrentPassword" class="label"></label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="error-text"></span>
        </div>
        <div class="divider"></div>
        <div class="field">
            <label asp-for="NewPassword" class="label"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" data-password-input />
            <span asp-validation-for="NewPassword" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmNewPassword" class="label"></label>
            <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" placeholder="Type the new password again" />
            <span asp-validation-for="ConfirmNewPassword" class="error-text"></span>
        </div>
        <div class="actions end">
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary">Update password</button>
        </div>
    </form>

    @* wwwroot/js/password-rules.js ticks each rule as it is met; the server checks them again. *@
    <aside class="aside card gp-16">
        <span class="h3">Your new password needs</span>
        <ul class="rules" data-password-rules>
            <li class="hrow small" data-rule="length"><span class="ico-on">@Icons.Svg("check-circle", 18)</span><span class="ico-off">@Icons.Svg("circle", 18)</span>At least 8 characters</li>
            <li class="hrow small" data-rule="case"><span class="ico-on">@Icons.Svg("check-circle", 18)</span><span class="ico-off">@Icons.Svg("circle", 18)</span>An upper case and a lower case letter</li>
            <li class="hrow small" data-rule="digit"><span class="ico-on">@Icons.Svg("check-circle", 18)</span><span class="ico-off">@Icons.Svg("circle", 18)</span>A number</li>
            <li class="hrow small" data-rule="symbol"><span class="ico-on">@Icons.Svg("check-circle", 18)</span><span class="ico-off">@Icons.Svg("circle", 18)</span>A symbol, such as ! or #</li>
        </ul>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-rules.js" asp-append-version="true"></script>
}
