@model PagedResult<NotificationItemViewModel>
@{
    ViewData["Title"] = "Notifications";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Notifications</h1>
        <p class="text-muted mb-0">Plan, appointment, feedback and account updates and your reminders, newest first.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Items.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn btn-outline-primary">Mark all as read</button>
            </form>
        }
        <a class="btn btn-outline-secondary" asp-action="Preferences">Notification settings</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            You have no notifications yet. They appear here when a plan is assigned, an appointment changes or a reminder is due.
            <a asp-action="Preferences">Choose your reminders</a>.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item py-3 @(item.IsRead ? string.Empty : "notification-unread")">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                @if (!item.IsRead)
                                {
                                    <span class="badge bg-primary">New</span>
                                }
                                <span class="badge text-bg-light border">@item.Type.GetDisplayName()</span>
                                <span class="small text-muted">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                            <h2 class="h6 mb-1 @(item.IsRead ? string.Empty : "fw-bold")">@item.Title</h2>
                            <p class="mb-0">@item.Message</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            @if (item.LinkUrl is { } link)
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@link">Open</a>
                            }
                            @if (!item.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@item.NotificationId" asp-route-page="@Model.Page" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as read</button>
                                </form>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
    <partial name="_Pager" model="pager" />
}
