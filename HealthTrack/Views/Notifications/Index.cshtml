@model PagedResult<NotificationItemViewModel>
@inject IClock Clock
@{
    ViewData["Title"] = "Notifications";
    ViewData["ContentClass"] = "narrow-n";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
    var today = Clock.Now;
    var unread = Model.Items.Count(n => !n.IsRead);
}

<div class="page-head">
    <div class="intro">
        <div class="hrow gap-10"><h1 class="h1">Notifications</h1>@if (unread > 0) {<span class="badge b-rose">@unread unread</span>}</div>
        <p>Updates on your plans, appointments and feedback, plus your reminders — newest first.</p>
    </div>
    <div class="actions">
        @if (unread > 0)
        {
            <form class="inline" asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn btn-secondary">@Icons.Svg("check", 18)Mark all as read</button>
            </form>
        }
        <a class="btn btn-ghost" asp-action="Preferences">@Icons.Svg("sliders", 18)Settings</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("bell", 24)</span>
        <p><span class="strong">You have no notifications yet.</span> They appear here when a plan is assigned, an appointment changes or a reminder is due.</p>
        <a class="btn btn-secondary" asp-action="Preferences">Choose your reminders</a>
    </div>
}
else
{
    <section class="card flush">
        @foreach (var day in Model.Items.GroupBy(n => n.CreatedAt.Date))
        {
            <h2 class="eyebrow day-label">@DateLabels.Day(day.Key, today)</h2>
            <ul class="note-rows">
                @foreach (var item in day)
                {
                    <li class="@(item.IsRead ? string.Empty : "is-unread")">
                        <partial name="_NotificationIcon" model="item.Type" />
                        <div class="body">
                            <div class="hrow wrap gp-8">
                                @if (!item.IsRead)
                                {
                                    <span class="unread-dot inline" aria-label="Unread"></span>
                                }
                                <span class="strong @(item.IsRead ? "title-read" : string.Empty)">@item.Title</span>
                                <span class="badge">@item.Type.GetDisplayName()</span>
                            </div>
                            <p class="small muted">@item.Message</p>
                            <span class="xs subtle">@item.CreatedAt.ToString("HH:mm")</span>
                        </div>
                        <div class="actions">
                            @if (item.LinkUrl is { } link)
                            {
                                <a class="btn btn-secondary btn-sm" href="@link">Open</a>
                            }
                            @if (!item.IsRead)
                            {
                                <form class="inline" asp-action="MarkAsRead" asp-route-id="@item.NotificationId" asp-route-page="@Model.Page" method="post">
                                    <button type="submit" class="btn btn-ghost btn-sm">Mark as read</button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        <partial name="_Pager" model="pager" />
    </section>
}
