@model AssignTrainerViewModel
@{
    ViewData["Title"] = "Assign a trainer";
    var clients = new SelectList(Model.ClientOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
    var trainers = new SelectList(Model.TrainerOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <p><a asp-action="Index">&larr; All assignments</a></p>
        <h1 class="h2 mb-2">Assign a trainer</h1>
        <p class="text-muted mb-4">
            A client has one trainer at a time: if they already have one, that assignment ends on the start date.
            Only approved, active trainers with room are listed.
        </p>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Assign" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ClientId" class="form-label"></label>
                        <select asp-for="ClientId" asp-items="clients" class="form-select">
                            <option value="">Choose a client…</option>
                        </select>
                        <span asp-validation-for="ClientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TrainerId" class="form-label"></label>
                        @if (Model.TrainerOptions.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                No approved trainer has room for another client. Approve a trainer or raise a trainer's capacity first.
                            </div>
                        }
                        else
                        {
                            <select asp-for="TrainerId" asp-items="trainers" class="form-select">
                                <option value="">Choose a trainer…</option>
                            </select>
                        }
                        <span asp-validation-for="TrainerId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label> <span class="text-muted small">(optional)</span>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Why this trainer suits the client"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Assign</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
