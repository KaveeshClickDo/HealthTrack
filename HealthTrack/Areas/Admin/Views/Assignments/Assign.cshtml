@model AssignTrainerViewModel
@{
    ViewData["Title"] = "Assign a trainer";
    ViewData["Parent"] = "Assignments";
    ViewData["ParentUrl"] = Url.Action("Index");
    ViewData["ContentClass"] = "narrow-sm";
    var clients = new SelectList(Model.ClientOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
    var trainers = new SelectList(Model.TrainerOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
}

<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16)All assignments</a>
<div class="page-head">
    <div class="intro">
        <h1 class="h1">Assign a trainer</h1>
        <p>A client has one trainer at a time: if they already have one, that assignment ends on the start date. Only approved, active trainers with room are listed.</p>
    </div>
</div>

<form class="card form-card" asp-action="Assign" method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <div class="form-grid">
        <div class="field">
            <label asp-for="ClientId" class="label"></label>
            <select asp-for="ClientId" asp-items="clients" class="select">
                <option value="">Choose a client…</option>
            </select>
            <span asp-validation-for="ClientId" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="TrainerId" class="label"></label>
            @if (Model.TrainerOptions.Count == 0)
            {
                <div class="alert alert-info">@Icons.Svg("info", 18)<span>No approved trainer has room for another client. Approve a trainer or raise a trainer's capacity first.</span></div>
            }
            else
            {
                <select asp-for="TrainerId" asp-items="trainers" class="select">
                    <option value="">Choose a trainer…</option>
                </select>
            }
            <span asp-validation-for="TrainerId" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="StartDate" class="label"></label>
            <input asp-for="StartDate" class="input" />
            <span asp-validation-for="StartDate" class="error-text"></span>
        </div>
        <div class="field full">
            <label asp-for="Notes" class="label">Notes <span class="opt">Optional</span></label>
            <textarea asp-for="Notes" class="textarea" placeholder="Why this trainer suits the client"></textarea>
            <span asp-validation-for="Notes" class="error-text"></span>
        </div>
    </div>
    <div class="actions end">
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-primary">@Icons.Svg("link", 18)Assign</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
