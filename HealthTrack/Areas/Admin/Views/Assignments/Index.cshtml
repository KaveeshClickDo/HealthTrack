@model AssignmentsOverviewViewModel
@{
    ViewData["Title"] = "Assignments";
    ViewData["Parent"] = "People";
    var filter = Model.Filter;
    var pager = new PagerViewModel(Model.Assignments.Page, Model.Assignments.TotalPages, Model.Assignments.TotalCount,
        new Dictionary<string, string?>
        {
            ["search"] = filter.Search,
            ["activeOnly"] = filter.ActiveOnly ? "true" : null
        });
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Assignments</h1>
        <p>Which professional looks after which client. A client has one trainer at a time; ended assignments stay as history.</p>
    </div>
    <div class="actions"><a class="btn btn-primary" asp-action="Assign">@Icons.Svg("link", 18)Assign a trainer</a></div>
</div>

<div class="split">
    <div class="main gp-20">
        <form method="get" asp-action="Index" class="card filter-bar">
            <div class="field grow-2">
                <label for="search" class="label">Client or trainer</label>
                <div class="input-wrap"><span class="lead-icon">@Icons.Svg("search", 18)</span><input type="search" id="search" name="search" value="@filter.Search" class="input" maxlength="256" placeholder="Search by name or email" /></div>
            </div>
            <label class="check" for="activeOnly"><input type="checkbox" id="activeOnly" name="activeOnly" value="true" checked="@filter.ActiveOnly" data-auto-submit /><span>Active only</span></label>
            <div class="actions">
                <button type="submit" class="btn btn-secondary">Filter</button>
                <a class="btn btn-ghost" asp-action="Index">Clear</a>
            </div>
        </form>

        @if (Model.Assignments.TotalCount == 0)
        {
            <div class="card empty">
                <span class="icon">@Icons.Svg("link", 24)</span>
                <p>No assignments match. Assign a trainer to a client to get started.</p>
                <a class="btn btn-primary" asp-action="Assign">Assign a trainer</a>
            </div>
        }
        else
        {
            <section class="card flush">
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th scope="col">Client</th><th scope="col">Trainer</th><th scope="col">From</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments.Items)
                            {
                                <tr class="@(assignment.IsActive ? string.Empty : "muted-row")">
                                    <th scope="row">
                                        <span class="cell-person"><span class="avatar av-sm av-client">@assignment.ClientName.Initials()</span><span>@assignment.ClientName<span class="sub">@assignment.ClientEmail</span></span></span>
                                        @if (!string.IsNullOrEmpty(assignment.Notes))
                                        {
                                            <span class="sub">Note: @assignment.Notes</span>
                                        }
                                    </th>
                                    <td><span class="cell-person"><span class="avatar av-sm av-trainer">@assignment.TrainerName.Initials()</span><span>@assignment.TrainerName<span class="sub">@assignment.ProfessionalType.GetDisplayName()</span></span></span></td>
                                    <td class="nowrap">@assignment.StartDate.ToString("d MMM yyyy")</td>
                                    <td class="nowrap">
                                        @if (assignment.EndDate is { } endDate)
                                        {
                                            <span class="badge">Ended</span><span class="sub">@endDate.ToString("d MMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-green"><span class="dot"></span>Active</span>
                                        }
                                    </td>
                                    <td class="r">
                                        @if (assignment.IsActive)
                                        {
                                            <form class="inline" asp-action="End" asp-route-id="@assignment.AssignmentId" method="post"
                                                  data-confirm="End the assignment of @assignment.ClientName to @assignment.TrainerName today?">
                                                <input type="hidden" name="endDate" value="@Model.Today.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-ghost btn-sm">End</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="pager" />
            </section>
        }
    </div>

    <aside class="aside">
        <section class="card vs gp-14">
            <div class="hrow gap-10"><h2 class="h3">Clients without a trainer</h2>@if (Model.UnassignedClients.Count > 0) {<span class="badge b-amber count-chip">@Model.UnassignedClients.Count</span>}</div>
            @if (Model.UnassignedClients.Count == 0)
            {
                <p class="small muted">Every active client has a trainer.</p>
            }
            else
            {
                <ul class="list">
                    @foreach (var client in Model.UnassignedClients)
                    {
                        <li class="hrow">
                            <span class="avatar av-sm av-@(client.ClientId % 6 + 1)">@client.User.FullName.Initials()</span>
                            <span class="grow"><span class="small strong d-block">@client.User.FullName</span><span class="xs subtle">@client.FitnessGoal.GetDisplayName()</span></span>
                            <a class="btn btn-primary btn-sm" asp-action="Assign" asp-route-clientId="@client.ClientId">Assign</a>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card vs gp-14">
            <h2 class="h3">Trainer workload</h2>
            @if (Model.TrainerLoad.Count == 0)
            {
                <p class="small muted">No approved trainers yet. Approve one under Trainer approvals.</p>
            }
            else
            {
                <div class="load-list">
                    @foreach (var trainer in Model.TrainerLoad)
                    {
                        <div class="vs gp-8">
                            <div class="row-head">
                                <span>@trainer.FullName @if (trainer.AccountStatus != AccountStatus.Active) {<span class="badge @StatusBadges.For(trainer.AccountStatus)">@trainer.AccountStatus.GetDisplayName()</span>}</span>
                                <span class="num subtle">@trainer.ActiveClients of @trainer.MaxClients</span>
                            </div>
                            <div class="bar" role="progressbar" aria-label="@trainer.FullName's load" aria-valuenow="@trainer.LoadPercent" aria-valuemin="0" aria-valuemax="100"><i class="@(trainer.HasCapacity ? string.Empty : "red")" data-progress-width="@trainer.LoadPercent"></i></div>
                        </div>
                    }
                </div>
            }
        </section>
    </aside>
</div>
