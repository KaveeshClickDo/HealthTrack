@model IReadOnlyList<PendingTrainerViewModel>
@{
    ViewData["Title"] = "Trainer approvals";
    ViewData["Parent"] = "People";
}

<div class="page-head">
    <div class="intro">
        <div class="hrow gap-10"><h1 class="h1">Trainer approvals</h1>@if (Model.Count > 0) {<span class="badge b-amber">@Model.Count waiting</span>}</div>
        <p>Professionals can't log in until you approve them. Check their qualifications and licence first.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("user-check", 24)</span>
        <p><span class="strong">No registrations are waiting.</span> New ones appear here, and you get a notification for each.</p>
    </div>
}
else
{
    <div class="split">
        <div class="main gp-20">
            @foreach (var trainer in Model)
            {
                var first = trainer.FullName.Split(' ')[0];
                <article class="card applicant">
                    <div class="who">
                        <span class="avatar av-lg av-trainer">@trainer.FullName.Initials()</span>
                        <div class="grow vs gp-4">
                            <div class="hrow wrap gp-8"><h2 class="h2">@trainer.FullName</h2><span class="badge b-violet">@trainer.ProfessionalType.GetDisplayName()</span></div>
                            <span class="small subtle">@trainer.Email@(trainer.PhoneNumber is { } phone ? " · " + phone : string.Empty)</span>
                        </div>
                        <span class="xs subtle">Registered @trainer.RegisteredAt.ToString("d MMM yyyy 'at' HH:mm")</span>
                    </div>
                    <div class="divider"></div>
                    <dl class="kv">
                        <dt>Specialisation</dt><dd>@trainer.Specialization</dd>
                        <dt>Qualifications</dt><dd>@trainer.Qualifications</dd>
                        <dt>Licence number</dt><dd>@if (trainer.LicenseNumber is { } licence) {<span class="mono-chip">@licence</span>} else {<span class="subtle">None given (fitness trainer)</span>}</dd>
                        <dt>Experience</dt><dd>@trainer.YearsOfExperience years</dd>
                        <dt>Bio</dt><dd>@(trainer.Bio is { } bio ? "“" + bio + "”" : "No bio")</dd>
                    </dl>
                    <div class="divider"></div>
                    <div class="decide">
                        <form class="inline" asp-action="Approve" asp-route-id="@trainer.TrainerId" method="post">
                            <button type="submit" class="btn btn-success">@Icons.Svg("check", 18)Approve @first</button>
                        </form>
                        <form class="reject" asp-action="Reject" asp-route-id="@trainer.TrainerId" method="post"
                              data-confirm="Reject @trainer.FullName's registration? The account will be deactivated.">
                            <label for="reason-@trainer.TrainerId" class="small strong">Or reject, with a reason</label>
                            <div class="hrow">
                                <input type="text" id="reason-@trainer.TrainerId" name="Reason" class="input" required maxlength="400" placeholder="For example, the licence number couldn't be verified" />
                                <button type="submit" class="btn btn-danger">Reject</button>
                            </div>
                        </form>
                    </div>
                </article>
            }
        </div>
        <aside class="aside card vs gp-16">
            <h2 class="h3">When you approve</h2>
            <ul class="list uses">
                <li class="small">@Icons.Svg("log-in", 18)<span>They get a notification, and can log in and set their availability.</span></li>
                <li class="small">@Icons.Svg("calendar-check", 18)<span>Clients can book appointments with them.</span></li>
                <li class="small">@Icons.Svg("link", 18)<span>You can assign clients to them.</span></li>
            </ul>
            <p class="xs subtle">Rejecting deactivates the account. The reason is recorded in the audit log.</p>
        </aside>
    </div>
}
