@model AuditLogPageViewModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Parent"] = "Insights";
    var filter = Model.Filter;
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount,
        new Dictionary<string, string?>
        {
            ["userEmail"] = filter.UserEmail,
            ["auditAction"] = filter.AuditAction is { } actionFilter ? ((int)actionFilter).ToString() : null,
            ["from"] = filter.From?.ToString("yyyy-MM-dd"),
            ["to"] = filter.To?.ToString("yyyy-MM-dd")
        });
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Audit log</h1>
        <p>Sign-ins, registrations, approvals, assignments and other changes, newest first. Passwords and health values are never recorded.</p>
    </div>
</div>

<form method="get" asp-action="Index" class="card filter-bar">
    <div class="field grow-2">
        <label for="userEmail" class="label">User email</label>
        <div class="input-wrap"><span class="lead-icon">@Icons.Svg("search", 18)</span><input type="search" id="userEmail" name="userEmail" value="@filter.UserEmail" class="input" maxlength="256" placeholder="someone@example.com" /></div>
    </div>
    <div class="field">
        <label for="auditAction" class="label">Action</label>
        <select id="auditAction" name="auditAction" class="select" data-auto-submit>
            <option value="">All actions</option>
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <option value="@((int)action)" selected="@(filter.AuditAction == action)">@action.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="from" class="label">From</label>
        <input type="date" id="from" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" class="input" />
    </div>
    <div class="field">
        <label for="to" class="label">To</label>
        <input type="date" id="to" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" class="input" />
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a class="btn btn-ghost" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("scroll", 24)</span>
        <p>No events match these filters.</p>
        <a class="btn btn-secondary" asp-action="Index">Clear the filters</a>
    </div>
}
else
{
    <section class="card flush">
        <div class="table-wrap">
            <table class="table compact">
                <thead><tr><th scope="col">When</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">Record</th><th scope="col">Details</th><th scope="col">IP address</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Results.Items)
                    {
                        <tr>
                            <td class="nowrap">@item.Timestamp.ToString("d MMM yyyy")<span class="sub">@item.Timestamp.ToString("HH:mm:ss")</span></td>
                            <td>
                                @if (item.UserEmail is null)
                                {
                                    <span class="subtle">Unknown</span>
                                }
                                else
                                {
                                    @item.UserName<span class="sub">@item.UserEmail</span>
                                }
                            </td>
                            <td><span class="badge @StatusBadges.For(item.Action)">@item.Action.GetDisplayName()</span></td>
                            <td class="small nowrap subtle">@(item.EntityName is null ? "–" : $"{item.EntityName} {item.EntityId}")</td>
                            <td class="small">@(item.Details ?? "–")</td>
                            <td class="small nowrap subtle mono">@item.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    </section>
}
