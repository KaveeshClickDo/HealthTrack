@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    var filter = Model.Filter;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Users</h1>
    <a class="btn btn-primary" asp-action="CreateAdmin">Create administrator</a>
</div>

<form method="get" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label small">Name or email</label>
            <input type="search" id="search" name="search" value="@filter.Search" class="form-control" maxlength="256" />
        </div>
        <div class="col-sm-6 col-md-2">
            <label for="role" class="form-label small">Role</label>
            <select id="role" name="role" class="form-select">
                <option value="">All roles</option>
                @foreach (var role in AppRoles.All)
                {
                    <option value="@role" selected="@(filter.Role == role)">@role</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3">
            <label for="status" class="form-label small">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<AccountStatus>())
                {
                    <option value="@((int)status)" selected="@(filter.Status == status)">@status.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
            <a class="btn btn-link" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            No users match these filters. <a asp-action="Index">Clear the filters</a> to see everyone.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Registered</th>
                        <th scope="col">Last login</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Results.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@user.UserId">@user.FullName</a></td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td><span class="badge @StatusBadges.For(user.AccountStatus)">@user.AccountStatus.GetDisplayName()</span></td>
                            <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>@(user.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount,
        new Dictionary<string, string?>
        {
            ["search"] = filter.Search,
            ["role"] = filter.Role,
            ["status"] = filter.Status is { } statusFilter ? ((int)statusFilter).ToString() : null
        });
}
<partial name="_Pager" model="pager" />
