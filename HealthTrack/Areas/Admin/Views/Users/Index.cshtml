@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["Parent"] = "People";
    var filter = Model.Filter;
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount,
        new Dictionary<string, string?>
        {
            ["search"] = filter.Search,
            ["role"] = filter.Role,
            ["status"] = filter.Status is { } statusFilter ? ((int)statusFilter).ToString() : null
        });

    static string AvatarFor(string role) => role == AppRoles.Admin ? "av-admin" : role == AppRoles.Trainer ? "av-trainer" : "av-client";
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Users</h1>
        <p>Everyone with an account. Open someone to see their details, change their status or reset their access.</p>
    </div>
    <div class="actions"><a class="btn btn-primary" asp-action="CreateAdmin">@Icons.Svg("user-plus", 18)Create administrator</a></div>
</div>

<form method="get" asp-action="Index" class="card filter-bar">
    <div class="field grow-2">
        <label for="search" class="label">Name or email</label>
        <div class="input-wrap"><span class="lead-icon">@Icons.Svg("search", 18)</span><input type="search" id="search" name="search" value="@filter.Search" class="input" maxlength="256" placeholder="Search people" /></div>
    </div>
    <div class="field">
        <label for="role" class="label">Role</label>
        <select id="role" name="role" class="select" data-auto-submit>
            <option value="">All roles</option>
            @foreach (var role in AppRoles.All)
            {
                <option value="@role" selected="@(filter.Role == role)">@role</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="status" class="label">Status</label>
        <select id="status" name="status" class="select" data-auto-submit>
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<AccountStatus>())
            {
                <option value="@((int)status)" selected="@(filter.Status == status)">@status.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="actions">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a class="btn btn-ghost" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("search", 24)</span>
        <p>No users match these filters.</p>
        <a class="btn btn-secondary" asp-action="Index">Clear the filters</a>
    </div>
}
else
{
    <section class="card flush">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Registered</th><th scope="col">Last login</th><th scope="col"><span class="visually-hidden">Open</span></th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Results.Items)
                    {
                        <tr>
                            <th scope="row">
                                <span class="cell-person">
                                    <span class="avatar av-sm @AvatarFor(user.Role)">@user.FullName.Initials()</span>
                                    <span><a class="strong row-link" asp-action="Details" asp-route-id="@user.UserId">@user.FullName</a><span class="sub">@user.Email</span></span>
                                </span>
                            </th>
                            <td>@user.Role</td>
                            <td><span class="badge @StatusBadges.For(user.AccountStatus)"><span class="dot"></span>@user.AccountStatus.GetDisplayName()</span></td>
                            <td class="nowrap">@user.CreatedAt.ToString("d MMM yyyy")</td>
                            <td class="nowrap">@(user.LastLoginAt is { } last ? last.ToString("d MMM yyyy") : "Never")@if (user.LastLoginAt is { } at) {<span class="sub">@at.ToString("HH:mm")</span>}</td>
                            <td class="r"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@user.UserId">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    </section>
}
