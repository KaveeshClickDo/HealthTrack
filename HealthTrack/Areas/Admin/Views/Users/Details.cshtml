@model UserDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<p><a asp-action="Index">&larr; All users</a></p>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">@Model.FullName</h1>
        <span class="badge text-bg-light border">@Model.Role</span>
        <span class="badge @StatusBadges.For(Model.AccountStatus)">@Model.AccountStatus.GetDisplayName()</span>
        @if (Model.LockoutEnd is { } lockoutEnd)
        {
            <span class="badge text-bg-danger">Locked out until @lockoutEnd.ToLocalTime().ToString("HH:mm")</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsCurrentUser)
        {
            <span class="text-muted small align-self-center">This is your account. You can't suspend yourself.</span>
        }
        else if (Model.AccountStatus == AccountStatus.Active)
        {
            <form asp-action="Suspend" asp-route-id="@Model.UserId" method="post"
                  data-confirm="Suspend @Model.FullName? They will be signed out within a minute and can't log in until reactivated.">
                <button type="submit" class="btn btn-outline-danger">Suspend account</button>
            </form>
        }
        else if (Model.AccountStatus == AccountStatus.Suspended)
        {
            <form asp-action="Reactivate" asp-route-id="@Model.UserId" method="post">
                <button type="submit" class="btn btn-primary">Reactivate account</button>
            </form>
        }
        else if (Model.AccountStatus == AccountStatus.PendingApproval)
        {
            <a class="btn btn-primary" asp-controller="TrainerApprovals" asp-action="Index">Review the registration</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Account</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@Model.Email</dd>
                    <dt class="col-sm-5">Phone number</dt>
                    <dd class="col-sm-7">@(Model.PhoneNumber ?? "Not given")</dd>
                    <dt class="col-sm-5">Date of birth</dt>
                    <dd class="col-sm-7">@Model.DateOfBirth.ToString("dd MMM yyyy") (age @Model.Age)</dd>
                    <dt class="col-sm-5">Gender</dt>
                    <dd class="col-sm-7">@Model.Gender.GetDisplayName()</dd>
                    <dt class="col-sm-5">Registered</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Last login</dt>
                    <dd class="col-sm-7">@(Model.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        @if (Model.Client is { } client)
        {
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">Client activity</h2>
                    <p class="text-muted small mb-3">Totals only: administrators never see clinical notes or measurement values.</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Goal</dt>
                        <dd class="col-sm-7">@client.FitnessGoal.GetDisplayName()</dd>
                        <dt class="col-sm-5">Activity level</dt>
                        <dd class="col-sm-7">@client.ActivityLevel.GetDisplayName()</dd>
                        <dt class="col-sm-5">Trainer</dt>
                        <dd class="col-sm-7">
                            @if (client.TrainerName is null)
                            {
                                <span>None</span> <a asp-controller="Assignments" asp-action="Assign" asp-route-clientId="@client.ClientId">Assign a trainer</a>
                            }
                            else
                            {
                                @client.TrainerName
                            }
                        </dd>
                        <dt class="col-sm-5">Workouts logged</dt>
                        <dd class="col-sm-7">
                            @client.WorkoutsLogged
                            @if (client.LastWorkoutDate is { } lastWorkout)
                            {
                                <span class="text-muted">(last on @lastWorkout.ToString("dd MMM yyyy"))</span>
                            }
                        </dd>
                        <dt class="col-sm-5">Meals logged</dt>
                        <dd class="col-sm-7">@client.MealsLogged</dd>
                        <dt class="col-sm-5">Measurements recorded</dt>
                        <dd class="col-sm-7">@client.MeasurementsRecorded</dd>
                        <dt class="col-sm-5">Appointments</dt>
                        <dd class="col-sm-7">@client.Appointments</dd>
                    </dl>
                </div>
            </div>
        }
        else if (Model.Trainer is { } trainer)
        {
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Professional details</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Profession</dt>
                        <dd class="col-sm-7">@trainer.ProfessionalType.GetDisplayName()</dd>
                        <dt class="col-sm-5">Specialisation</dt>
                        <dd class="col-sm-7">@trainer.Specialization</dd>
                        <dt class="col-sm-5">Licence number</dt>
                        <dd class="col-sm-7">@(trainer.LicenseNumber ?? "Not needed")</dd>
                        <dt class="col-sm-5">Experience</dt>
                        <dd class="col-sm-7">@trainer.YearsOfExperience years</dd>
                        <dt class="col-sm-5">Approved</dt>
                        <dd class="col-sm-7">@(trainer.ApprovedAt?.ToString("dd MMM yyyy") ?? "Not yet")</dd>
                        <dt class="col-sm-5">Active clients</dt>
                        <dd class="col-sm-7">@trainer.ActiveClients of @trainer.MaxClients</dd>
                        <dt class="col-sm-5">Plans written</dt>
                        <dd class="col-sm-7">@trainer.WorkoutPlans workout, @trainer.DietPlans diet</dd>
                        <dt class="col-sm-5">Appointments</dt>
                        <dd class="col-sm-7">@trainer.Appointments</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0">Recent activity</h2>
            <a asp-controller="AuditLog" asp-action="Index" asp-route-userEmail="@Model.Email">Full audit log for this user</a>
        </div>
        @if (Model.RecentEvents.Count == 0)
        {
            <p class="text-muted mb-0">No audited activity yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Action</th>
                            <th scope="col">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentEvents)
                        {
                            <tr>
                                <td class="text-nowrap">@item.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge @StatusBadges.For(item.Action)">@item.Action.GetDisplayName()</span></td>
                                <td>@item.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
