@using HealthTrack.Models.Entities
@model LibraryListViewModel<Exercise, ExerciseCategory>
@{
    ViewData["Title"] = "Exercise library";
    ViewData["Parent"] = "Library";
    ViewData["Crumb"] = "Exercises";
    var filter = Model.Filter;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount,
        new Dictionary<string, string?>
        {
            ["search"] = filter.Search,
            ["category"] = filter.Category is { } categoryFilter ? ((int)categoryFilter).ToString() : null,
            ["includeInactive"] = filter.IncludeInactive ? "true" : null
        });
    var inactive = filter.IncludeInactive ? "true" : null;
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Exercise library</h1>
        <p>Trainers build plans from these. The MET value sets how many calories a logged session burns.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="Foods">@Icons.Svg("apple", 18)Food library</a>
        <a class="btn btn-primary" asp-action="EditExercise">@Icons.Svg("plus", 18)Add exercise</a>
    </div>
</div>

<form method="get" asp-action="Exercises" class="card lib-filter">
    @if (filter.Category is { } chosen)
    {
        <input type="hidden" name="category" value="@((int)chosen)" />
    }
    <div class="top">
        <div class="input-wrap"><span class="lead-icon">@Icons.Svg("search", 18)</span><input type="search" id="search" name="search" value="@filter.Search" class="input" maxlength="100" placeholder="Search by name" aria-label="Search by name" /></div>
        <label class="check" for="includeInactive"><input type="checkbox" id="includeInactive" name="includeInactive" value="true" class="switch" checked="@filter.IncludeInactive" data-auto-submit /><span>Show inactive</span></label>
        <button type="submit" class="btn btn-secondary">Search</button>
    </div>
    <nav class="cat-links" aria-label="Category">
        <a class="@(filter.Category is null ? "is-on" : string.Empty)" asp-action="Exercises" asp-route-search="@filter.Search" asp-route-includeInactive="@inactive">All</a>
        @foreach (var category in Enum.GetValues<ExerciseCategory>())
        {
            <a class="@(filter.Category == category ? "is-on" : string.Empty)" asp-action="Exercises" asp-route-category="@((int)category)" asp-route-search="@filter.Search" asp-route-includeInactive="@inactive">@category.GetDisplayName()</a>
        }
    </nav>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("dumbbell", 24)</span>
        <p>No exercises match.</p>
        <div class="actions"><a class="btn btn-secondary" asp-action="Exercises">Clear the filters</a><a class="btn btn-primary" asp-action="EditExercise">Add an exercise</a></div>
    </div>
}
else
{
    <section class="card flush">
        <div class="card-head pad"><h2 class="h3">@(filter.Category?.GetDisplayName() ?? "All exercises")</h2><span class="small subtle">@Model.Results.TotalCount @(Model.Results.TotalCount == 1 ? "exercise" : "exercises")</span></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Name</th><th scope="col">Category</th><th scope="col">Muscle group</th><th scope="col">Equipment</th><th scope="col" class="r">MET</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var exercise in Model.Results.Items)
                    {
                        <tr class="@(exercise.IsActive ? string.Empty : "muted-row")">
                            <th scope="row"><span class="cell-person"><img class="thumb" src="@ExercisePhotos.For(exercise.Name, exercise.Category)" alt="" /><a class="strong row-link" asp-action="EditExercise" asp-route-id="@exercise.ExerciseId">@exercise.Name</a></span></th>
                            <td>@exercise.Category.GetDisplayName()</td>
                            <td>@exercise.MuscleGroup.GetDisplayName()</td>
                            <td class="@(exercise.Equipment is null ? "subtle" : string.Empty)">@(exercise.Equipment ?? "Body weight")</td>
                            <td class="r num">@exercise.MetValue.ToString("0.0")</td>
                            <td><span class="badge @(exercise.IsActive ? "b-green" : string.Empty)"><span class="dot"></span>@(exercise.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="r nowrap">
                                <a class="btn btn-ghost btn-sm" asp-action="EditExercise" asp-route-id="@exercise.ExerciseId">Edit</a>
                                <form class="inline" asp-action="ToggleActive" method="post"
                                      data-confirm="@(exercise.IsActive ? $"Deactivate {exercise.Name}? It disappears from the plan and log pickers; existing plans and logs keep it." : null)">
                                    <input type="hidden" name="type" value="exercise" />
                                    <input type="hidden" name="id" value="@exercise.ExerciseId" />
                                    <input type="hidden" name="isActive" value="@(exercise.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-ghost btn-sm @(exercise.IsActive ? "link-danger" : "accent")">@(exercise.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-foot"><span>Deactivated exercises disappear from the pickers; plans and logs that use them keep them.</span></div>
        <partial name="_Pager" model="pager" />
    </section>
}
