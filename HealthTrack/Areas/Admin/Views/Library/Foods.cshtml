@using HealthTrack.Models.Entities
@model LibraryListViewModel<FoodItem, FoodCategory>
@{
    ViewData["Title"] = "Food library";
    var filter = Model.Filter;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount,
        new Dictionary<string, string?>
        {
            ["search"] = filter.Search,
            ["category"] = filter.Category is { } categoryFilter ? ((int)categoryFilter).ToString() : null,
            ["includeInactive"] = filter.IncludeInactive ? "true" : null
        });
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-0">Food library</h1>
        <p class="text-muted mb-0">Clients log meals from these; nutrition is per serving.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Exercises">Exercise library</a>
        <a class="btn btn-primary" asp-action="EditFood">Add food</a>
    </div>
</div>

<form method="get" asp-action="Foods" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label small">Name</label>
            <input type="search" id="search" name="search" value="@filter.Search" class="form-control" maxlength="100" />
        </div>
        <div class="col-md-3">
            <label for="category" class="form-label small">Category</label>
            <select id="category" name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Enum.GetValues<FoodCategory>())
                {
                    <option value="@((int)category)" selected="@(filter.Category == category)">@category.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check mb-2">
                <input type="checkbox" id="includeInactive" name="includeInactive" value="true" class="form-check-input" checked="@filter.IncludeInactive" />
                <label for="includeInactive" class="form-check-label">Show inactive</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
            <a class="btn btn-link" asp-action="Foods">Clear</a>
        </div>
    </div>
</form>

@if (Model.Results.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            No foods match. <a asp-action="Foods">Clear the filters</a> or <a asp-action="EditFood">add a food</a>.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Category</th>
                        <th scope="col">Serving</th>
                        <th scope="col" class="text-end">kcal</th>
                        <th scope="col" class="text-end">Protein</th>
                        <th scope="col" class="text-end">Carbs</th>
                        <th scope="col" class="text-end">Fat</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var food in Model.Results.Items)
                    {
                        <tr class="@(food.IsActive ? string.Empty : "text-muted")">
                            <td><a asp-action="EditFood" asp-route-id="@food.FoodItemId">@food.Name</a></td>
                            <td>@food.Category.GetDisplayName()</td>
                            <td class="text-nowrap">@food.ServingSize.ToString("0.##") @food.ServingUnit</td>
                            <td class="text-end">@food.CaloriesPerServing.ToString("0")</td>
                            <td class="text-end">@food.ProteinG.ToString("0.#") g</td>
                            <td class="text-end">@food.CarbsG.ToString("0.#") g</td>
                            <td class="text-end">@food.FatG.ToString("0.#") g</td>
                            <td><span class="badge @(food.IsActive ? "text-bg-success" : "text-bg-secondary")">@(food.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <form asp-action="ToggleActive" method="post"
                                      data-confirm="@(food.IsActive ? $"Deactivate {food.Name}? It disappears from the meal picker; logged meals keep it." : null)">
                                    <input type="hidden" name="type" value="food" />
                                    <input type="hidden" name="id" value="@food.FoodItemId" />
                                    <input type="hidden" name="isActive" value="@(food.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm @(food.IsActive ? "btn-outline-danger" : "btn-outline-primary")">
                                        @(food.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_Pager" model="pager" />
