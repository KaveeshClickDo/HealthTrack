@model ExerciseViewModel
@{
    var isNew = Model.ExerciseId is null;
    ViewData["Title"] = isNew ? "Add exercise" : "Edit exercise";
    ViewData["Parent"] = "Exercises";
    ViewData["ParentUrl"] = Url.Action("Exercises");
    ViewData["ContentClass"] = "narrow-lg";
}

<a class="back" asp-action="Exercises">@Icons.Svg("arrow-left", 16)Exercise library</a>
<div class="page-head">
    <div class="intro">
        <div class="hrow gap-10">
            <h1 class="h1">@(isNew ? "Add an exercise" : Model.Name)</h1>
            @if (!isNew && !Model.IsActive)
            {
                <span class="badge">Inactive</span>
            }
        </div>
        <p>@(isNew ? "New exercises appear in the plan and workout log pickers straight away." : "Changes apply to new plans and logs; logged sessions keep the calories they were saved with.")</p>
    </div>
</div>

<div class="split">
    <form class="main card form-card" asp-action="EditExercise" method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="ExerciseId" type="hidden" />
        <input asp-for="IsActive" type="hidden" />
        <div class="form-grid">
            <div class="field">
                <label asp-for="Name" class="label"></label>
                <input asp-for="Name" class="input" />
                <span asp-validation-for="Name" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="MetValue" class="label">MET value</label>
                <input asp-for="MetValue" type="number" step="0.1" min="1" max="20" class="input" />
                <span class="hint">From the Compendium of Physical Activities.</span>
                <span asp-validation-for="MetValue" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Category" class="label"></label>
                <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExerciseCategory>()" class="select">
                    <option value="">Choose…</option>
                </select>
                <span asp-validation-for="Category" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="MuscleGroup" class="label"></label>
                <select asp-for="MuscleGroup" asp-items="Html.GetEnumSelectList<MuscleGroup>()" class="select">
                    <option value="">Choose…</option>
                </select>
                <span asp-validation-for="MuscleGroup" class="error-text"></span>
            </div>
            <div class="field full">
                <label asp-for="Equipment" class="label">Equipment <span class="opt">Leave empty for body weight</span></label>
                <input asp-for="Equipment" class="input" />
                <span asp-validation-for="Equipment" class="error-text"></span>
            </div>
            <div class="field full">
                <label asp-for="Instructions" class="label"></label>
                <textarea asp-for="Instructions" class="textarea"></textarea>
                <span asp-validation-for="Instructions" class="error-text"></span>
            </div>
        </div>
        <div class="actions end">
            <a class="btn btn-ghost" asp-action="Exercises">Cancel</a>
            <button type="submit" class="btn btn-primary">@Icons.Svg("check", 18)@(isNew ? "Add the exercise" : "Save changes")</button>
        </div>
    </form>

    <aside class="aside">
        <div class="frame add-preview">
            <img class="photo photo-fill" src="@(isNew ? null : ExercisePhotos.For(Model.Name, Model.Category ?? ExerciseCategory.Strength))" alt="" />
            <div class="shade"></div>
            <div class="tile-caption">
                <span class="xs tile-kicker">@(Model.Category?.GetDisplayName() ?? "Photo")</span>
                <span class="h3">@(isNew ? "Shown in plans and logs" : Model.Name)</span>
            </div>
        </div>
        <div class="card vs gp-8">
            <h2 class="h3">How MET is used</h2>
            <p class="small muted">Calories burned = MET × the client's weight in kg × hours. A brisk walk is about 4.3, a run at 10 km/h about 9.8.</p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
