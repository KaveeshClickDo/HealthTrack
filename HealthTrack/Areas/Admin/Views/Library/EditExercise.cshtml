@model ExerciseViewModel
@{
    var isNew = Model.ExerciseId is null;
    ViewData["Title"] = isNew ? "Add exercise" : "Edit exercise";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <p><a asp-action="Exercises">&larr; Exercise library</a></p>
        <div class="d-flex align-items-center gap-2 mb-4">
            <h1 class="h2 mb-0">@ViewData["Title"]</h1>
            @if (!isNew && !Model.IsActive)
            {
                <span class="badge text-bg-secondary">Inactive</span>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="EditExercise" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <input asp-for="ExerciseId" type="hidden" />
                    <input asp-for="IsActive" type="hidden" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MetValue" class="form-label"></label>
                            <input asp-for="MetValue" type="number" step="0.1" min="1" max="20" class="form-control" />
                            <span asp-validation-for="MetValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExerciseCategory>()" class="form-select">
                                <option value="">Choose…</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MuscleGroup" class="form-label"></label>
                            <select asp-for="MuscleGroup" asp-items="Html.GetEnumSelectList<MuscleGroup>()" class="form-select">
                                <option value="">Choose…</option>
                            </select>
                            <span asp-validation-for="MuscleGroup" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Equipment" class="form-label"></label> <span class="text-muted small">(leave empty for body weight)</span>
                            <input asp-for="Equipment" class="form-control" />
                            <span asp-validation-for="Equipment" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Instructions" class="form-label"></label>
                            <textarea asp-for="Instructions" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Instructions" class="text-danger small"></span>
                        </div>
                    </div>

                    <p class="form-text mt-3 mb-4">
                        Use the MET value of the closest activity in the Compendium of Physical Activities. A new MET value only
                        affects new logs; logged sessions keep the calories they were saved with.
                    </p>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a class="btn btn-outline-secondary" asp-action="Exercises">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
