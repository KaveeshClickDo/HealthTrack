@using HealthTrack.Models.Entities
@model FoodItemViewModel
@{
    var isNew = Model.FoodItemId is null;
    ViewData["Title"] = isNew ? "Add food" : "Edit food";
    ViewData["Parent"] = "Foods";
    ViewData["ParentUrl"] = Url.Action("Foods");
    ViewData["ContentClass"] = "narrow-sm";
}

<a class="back" asp-action="Foods">@Icons.Svg("arrow-left", 16)Food library</a>
<div class="page-head">
    <div class="intro">
        <div class="hrow gap-10">
            <h1 class="h1">@(isNew ? "Add a food" : Model.Name)</h1>
            @if (!isNew && !Model.IsActive)
            {
                <span class="badge">Inactive</span>
            }
        </div>
        <p>Values are per serving. Changes only affect new meal logs; logged meals keep the nutrition they were saved with.</p>
    </div>
</div>

<form class="card form-card" asp-action="EditFood" method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="FoodItemId" type="hidden" />
    <input asp-for="IsActive" type="hidden" />
    <div class="form-grid">
        <div class="field">
            <label asp-for="Name" class="label"></label>
            <input asp-for="Name" class="input" />
            <span asp-validation-for="Name" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="Category" class="label"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<FoodCategory>()" class="select">
                <option value="">Choose…</option>
            </select>
            <span asp-validation-for="Category" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="ServingSize" class="label"></label>
            <input asp-for="ServingSize" type="number" step="0.01" min="0.1" max="5000" class="input" />
            <span asp-validation-for="ServingSize" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="ServingUnit" class="label"></label>
            <select asp-for="ServingUnit" class="select">
                @foreach (var unit in FoodItem.ServingUnits)
                {
                    <option value="@unit">@unit</option>
                }
            </select>
            <span asp-validation-for="ServingUnit" class="error-text"></span>
        </div>
    </div>
    <div class="divider"></div>
    <div class="form-grid macros">
        <div class="field">
            <label asp-for="CaloriesPerServing" class="label">Calories</label>
            <div class="input-wrap"><input asp-for="CaloriesPerServing" type="number" step="0.01" min="0" max="2000" class="input" /><span class="unit">kcal</span></div>
            <span asp-validation-for="CaloriesPerServing" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="ProteinG" class="label">Protein</label>
            <div class="input-wrap"><input asp-for="ProteinG" type="number" step="0.01" min="0" max="500" class="input" /><span class="unit">g</span></div>
            <span asp-validation-for="ProteinG" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="CarbsG" class="label">Carbohydrate</label>
            <div class="input-wrap"><input asp-for="CarbsG" type="number" step="0.01" min="0" max="500" class="input" /><span class="unit">g</span></div>
            <span asp-validation-for="CarbsG" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="FatG" class="label">Fat</label>
            <div class="input-wrap"><input asp-for="FatG" type="number" step="0.01" min="0" max="500" class="input" /><span class="unit">g</span></div>
            <span asp-validation-for="FatG" class="error-text"></span>
        </div>
    </div>
    <div class="actions end">
        <a class="btn btn-ghost" asp-action="Foods">Cancel</a>
        <button type="submit" class="btn btn-primary">@Icons.Svg("check", 18)@(isNew ? "Add the food" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
