@model DietWeekViewModel
@{
    ViewData["Title"] = "Diet plan";
    ViewData["Parent"] = "Nutrition";
    var today = Model.Today;
    var sameEveryDay = Model.Days.Count > 0 && Model.Days.All(d => d.Meals.Count > 0)
        && Model.Days.Select(d => string.Join("|", d.Meals.Select(m => $"{m.MealType}{m.TargetCalories}"))).Distinct().Count() == 1;
}

<div class="page-head">
    <div class="intro">
        <span class="eyebrow">My diet plan</span>
        <h1 class="h1 page-title">@(Model.HasPlan ? Model.Title : "Diet plan")</h1>
        @if (Model.HasPlan)
        {
            <div class="hrow wrap gp-8">
                <span class="badge b-green"><span class="dot"></span>Active</span>
                <span class="small subtle">From @Model.TrainerName · @(Model.HasStarted ? "since" : "starts") @Model.StartDate.ToString("d MMM yyyy")@(Model.EndDate is { } end ? " to " + end.ToString("d MMM yyyy") : string.Empty)</span>
            </div>
        }
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="History">Meal history</a>
        <a class="btn btn-primary" asp-action="LogMeal">@Icons.Svg("plus", 18)Log a meal</a>
    </div>
</div>

@if (!Model.HasPlan)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("apple", 24)</span>
        <p><span class="strong">You don't have an active diet plan yet.</span> Your trainer will set one up with a daily calorie target, and you'll get a notification when it's ready. Meanwhile you can log what you eat.</p>
        <a class="btn btn-primary" asp-action="LogMeal">Log a meal</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="alert on-surface">
            @Icons.Svg("message", 18)
            <span><span class="strong">From your trainer: </span><span class="muted text-prewrap">@Model.Description</span></span>
        </div>
    }

    <div class="grid g-4">
        <div class="card stat"><span class="stat-label">Daily calories</span><span class="kpi">@(today.CalorieTarget?.ToString("N0") ?? "–")<small>kcal</small></span></div>
        <div class="card stat"><span class="stat-label"><i class="swatch protein"></i>Protein</span><span class="kpi">@(today.ProteinTargetG?.ToString() ?? "–")<small>g a day</small></span></div>
        <div class="card stat"><span class="stat-label"><i class="swatch carbs"></i>Carbohydrate</span><span class="kpi">@(today.CarbsTargetG?.ToString() ?? "–")<small>g a day</small></span></div>
        <div class="card stat"><span class="stat-label"><i class="swatch fat"></i>Fat</span><span class="kpi">@(today.FatTargetG?.ToString() ?? "–")<small>g a day</small></span></div>
    </div>

    <div class="split">
        <section class="aside card vs gp-18">
            <div class="card-head"><h2 class="h2">Today so far</h2><span class="small subtle">@Model.TodaysMeals.Count(m => m.IsLogged) of @Model.TodaysMeals.Count meals logged</span></div>
            <partial name="_NutritionBars" model="today" />
        </section>
        <section class="main card gp-6">
            <div class="card-head mb-10"><h2 class="h2">Today's meals</h2><span class="small subtle">Planned @Model.TodaysMeals.Sum(m => m.TargetCalories).ToString("N0") kcal</span></div>
            @if (Model.TodaysMeals.Count == 0)
            {
                <p class="small muted">
                    @(!Model.HasStarted
                        ? "Your plan starts on " + Model.StartDate.ToString("dd MMM yyyy") + "."
                        : "No meals are planned for today. You can still log what you eat.")
                </p>
            }
            else
            {
                <ul class="list">
                    @foreach (var meal in Model.TodaysMeals)
                    {
                        <li class="hrow gp-16">
                            <span class="mono subtle meal-time">@meal.ScheduledTime.ToString("hh\\:mm")</span>
                            <div class="grow">
                                <div class="strong">@meal.MealType.GetDisplayName() <span class="subtle small meal-kcal">· @meal.TargetCalories kcal</span></div>
                                <div class="small muted">@meal.MealDescription</div>
                            </div>
                            @if (meal.IsLogged)
                            {
                                <span class="badge b-green">@Icons.Svg("check", 14)Logged · @meal.LoggedCalories!.Value.ToString("N0") kcal</span>
                            }
                            else
                            {
                                <a class="btn btn-secondary btn-sm" asp-action="LogMeal" asp-route-dietPlanMealId="@meal.DietPlanMealId">Log it</a>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <section class="vs gp-14">
        <div class="between"><h2 class="h2">The week</h2>@if (sameEveryDay) {<span class="small subtle">The same meals every day</span>}</div>
        <div class="week-days">
            @foreach (var day in Model.Days)
            {
                <div class="card day-card@(day.IsToday ? " is-today" : string.Empty)">
                    <span class="between"><span class="strong">@day.DayOfWeek</span>@if (day.IsToday) {<span class="badge b-accent badge-xs">Today</span>}</span>
                    @if (day.Meals.Count == 0)
                    {
                        <span class="xs subtle">No meals planned.</span>
                    }
                    else
                    {
                        <ul class="xs muted">
                            @foreach (var meal in day.Meals)
                            {
                                <li class="between" title="@meal.ScheduledTime.ToString("hh\\:mm") · @meal.MealDescription"><span>@meal.MealType.GetDisplayName()</span><span class="num">@meal.TargetCalories</span></li>
                            }
                        </ul>
                        <span class="xs subtle total">@day.PlannedCalories.ToString("N0") kcal</span>
                    }
                </div>
            }
        </div>
    </section>
}
