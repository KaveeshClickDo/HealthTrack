@model PagedResult<DailyNutritionViewModel>
@{
    ViewData["Title"] = "Meal history";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Meal history</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="MyPlan">My diet plan</a>
        <a class="btn btn-primary" asp-action="LogMeal">Log a meal</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            You haven't logged any meals yet. <a asp-action="LogMeal">Log your first meal</a>; each day then shows here
            with its calories and macros against your plan's targets.
        </div>
    </div>
}
else
{
    @foreach (var day in Model.Items)
    {
        <section class="card shadow-sm mb-3">
            <div class="card-header d-flex flex-wrap justify-content-between gap-2">
                <h2 class="h6 mb-0">@day.Date.ToString("dddd dd MMM yyyy")</h2>
                <span class="small text-muted">@day.Meals.Count @(day.Meals.Count == 1 ? "meal" : "meals")</span>
            </div>
            <div class="card-body">
                <partial name="_NutritionBars" model="day" />
                <ul class="list-group list-group-flush mt-3">
                    @foreach (var meal in day.Meals)
                    {
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between gap-2">
                                <strong>@meal.MealType.GetDisplayName()</strong>
                                <span>@meal.TotalCalories.ToString("N0") kcal</span>
                            </div>
                            @if (meal.PlannedDescription is not null)
                            {
                                <div class="small text-muted">Planned: @meal.PlannedDescription</div>
                            }
                            <div class="small">
                                @string.Join(", ", meal.Items.Select(i => $"{i.FoodName} × {i.Quantity:0.##} ({i.Calories:0} kcal)"))
                            </div>
                            @if (!string.IsNullOrWhiteSpace(meal.Notes))
                            {
                                <div class="small text-muted fst-italic">@meal.Notes</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
}

<partial name="_Pager" model="pager" />
