@model PagedResult<DailyNutritionViewModel>
@{
    ViewData["Title"] = "Meal history";
    ViewData["Parent"] = "Nutrition";
    ViewData["ContentClass"] = "narrow";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());

    string Macro(string name, decimal eaten, int? target) =>
        $"{name} {eaten:0}" + (target is { } grams ? $" of {grams}" : string.Empty) + " g";
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Meal history</h1>
        <p>Each day's meals, with calories and macros against your plan's targets.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="MyPlan">My diet plan</a>
        <a class="btn btn-primary" asp-action="LogMeal">@Icons.Svg("plus", 18)Log a meal</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("utensils", 24)</span>
        <p><span class="strong">You haven't logged any meals yet.</span> Log your first meal; each day then shows here with its calories and macros against your plan's targets.</p>
        <a class="btn btn-primary" asp-action="LogMeal">Log a meal</a>
    </div>
}
else
{
    @foreach (var day in Model.Items)
    {
        var percent = day.PercentOfTarget;
        <article class="card flush">
            <header class="day-head">
                <div><h2 class="h2">@day.Date.ToString("dddd d MMMM")</h2><span class="small subtle">@day.Meals.Count @(day.Meals.Count == 1 ? "meal" : "meals") · @day.Date.ToString("yyyy")</span></div>
                <div class="day-figures">
                    <div class="between small">
                        <span><span class="strong num">@day.CaloriesEaten.ToString("N0")</span> <span class="muted">kcal eaten</span></span>
                        <span class="subtle">@(day.CalorieTarget is { } target ? $"Target {target:N0} kcal · {percent}%" : "No diet plan that day")</span>
                    </div>
                    @if (percent is { } value)
                    {
                        <div class="bar thick" role="progressbar" aria-label="Calories eaten against the target" aria-valuenow="@value" aria-valuemin="0" aria-valuemax="100"><i class="@(value > 110 ? "amber" : "green")" data-progress-width="@Math.Min(value, 100)"></i></div>
                    }
                    <div class="xs subtle">@Macro("Protein", day.ProteinG, day.ProteinTargetG) · @Macro("Carbohydrate", day.CarbsG, day.CarbsTargetG) · @Macro("Fat", day.FatG, day.FatTargetG)</div>
                </div>
            </header>
            <ul class="meal-rows">
                @foreach (var meal in day.Meals)
                {
                    <li>
                        <partial name="_MealIcon" model="meal.MealType" />
                        <div class="body">
                            <div class="between"><span class="strong">@meal.MealType.GetDisplayName()</span><span class="num strong">@meal.TotalCalories.ToString("N0") kcal</span></div>
                            <span class="small muted">@string.Join(" · ", meal.Items.Select(i => $"{i.FoodName} × {i.Quantity:0.##}"))</span>
                            @if (meal.PlannedDescription is not null)
                            {
                                <span class="xs subtle">Planned: @meal.PlannedDescription</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(meal.Notes))
                            {
                                <span class="xs subtle line-note">@meal.Notes</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </article>
    }

    <div class="page-pager"><partial name="_Pager" model="pager" /></div>
}
