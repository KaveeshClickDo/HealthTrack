@using System.Globalization
@model LogMealViewModel
@{
    ViewData["Title"] = "Log a meal";
    ViewData["Parent"] = "Nutrition";
    ViewData["ContentClass"] = "narrow";

    // A colour per food group for the row's icon (meal-log.js swaps it when another food is chosen).
    string Tone(string category) => category switch
    {
        "Dairy" or "Beverages" => "blue",
        "Fruits" => "rose",
        "Vegetables" => "green",
        "Protein" => "orange",
        "Snacks and sweets" => "violet",
        _ => "amber"
    };
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Log a meal</h1>
        <p>Pick what you ate and how many servings — calories and macros are worked out for you.</p>
    </div>
    <div class="actions"><a class="btn btn-secondary" asp-action="MyPlan">My diet plan</a></div>
</div>

@if (Model.PlannedDescription is not null)
{
    <div class="alert alert-info">
        @Icons.Svg("clipboard", 18)
        <span><span class="strong">Planned: </span><span class="muted">@(Model.PlannedDescription + (Model.PlannedCalories is { } planned ? $" · target {planned:N0} kcal" : string.Empty))</span></span>
    </div>
}

@* wwwroot/js/meal-log.js adds and removes food rows, filters the food lists and shows a live kcal total. *@
<form asp-action="LogMeal" method="post" id="meal-log-form" class="form-stack">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="DietPlanMealId" type="hidden" />

    <section class="card field-row">
        <div class="field f-1">
            <label asp-for="MealDate" class="label"></label>
            <input asp-for="MealDate" class="input" />
            <span asp-validation-for="MealDate" class="error-text"></span>
        </div>
        <div class="field f-1">
            <label asp-for="MealType" class="label">Meal</label>
            <select asp-for="MealType" asp-items="Html.GetEnumSelectList<MealType>()" class="select">
                <option value="">Choose…</option>
            </select>
            <span asp-validation-for="MealType" class="error-text"></span>
        </div>
        <div class="field f-3">
            <label asp-for="Notes" class="label">Notes <span class="opt">Optional</span></label>
            <input asp-for="Notes" class="input" placeholder="For example, ate out" />
            <span asp-validation-for="Notes" class="error-text"></span>
        </div>
    </section>

    <section class="card flush">
        <div class="search-pad">
            <div class="between"><h2 class="h2">What you ate</h2><span class="small subtle">Pick a food and the servings</span></div>
            <div class="field">
                <label for="food-search" class="label">Find a food</label>
                <div class="input-wrap">
                    <span class="lead-icon">@Icons.Svg("search", 18)</span>
                    <input type="search" id="food-search" class="input" placeholder="Filter the lists below, for example yoghurt" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="food-head" aria-hidden="true"><span>Food</span><span>Servings</span><span class="r">kcal</span><span></span></div>
        <div data-item-list>
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var chosen = Model.FoodOptions.FirstOrDefault(f => f.FoodItemId == Model.Items[i].FoodItemId);
                <div class="food-row item-row">
                    <div class="food-what">
                        <span class="stat-icon" data-food-icon data-tone="@(chosen is null ? string.Empty : Tone(chosen.Category))">@Icons.Svg("apple", 18)</span>
                        <div class="field">
                            <select asp-for="Items[i].FoodItemId" class="select" aria-label="Food" data-food-select>
                                <option value="">Choose a food…</option>
                                @foreach (var group in Model.FoodOptions.GroupBy(o => o.Category))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var food in group)
                                        {
                                            <option value="@food.FoodItemId" data-kcal="@food.CaloriesPerServing.ToString(CultureInfo.InvariantCulture)" data-tone="@Tone(food.Category)">@food.Name — @food.Serving, @food.CaloriesPerServing.ToString("0") kcal</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span asp-validation-for="Items[i].FoodItemId" class="error-text"></span>
                        </div>
                    </div>
                    <div class="field food-qty">
                        <input asp-for="Items[i].Quantity" aria-label="Servings" type="number" min="0.25" max="20" step="0.25" class="input input-sm num" data-quantity />
                        <span asp-validation-for="Items[i].Quantity" class="error-text"></span>
                    </div>
                    <span class="num food-kcal" data-row-kcal>&ndash;</span>
                    <button type="button" class="icon-btn" data-remove-row aria-label="Remove this food">@Icons.Svg("x", 18)</button>
                </div>
            }
        </div>
        <div class="food-foot">
            <button type="button" class="btn btn-ghost pl-10" id="add-item">@Icons.Svg("plus", 18)Add a food</button>
            <span class="total-label">Total</span>
            <span class="total"><span class="kpi kpi-md num" data-meal-total>0</span><span class="muted small"> kcal</span></span>
        </div>
    </section>

    <div class="card save-bar">
        <div class="note-col">
            @if (Model.PlannedCalories is { } target)
            {
                <span class="small muted">Planned target for this meal: <span class="strong">@target.ToString("N0") kcal</span></span>
            }
            <span class="xs subtle">The total is an estimate while you type. Saved values are worked out from the food library.</span>
        </div>
        <div class="actions">
            <a class="btn btn-ghost" asp-action="MyPlan">Cancel</a>
            <button type="submit" class="btn btn-primary btn-lg">@Icons.Svg("check", 18)Save meal</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/meal-log.js" asp-append-version="true"></script>
}
