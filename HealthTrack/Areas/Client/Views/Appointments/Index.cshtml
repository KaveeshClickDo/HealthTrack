@model ClientAppointmentsViewModel
@{
    ViewData["Title"] = "Appointments";
    ViewData["Parent"] = "Coaching";
    var pager = new PagerViewModel(Model.Past.Page, Model.Past.TotalPages, Model.Past.TotalCount, new Dictionary<string, string?>());
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Appointments</h1>
        <p>Sessions with your trainer and other health professionals.</p>
    </div>
    <div class="actions"><a class="btn btn-primary" asp-action="Book">@Icons.Svg("plus", 18)Book an appointment</a></div>
</div>

<section class="card flush">
    <div class="card-head pad"><h2 class="h2">Upcoming</h2><span class="small subtle">You can cancel up to 2 hours before the start</span></div>
    @if (Model.Upcoming.Count == 0)
    {
        <div class="empty sm">
            <span class="icon">@Icons.Svg("calendar", 24)</span>
            <p>Nothing booked. Book a session with a trainer, nutritionist or other professional — only their free times are offered.</p>
            <a class="btn btn-secondary btn-sm" asp-action="Book">Book an appointment</a>
        </div>
    }
    else
    {
        <ul class="appt-rows">
            @foreach (var (appointment, index) in Model.Upcoming.Select((a, i) => (a, i)))
            {
                var where = appointment.Mode == AppointmentMode.Online
                    ? "Online"
                    : "In person · " + (appointment.Location ?? (appointment.Status == AppointmentStatus.Pending ? "room given when approved" : "place to be confirmed"));
                <li>
                    <span class="date-tile @(index == 0 ? "is-next" : string.Empty)">
                        <span class="xs dow">@appointment.StartDateTime.ToString("ddd")</span>
                        <span class="h2">@appointment.StartDateTime.Day</span>
                        <span class="xs subtle">@appointment.StartDateTime.ToString("MMM")</span>
                    </span>
                    <div class="appt-what">
                        <span class="strong title">@appointment.AppointmentType.GetDisplayName()</span>
                        <span class="small muted hrow wrap appt-meta">
                            <span>@appointment.StartDateTime.ToString("HH:mm") – @appointment.EndDateTime.ToString("HH:mm") · @appointment.DurationMinutes min</span>
                            <span class="hrow gp-6">@Icons.Svg(appointment.Mode == AppointmentMode.Online ? "video" : "map-pin", 16)@(appointment.Mode == AppointmentMode.Online ? "Online" : where)</span>
                        </span>
                    </div>
                    <div class="hrow appt-who">
                        <span class="avatar av-sm av-trainer">@appointment.TrainerName.Initials()</span>
                        <div><div class="small strong">@appointment.TrainerName</div><div class="xs subtle">@appointment.ProfessionalType.GetDisplayName()</div></div>
                    </div>
                    <span class="badge @StatusBadges.For(appointment.Status)"><span class="dot"></span>@appointment.Status.GetDisplayName()</span>
                    <div class="actions">
                        <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@appointment.AppointmentId">Open</a>
                        @if (appointment.CanCancel)
                        {
                            <form class="inline" asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post"
                                  data-confirm="Cancel your @appointment.AppointmentType.GetDisplayName().ToLowerInvariant() on @appointment.StartDateTime.ToString("dd MMM yyyy") at @appointment.StartDateTime.ToString("HH:mm")?">
                                <input type="hidden" name="RowVersion" value="@appointment.RowVersion" />
                                <button type="submit" class="btn btn-ghost btn-sm">Cancel</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>

<section class="card flush">
    <div class="card-head pad"><h2 class="h2">Past and closed</h2></div>
    @if (Model.Past.TotalCount == 0)
    {
        <p class="small muted card-pad-bottom">No past appointments yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">When</th><th scope="col">With</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Open</span></th></tr></thead>
                <tbody>
                    @foreach (var appointment in Model.Past.Items)
                    {
                        <tr>
                            <td class="nowrap">@appointment.StartDateTime.ToString("ddd d MMM yyyy")<span class="sub">@appointment.StartDateTime.ToString("HH:mm")</span></td>
                            <td>@appointment.TrainerName</td>
                            <td>@appointment.AppointmentType.GetDisplayName()</td>
                            <td><span class="badge @StatusBadges.For(appointment.Status)">@(appointment.Status == AppointmentStatus.CancelledByClient ? "Cancelled by you" : appointment.Status == AppointmentStatus.Rejected ? "Declined" : appointment.Status.GetDisplayName())</span></td>
                            <td class="r"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@appointment.AppointmentId">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    }
</section>
