@model PagedResult<FeedbackItemViewModel>
@{
    ViewData["Title"] = "Feedback";
    ViewData["Parent"] = "Coaching";
    ViewData["ContentClass"] = "narrow-md";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Feedback</h1>
        <p>Notes from your trainer on your training, eating and progress — newest first.</p>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("message", 24)</span>
        <p><span class="strong">No feedback yet.</span> Keep logging your workouts and meals; your trainer reviews them and leaves comments here.</p>
    </div>
}
else
{
    <ol class="feedback-list">
        @foreach (var feedback in Model.Items)
        {
            <li class="card">
                <span class="avatar av-trainer">@feedback.TrainerName.Initials()</span>
                <div class="body">
                    <div class="between wrap gp-8">
                        <div class="hrow wrap gap-10">
                            <span class="strong">@feedback.TrainerName</span>
                            <span class="badge @StatusBadges.For(feedback.Category)">@feedback.Category.GetDisplayName()</span>
                            <span class="xs subtle">@feedback.CreatedAt.ToString("dd MMM yyyy · HH:mm")</span>
                        </div>
                        @if (feedback.Rating is { } rating)
                        {
                            <partial name="_Stars" model="rating" />
                        }
                    </div>
                    <p class="feedback-text text-prewrap">@feedback.Message</p>
                    @if (feedback.WorkoutDate is { } date)
                    {
                        <a class="link-sm" asp-controller="Workouts" asp-action="History">@Icons.Svg("history", 16)About your workout on @date.ToString("dd MMM yyyy")</a>
                    }
                </div>
            </li>
        }
    </ol>
    <div class="page-pager"><partial name="_Pager" model="pager" /></div>
}
