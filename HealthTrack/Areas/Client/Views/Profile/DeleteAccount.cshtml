@model DeleteAccountViewModel
@{
    ViewData["Title"] = "Delete my account";
    ViewData["Parent"] = "Health profile";
    ViewData["ParentUrl"] = Url.Action("Edit");
    ViewData["ContentClass"] = "narrow-lg";
}

<a class="back" asp-action="Edit">@Icons.Svg("arrow-left", 16)Back to your health profile</a>
<div class="page-head">
    <div class="intro">
        <h1 class="h1">Delete your account</h1>
        <p>This can't be undone. Read what happens, then confirm with your password.</p>
    </div>
</div>

<div class="split">
    <section class="main card gp-24">
        <div class="vs gp-14">
            <h2 class="h3">What we delete</h2>
            <ul class="list del-list">
                <li class="hrow"><span class="ico-red">@Icons.Svg("x-circle", 18)</span><span>Your health profile, including your medical conditions, allergies and medications</span></li>
                <li class="hrow"><span class="ico-red">@Icons.Svg("x-circle", 18)</span><span>All your measurements, workout logs and meal logs</span></li>
                <li class="hrow"><span class="ico-red">@Icons.Svg("x-circle", 18)</span><span>Your workout and diet plans, and your trainer's feedback</span></li>
                <li class="hrow"><span class="ico-red">@Icons.Svg("x-circle", 18)</span><span>All your appointments, past and booked — your professional won't see them any more</span></li>
                <li class="hrow"><span class="ico-red">@Icons.Svg("x-circle", 18)</span><span>Your trainer assignment, notifications and notification settings</span></li>
            </ul>
        </div>
        <div class="divider"></div>
        <div class="vs gp-14">
            <h2 class="h3">What we keep, anonymised</h2>
            <ul class="list del-list">
                <li class="hrow"><span class="ico-muted">@Icons.Svg("shield-check", 18)</span><span><span class="strong">Your account record, renamed "Deleted user".</span> <span class="muted">Your name, email address, phone number, date of birth and password are removed, and it can never sign in again.</span></span></li>
                <li class="hrow"><span class="ico-muted">@Icons.Svg("shield-check", 18)</span><span><span class="strong">The security audit log</span> <span class="muted">(for example, when you signed in). We have to be able to show who did what — it never contains health values.</span></span></li>
            </ul>
        </div>
        <div class="alert alert-info">
            @Icons.Svg("download", 18)
            <span class="small"><span class="strong">Want a copy first?</span> <span class="muted"><a asp-action="Edit" asp-fragment="your-data">Download your data</a> before you delete your account. You'll be signed out straight away.</span></span>
        </div>
    </section>

    <div class="aside">
        <form asp-action="DeleteAccount" method="post" class="card danger-card"
              data-confirm="Delete your account and all your health records? This can't be undone.">
            <div class="hrow items-start gp-14">
                <span class="stat-icon danger">@Icons.Svg("alert-triangle", 18)</span>
                <div class="vs gp-4">
                    <h2 class="h3">Confirm with your password</h2>
                    <p class="small subtle">This deletes your account and all your health records.</p>
                </div>
            </div>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="field">
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" class="input" autocomplete="current-password" placeholder="Your current password" />
                <span asp-validation-for="Password" class="error-text"></span>
            </div>
            <button type="submit" class="btn btn-danger-solid btn-block">@Icons.Svg("trash", 18)Delete my account</button>
            <a class="btn btn-ghost btn-block" asp-action="Edit">Keep my account</a>
            <p class="xs subtle">We'll ask you once more before anything is deleted.</p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
