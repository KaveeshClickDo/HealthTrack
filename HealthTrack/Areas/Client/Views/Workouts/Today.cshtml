@model LogWorkoutViewModel
@{
    ViewData["Title"] = "Today's workout";
    ViewData["Parent"] = "Training";
}

<div class="page-head">
    <div class="intro">
        <span class="eyebrow">@Model.WorkoutDate?.ToString("dddd d MMMM")@(Model.PlanTitle is null ? string.Empty : " · " + Model.PlanTitle)</span>
        <h1 class="h1">Today's workout</h1>
        <p>Tick off what you did and change the numbers to match. Calories are worked out for you.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="MyPlan">See my week</a>
    </div>
</div>

@if (!Model.HasActivePlan)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("clipboard", 24)</span>
        <p><span class="strong">No workout plan for today.</span> Your trainer sets your plan; until then you can log any workout.</p>
        <div class="actions">
            <a class="btn btn-primary" asp-action="Log">Log a free workout</a>
            <a class="btn btn-secondary" asp-action="MyPlan">See your plan</a>
        </div>
    </div>
}
else if (Model.Entries.Count == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("clock", 24)</span>
        <p><span class="strong">Today is a rest day in your plan.</span> Enjoy it — or log a free workout if you trained anyway.</p>
        <a class="btn btn-secondary" asp-action="Log">Log a free workout</a>
    </div>
}
else
{
    @if (Model.AlreadyLoggedToday)
    {
        <div class="alert alert-info">@Icons.Svg("info", 18)<span>You have already logged a session today. Saving again adds another session.</span></div>
    }
    <partial name="_LogWorkoutForm" model="Model" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workout-log.js" asp-append-version="true"></script>
}
