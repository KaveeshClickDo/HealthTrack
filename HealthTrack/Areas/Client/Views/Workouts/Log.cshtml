@model LogWorkoutViewModel
@{
    ViewData["Title"] = "Log a workout";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Log a workout</h1>
        <p class="text-muted mb-0">Record a session that isn't in your plan. Add a row for each exercise.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Today">Today's planned workout</a>
</div>

<partial name="_LogWorkoutForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workout-log.js" asp-append-version="true"></script>
}
