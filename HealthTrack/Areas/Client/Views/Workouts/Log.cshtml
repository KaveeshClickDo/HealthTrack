@model LogWorkoutViewModel
@{
    ViewData["Title"] = "Log a workout";
    ViewData["Parent"] = "Training";
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Log a workout</h1>
        <p>Record a session that isn't in your plan — a run, a class, a game. Add a row for each exercise.</p>
    </div>
    <div class="actions"><a class="btn btn-secondary" asp-action="Today">Today's planned workout</a></div>
</div>

<partial name="_LogWorkoutForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workout-log.js" asp-append-version="true"></script>
}
