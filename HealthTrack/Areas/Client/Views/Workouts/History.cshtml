@model PagedResult<WorkoutHistoryItemViewModel>
@{
    ViewData["Title"] = "Workout history";
    ViewData["Parent"] = "Training";
    ViewData["ContentClass"] = "narrow";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Workout history</h1>
        <p>Every session you've logged, newest first — with your trainer's feedback.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-action="Log">Log a free workout</a>
        <a class="btn btn-primary" asp-action="Today">Today's workout</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("history", 24)</span>
        <p><span class="strong">No workouts logged yet.</span> Start with today's workout or log a free one.</p>
        <div class="actions">
            <a class="btn btn-primary" asp-action="Today">Today's workout</a>
            <a class="btn btn-secondary" asp-action="Log">Log a free workout</a>
        </div>
    </div>
}
else
{
    @foreach (var session in Model.Items)
    {
        <article class="card session">
            <div class="between wrap session-head">
                <div><h2 class="h2">@session.WorkoutDate.ToString("dddd d MMMM")</h2><span class="small subtle">@(session.PlanTitle ?? "Free workout") · @session.WorkoutDate.ToString("yyyy")</span></div>
                <div class="hrow wrap gp-8">
                    <span class="badge">@Icons.Svg("clock", 14)@session.TotalMinutes min</span>
                    <span class="badge b-orange">@Icons.Svg("flame", 14)@session.TotalCalories.ToString("0") kcal</span>
                    @if (session.PerceivedEffort is { } effort)
                    {
                        <span class="badge">Effort @effort/10</span>
                    }
                </div>
            </div>
            <div class="table-wrap boxed">
                <table class="table compact">
                    <thead><tr><th scope="col">Exercise</th><th scope="col">Done</th><th scope="col" class="r">kcal</th></tr></thead>
                    <tbody>
                        @foreach (var entry in session.Entries)
                        {
                            var done = WorkoutText.Prescription(entry.SetsCompleted, entry.RepsCompleted, entry.DurationMinutes)
                                + (entry.WeightKg is { } load ? $" · {load:0.#} kg" : string.Empty)
                                + (entry.DistanceKm is { } distance ? $" · {distance:0.##} km" : string.Empty);
                            <tr>
                                <th scope="row"><span class="cell-person"><img class="thumb thumb-sm" src="@ExercisePhotos.For(entry.ExerciseName)" alt="" />@entry.ExerciseName</span></th>
                                <td class="muted">@done.TrimStart(' ', '·')</td>
                                <td class="r num">@entry.CaloriesBurned.ToString("0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!string.IsNullOrEmpty(session.Notes))
            {
                <p class="small muted"><span class="subtle">Your notes:</span> @session.Notes</p>
            }
            @foreach (var feedback in session.Feedback)
            {
                <div class="feedback-note">
                    <span class="avatar av-sm av-trainer">@feedback.TrainerName.Initials()</span>
                    <div class="body">
                        <div class="hrow wrap gap-10">
                            <span class="small strong">Feedback from @feedback.TrainerName</span>
                            <span class="xs subtle">@feedback.CreatedAt.ToString("dd MMM yyyy")</span>
                            @if (feedback.Rating is { } rating)
                            {
                                <partial name="_Stars" model="rating" />
                            }
                        </div>
                        <p class="text-prewrap">@feedback.Message</p>
                    </div>
                </div>
            }
        </article>
    }

    <div class="page-pager"><partial name="_Pager" model="pager" /></div>
}
