@model WorkoutWeekViewModel
@{
    ViewData["Title"] = "My workout plan";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">My workout plan</h1>
        @if (Model.HasPlan)
        {
            <p class="text-muted mb-0">
                <strong>@Model.Title</strong> &middot; @Model.Difficulty.GetDisplayName() &middot; from @Model.TrainerName
                &middot; @Model.StartDate?.ToString("dd MMM yyyy")@(Model.EndDate is { } end ? " to " + end.ToString("dd MMM yyyy") : string.Empty)
            </p>
        }
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Today">Today's workout</a>
        <a class="btn btn-outline-primary" asp-action="Log">Log a free workout</a>
    </div>
</div>

@if (!Model.HasPlan)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            You don't have an active workout plan yet. Your trainer sets one up for you; until then you can
            <a asp-action="Log">log a free workout</a>.
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="mb-3">@Model.Description</p>
    }
    <partial name="_PlanDays" model="Model.Days" />
}
