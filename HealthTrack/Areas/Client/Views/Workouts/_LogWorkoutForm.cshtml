@model LogWorkoutViewModel
@* The workout log form, shared by today's workout and a free workout. wwwroot/js/workout-log.js adds and removes rows
   and swaps the photo when an exercise is chosen. A planned row shows the exercise's name and keeps its dropdown out of
   sight; a row added by hand shows the dropdown. *@
@{
    var planned = Model.Entries.Any(e => !string.IsNullOrEmpty(e.Target));
    var ticked = Model.Entries.Count(e => e.Include);
}
<form asp-area="Client" asp-controller="Workouts" asp-action="Log" method="post" id="workout-log-form" class="form-stack">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="WorkoutPlanId" type="hidden" />
    <input asp-for="PlanTitle" type="hidden" />

    <section class="card form-stack">
        <div class="field-row">
            <div class="field f-date">
                <label asp-for="WorkoutDate" class="label"></label>
                <input asp-for="WorkoutDate" class="input" />
                <span asp-validation-for="WorkoutDate" class="error-text"></span>
            </div>
            <div class="field f-3">
                <label asp-for="Notes" class="label">Notes <span class="opt">Optional</span></label>
                <input asp-for="Notes" class="input" placeholder="How did it feel?" />
                <span asp-validation-for="Notes" class="error-text"></span>
            </div>
        </div>
        <fieldset class="field">
            <legend class="label legend-gap">How hard did it feel? <span class="opt">Optional · 1 is very easy, 10 is your maximum</span></legend>
            <div class="pill-grid tight">
                @for (var effort = 1; effort <= 10; effort++)
                {
                    <span class="pill num">
                        <input type="radio" asp-for="PerceivedEffort" value="@effort" id="effort-@effort" />
                        <label for="effort-@effort">@effort</label>
                    </span>
                }
            </div>
            <span asp-validation-for="PerceivedEffort" class="error-text"></span>
        </fieldset>
    </section>

    <section class="card flush">
        <div class="card-head pad">
            <h2 class="h2">Exercises</h2>
            <span class="small subtle">
                @if (planned)
                {
                    @($"{Model.Entries.Count} planned · {ticked} ticked")
                }
                else
                {
                    @("A row for each exercise")
                }
            </span>
        </div>
        <div data-entry-list>
            @for (var i = 0; i < Model.Entries.Count; i++)
            {
                var entry = Model.Entries[i];
                var isPlanned = !string.IsNullOrEmpty(entry.Target);
                var option = Model.ExerciseOptions.FirstOrDefault(o => o.Id == entry.ExerciseId);
                var photo = option is null ? null : ExercisePhotos.ForOption(option.Label, option.Group);
                <div class="entry-row @(planned ? string.Empty : "free")">
                    <div class="entry-what">
                        @if (planned)
                        {
                            @* A plain checkbox: the tag helper's hidden "false" inputs sit at the end of the form and
                               would break when workout-log.js re-numbers the rows. *@
                            <input type="checkbox" class="check-lg" name="Entries[@i].Include" value="true"
                                   checked="@entry.Include" aria-label="Done" />
                        }
                        else
                        {
                            <input type="hidden" name="Entries[@i].Include" value="true" />
                        }
                        <img class="thumb @(planned ? "thumb-lg" : string.Empty)" data-thumb src="@photo" alt="" />
                        <div class="entry-name">
                            @if (isPlanned)
                            {
                                <label class="strong" asp-for="Entries[i].ExerciseId" data-planned>@option?.Label</label>
                            }
                            <label class="xs subtle" asp-for="Entries[i].ExerciseId" data-free-label hidden="@isPlanned">Exercise</label>
                            <select asp-for="Entries[i].ExerciseId" class="select select-sm @(isPlanned ? "visually-hidden" : string.Empty)" data-exercise-select>
                                <option value="">Choose an exercise…</option>
                                @foreach (var group in Model.ExerciseOptions.GroupBy(o => o.Group))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var exercise in group)
                                        {
                                            <option value="@exercise.Id" data-photo="@ExercisePhotos.ForOption(exercise.Label, exercise.Group)">@exercise.Label</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <input asp-for="Entries[i].Target" type="hidden" />
                            @if (isPlanned)
                            {
                                <span class="small subtle" data-planned>Planned: @entry.Target</span>
                            }
                            <span asp-validation-for="Entries[i].ExerciseId" class="error-text"></span>
                        </div>
                    </div>
                    <div class="entry-fields">
                        <div class="field">
                            <label asp-for="Entries[i].DurationMinutes" class="xs subtle">Minutes</label>
                            <input asp-for="Entries[i].DurationMinutes" type="number" min="1" max="300" class="input input-sm" placeholder="–" />
                            <span asp-validation-for="Entries[i].DurationMinutes" class="error-text"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Entries[i].Sets" class="xs subtle">Sets</label>
                            <input asp-for="Entries[i].Sets" type="number" min="1" max="20" class="input input-sm" placeholder="–" />
                            <span asp-validation-for="Entries[i].Sets" class="error-text"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Entries[i].Reps" class="xs subtle">Reps</label>
                            <input asp-for="Entries[i].Reps" type="number" min="1" max="100" class="input input-sm" placeholder="–" />
                            <span asp-validation-for="Entries[i].Reps" class="error-text"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Entries[i].LoadKg" class="xs subtle">Load (kg)</label>
                            <input asp-for="Entries[i].LoadKg" type="number" min="0" max="500" step="0.5" class="input input-sm" placeholder="–" />
                            <span asp-validation-for="Entries[i].LoadKg" class="error-text"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Entries[i].DistanceKm" class="xs subtle">Distance (km)</label>
                            <input asp-for="Entries[i].DistanceKm" type="number" min="0" max="100" step="0.1" class="input input-sm" placeholder="–" />
                            <span asp-validation-for="Entries[i].DistanceKm" class="error-text"></span>
                        </div>
                    </div>
                    <button type="button" class="icon-btn" data-remove-row aria-label="Remove this row">@Icons.Svg("x", 18)</button>
                </div>
            }
        </div>
        <div class="card-foot-bar">
            <button type="button" class="btn btn-ghost pl-10" id="add-entry">@Icons.Svg("plus", 18)Add another exercise</button>
        </div>
    </section>

    <div class="card save-bar">
        <div class="hrow note">
            <span class="stat-icon i-orange">@Icons.Svg("flame", 18)</span>
            <p class="small muted">Calories are worked out from each exercise's MET value, your minutes and your latest weight.</p>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">@Icons.Svg("check", 18)Save workout</button>
    </div>
</form>
