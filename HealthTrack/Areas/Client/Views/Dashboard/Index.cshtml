@model ClientDashboardViewModel
@inject IClock Clock
@{
    ViewData["Title"] = "Dashboard";
    var now = Clock.Now;
    var change = Model.WeightChangeKg;
    var workout = Model.TodaysWorkout;

    // Progress from the first weigh-in towards the target weight, for the bar under the latest weight.
    int? towardsTarget = null;
    if (Model.LatestWeightKg is { } latestKg && change is { } changed && Model.TargetWeightKg is { } targetKg)
    {
        var first = latestKg - changed;
        if (first != targetKg)
        {
            towardsTarget = (int)Math.Clamp(Math.Round((first - latestKg) * 100m / (first - targetKg)), 0, 100);
        }
    }

    // A change is good news when it moves towards the target (or down, without one).
    var goodChange = change is { } c && c != 0
        && (Model.TargetWeightKg is { } t && Model.LatestWeightKg is { } l ? (c < 0) == (t < l - c) : c < 0);
}

<div class="page-head">
    <div class="intro">
        <span class="eyebrow">@now.ToString("dddd d MMMM")</span>
        <h1 class="h1 page-title">Welcome back, @Model.FirstName</h1>
        <p>
            Here's your day at a glance.
            @if (Model.TrainerName is { } trainer)
            {
                <text>Your trainer is <span class="strong">@trainer</span>.</text>
            }
            else
            {
                <text>An administrator will match you with a trainer soon.</text>
            }
        </p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-controller="Measurements" asp-action="Create">@Icons.Svg("plus", 18)Add a measurement</a>
        @if (workout.HasPlan && !workout.IsRestDay && !workout.LoggedToday)
        {
            <a class="btn btn-primary" asp-controller="Workouts" asp-action="Today">@Icons.Svg("play", 18)Start today's workout</a>
        }
    </div>
</div>

<div class="grid g-4">
    <div class="card stat">
        <span class="stat-label"><span class="stat-icon">@Icons.Svg("weight", 18)</span>Latest weight</span>
        @if (Model.LatestWeightKg is { } weight)
        {
            <span class="kpi">@weight.ToString("0.0")<small>kg</small></span>
            @if (towardsTarget is { } progress)
            {
                <div class="bar" role="progressbar" aria-label="Progress towards your target weight" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><i data-progress-width="@progress"></i></div>
            }
            <span class="stat-meta">
                @Model.LatestMeasuredAt?.ToString("d MMM")@if (Model.TargetWeightKg is { } goal)
                {
                    <text> · @Math.Abs(weight - goal).ToString("0.0") kg to your @goal.ToString("0.0") kg target</text>
                }
            </span>
        }
        else
        {
            <span class="kpi">–</span>
            <a class="link-sm" asp-controller="Measurements" asp-action="Create">Record your first measurement @Icons.Svg("chevron-right", 14)</a>
        }
    </div>
    <div class="card stat">
        <span class="stat-label"><span class="stat-icon">@Icons.Svg("target", 18)</span>BMI</span>
        @if (Model.LatestBmi is { } bmi)
        {
            <div class="hrow gap-10">
                <span class="kpi">@bmi.ToString("0.0")</span>
                @if (Model.BmiCategory is { } category)
                {
                    <span class="badge @StatusBadges.For(category)">@category.GetDisplayName()</span>
                }
            </div>
        }
        else
        {
            <span class="kpi">–</span>
        }
        <span class="stat-meta">Healthy range is 18.5 to 24.9</span>
    </div>
    <div class="card stat">
        <span class="stat-label"><span class="stat-icon @(goodChange ? "i-green" : string.Empty)">@Icons.Svg(change > 0 ? "trending-up" : "trending-down", 18)</span>Since your first weigh-in</span>
        @if (change is { } kg)
        {
            <span class="kpi @(goodChange ? "c-green" : string.Empty)">@(kg > 0 ? "+" : kg < 0 ? "−" : string.Empty)@Math.Abs(kg).ToString("0.0")<small>kg</small></span>
            <span class="stat-meta">Since @Model.FirstMeasuredAt?.ToString("dd MMM yyyy")</span>
        }
        else
        {
            <span class="kpi">–</span>
            <span class="stat-meta">Shows after your second weigh-in.</span>
        }
    </div>
    <div class="card stat">
        <span class="stat-label"><span class="stat-icon i-orange">@Icons.Svg("flame", 18)</span>Burned this week</span>
        <span class="kpi">@Model.CaloriesBurnedThisWeek.ToString("N0")<small>kcal</small></span>
        <span class="stat-meta">@Model.WorkoutsThisWeek @(Model.WorkoutsThisWeek == 1 ? "workout" : "workouts") since Monday</span>
    </div>
</div>

<div class="split">
    <section class="main card gp-20">
        <div class="card-head">
            <div class="vs gp-4">
                <h2 class="h2">Today's workout</h2>
                @if (workout.HasPlan)
                {
                    <span class="small subtle">@workout.PlanTitle · @now.ToString("dddd")</span>
                }
            </div>
            <a class="link-sm" asp-controller="Workouts" asp-action="MyPlan">My plan @Icons.Svg("chevron-right", 14)</a>
        </div>

        @if (!workout.HasPlan)
        {
            <div class="empty sm">
                <p>You have no active workout plan yet. Your trainer will set one up; meanwhile you can log any workout.</p>
                <a class="btn btn-secondary" asp-controller="Workouts" asp-action="Log">Log a workout</a>
            </div>
        }
        else if (workout.IsRestDay)
        {
            <div class="empty sm">
                <p><span class="strong">Rest day.</span> Recovery is part of the plan. Fancy a walk anyway?</p>
                <a class="btn btn-secondary" asp-controller="Workouts" asp-action="Log">Log a workout</a>
            </div>
        }
        else
        {
            <div class="tile-grid">
                @foreach (var (exercise, index) in workout.Items.Select((e, i) => (e, i)))
                {
                    <div class="frame tile-210">
                        <img class="photo photo-fill" src="@ExercisePhotos.For(exercise.Name, exercise.Category)" alt="" />
                        <div class="shade"></div>
                        <div class="tile-caption">
                            <span class="xs tile-kicker">@(index + 1) · @exercise.Category.GetDisplayName()</span>
                            <span class="h3">@exercise.Name</span>
                            <span class="small muted">@exercise.Prescription</span>
                        </div>
                    </div>
                }
            </div>
            <div class="between wrap">
                @if (workout.LoggedToday)
                {
                    <span class="badge b-green">@Icons.Svg("check", 14)Done today</span>
                }
                else
                {
                    <span class="small subtle">Not logged yet today</span>
                }
                <div class="actions">
                    <a class="btn btn-ghost" asp-controller="Workouts" asp-action="Log">Log something else</a>
                    @if (workout.LoggedToday)
                    {
                        <a class="btn btn-secondary" asp-controller="Workouts" asp-action="History">See your history</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Workouts" asp-action="Today">Start workout</a>
                    }
                </div>
            </div>
        }
    </section>

    <section class="aside card dash-meals">
        <div class="card-head">
            <h2 class="h2">Today's meals</h2>
            <a class="link-sm" asp-controller="Diet" asp-action="MyPlan">Diet plan @Icons.Svg("chevron-right", 14)</a>
        </div>
        <partial name="_NutritionBars" model="Model.Nutrition" />
        @if (Model.TodaysMeals.Count == 0)
        {
            <div class="empty sm">
                <p class="small">No meals are planned for today. You can still log what you eat.</p>
                <a class="btn btn-secondary btn-sm" asp-controller="Diet" asp-action="LogMeal">Log a meal</a>
            </div>
        }
        else
        {
            <ul class="list">
                @foreach (var meal in Model.TodaysMeals)
                {
                    <li class="between">
                        <div class="meal-line">
                            <div class="small"><span class="subtle num">@meal.ScheduledTime.ToString("hh\\:mm")</span> <span class="strong">@meal.MealType.GetDisplayName()</span></div>
                            <div class="xs subtle">@meal.MealDescription · @meal.TargetCalories kcal</div>
                        </div>
                        @if (meal.IsLogged)
                        {
                            <span class="badge b-green">@Icons.Svg("check", 14)@meal.LoggedCalories?.ToString("N0") kcal</span>
                        }
                        else
                        {
                            <a class="btn btn-secondary btn-sm" asp-controller="Diet" asp-action="LogMeal" asp-route-dietPlanMealId="@meal.DietPlanMealId">Log</a>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

<div class="grid g-3">
    <section class="card vs gp-16">
        <div class="card-head"><h2 class="h3">Next appointments</h2><a class="link-sm" asp-controller="Appointments" asp-action="Index">All</a></div>
        @if (Model.UpcomingAppointments.Count == 0)
        {
            <div class="empty sm">
                <p class="small">Nothing booked. Book a session with your trainer when you need one.</p>
                <a class="btn btn-secondary btn-sm" asp-controller="Appointments" asp-action="Book">Book an appointment</a>
            </div>
        }
        else
        {
            <ul class="list">
                @foreach (var appointment in Model.UpcomingAppointments)
                {
                    <li class="hrow items-start">
                        <span class="appt-day"><span class="xs subtle">@appointment.StartDateTime.ToString("ddd")</span><span class="strong">@appointment.StartDateTime.Day</span></span>
                        <a class="row-link" asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.AppointmentId">
                            <span class="small strong">@appointment.StartDateTime.ToString("HH:mm") · @appointment.AppointmentType.GetDisplayName()</span>
                            <span class="xs subtle">With @appointment.TrainerName · @appointment.Mode.GetDisplayName()</span>
                        </a>
                        <span class="badge @StatusBadges.For(appointment.Status)">@appointment.Status.GetDisplayName()</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card vs gp-16">
        <div class="card-head"><h2 class="h3">Latest feedback</h2><a class="link-sm" asp-controller="Feedback" asp-action="Index">All</a></div>
        @if (Model.LatestFeedback is { } feedback)
        {
            <div class="hrow">
                <span class="avatar av-trainer">@feedback.TrainerName.Initials()</span>
                <div class="grow"><div class="small strong">@feedback.TrainerName</div><div class="xs subtle">@feedback.Category.GetDisplayName() · @feedback.CreatedAt.ToString("dd MMM yyyy")</div></div>
                @if (feedback.Rating is { } rating)
                {
                    <partial name="_Stars" model="rating" />
                }
            </div>
            <blockquote class="quote-lg text-prewrap">“@feedback.Message”</blockquote>
            @if (feedback.WorkoutDate is { } workoutDate)
            {
                <a class="link-sm mt-auto-btn" asp-controller="Workouts" asp-action="History">About your workout on @workoutDate.ToString("d MMM")</a>
            }
        }
        else
        {
            <p class="small muted">No feedback yet. Your trainer's comments on your workouts and progress appear here.</p>
        }
    </section>

    <section class="card vs gp-16">
        <div class="card-head">
            <div class="hrow gp-8"><h2 class="h3">Notifications</h2>@if (Model.UnreadCount > 0) {<span class="badge b-rose">@Model.UnreadCount new</span>}</div>
            <a class="link-sm" asp-area="" asp-controller="Notifications" asp-action="Index">All</a>
        </div>
        @if (Model.UnreadNotifications.Count == 0)
        {
            <p class="small muted">You're all caught up.</p>
        }
        else
        {
            <ul class="list">
                @foreach (var notification in Model.UnreadNotifications)
                {
                    <li class="hrow items-start">
                        <span class="unread-dot" aria-hidden="true"></span>
                        @if (notification.LinkUrl is { } link)
                        {
                            <a class="row-link" href="@link"><span class="small strong">@notification.Title</span><span class="xs subtle">@DateLabels.DayAndTime(notification.CreatedAt, now)</span></a>
                        }
                        else
                        {
                            <div class="row-link"><span class="small strong">@notification.Title</span><span class="xs subtle">@DateLabels.DayAndTime(notification.CreatedAt, now)</span></div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>
