@model AccountSummaryViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h2 mb-1">Welcome, @Model.FullName</h1>
<p class="text-muted mb-4">Your health at a glance.</p>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Getting started</h2>
        <p class="text-muted mb-3">
            This page will show your latest weight and BMI, today's workout and meals, your next appointments and your
            trainer's feedback. For now you can keep your account details up to date.
        </p>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Manage" asp-action="Index">Manage account</a>
    </div>
</div>
