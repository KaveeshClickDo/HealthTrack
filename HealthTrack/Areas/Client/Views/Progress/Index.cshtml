@model ClientProgressViewModel
@{
    ViewData["Title"] = "Progress";
    ViewData["Parent"] = "Health";
    ViewData["LiveRange"] = true;
    var charts = new ProgressChartsViewModel
    {
        WeightDataUrl = Url.Action("WeightData", "Progress", new { area = "Client" }),
        CaloriesDataUrl = Url.Action("CaloriesData", "Progress", new { area = "Client" }),
        VitalsDataUrl = Url.Action("VitalsData", "Progress", new { area = "Client" })
    };
    var change = Model.Latest is { } latest && Model.First is { } first && first.MeasurementId != latest.MeasurementId
        ? latest.WeightKg - first.WeightKg
        : (decimal?)null;
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Progress</h1>
        <p>Your weight, BMI, calories and vital signs over time.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-controller="Measurements" asp-action="Index">Measurements</a>
        <a class="btn btn-primary" asp-controller="Measurements" asp-action="Create">@Icons.Svg("plus", 18)Add a measurement</a>
    </div>
</div>

@if (Model.Latest is null)
{
    <div class="alert alert-info">@Icons.Svg("info", 18)<span>You haven't recorded a measurement yet. <a asp-controller="Measurements" asp-action="Create">Add your weight and height</a> to start your weight and BMI charts; workouts and meals you log appear in the calories charts.</span></div>
}
else
{
    <div class="grid g-4">
        <div class="card stat">
            <span class="stat-label">Latest weight</span>
            <span class="kpi">@Model.Latest.WeightKg.ToString("0.0")<small>kg</small></span>
            <span class="stat-meta">@Model.Latest.MeasuredAt.ToString("dd MMM yyyy")</span>
        </div>
        <div class="card stat">
            <span class="stat-label">BMI</span>
            <div class="hrow gap-10"><span class="kpi">@Model.Latest.Bmi.ToString("0.0")</span><span class="badge @StatusBadges.For(Model.Latest.BmiCategory)">@Model.Latest.BmiCategory.GetDisplayName()</span></div>
            <span class="stat-meta">Healthy range 18.5–24.9</span>
        </div>
        <div class="card stat">
            <span class="stat-label">Since your first weigh-in</span>
            <span class="kpi @(change < 0 ? "c-green" : string.Empty)">@(change is { } kg ? (kg > 0 ? "+" : kg < 0 ? "−" : string.Empty) + Math.Abs(kg).ToString("0.0") : "–")<small>kg</small></span>
            <span class="stat-meta">@(Model.First is { } start ? "Since " + start.MeasuredAt.ToString("dd MMM yyyy") : string.Empty)</span>
        </div>
        <div class="card stat">
            <span class="stat-label">Target weight</span>
            @if (Model.TargetWeightKg is { } target)
            {
                var gap = Model.Latest.WeightKg - target;
                <span class="kpi">@target.ToString("0.0")<small>kg</small></span>
                <span class="stat-meta">@(gap == 0 ? "Reached" : Math.Abs(gap).ToString("0.0") + " kg to " + (gap > 0 ? "lose" : "gain"))</span>
            }
            else
            {
                <span class="kpi">–</span>
                <a class="link-sm" asp-controller="Profile" asp-action="Edit">Set a target</a>
            }
        </div>
    </div>
}

<partial name="_ProgressRange" model="Model.Range" />
<partial name="_ProgressCharts" model="charts" />

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/progress-charts.js" asp-append-version="true"></script>
}
