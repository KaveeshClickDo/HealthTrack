@model MeasurementsPageViewModel
@{
    ViewData["Title"] = "Measurements";
    ViewData["Parent"] = "Health";
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount, new Dictionary<string, string?>());

    // The BMI scale runs from 15 to 35: under 18.5, healthy to 24.9, overweight to 29.9, obese from 30.
    static string ScalePosition(decimal bmi) => Math.Clamp(Math.Round((bmi - 15m) * 5m), 0m, 100m).ToString("0");
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Measurements</h1>
        <p>Your weigh-ins and vital signs. BMI is worked out for you, and your workout calories use your latest weight.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" asp-controller="Progress" asp-action="Index">@Icons.Svg("trending-up", 18)Progress charts</a>
        <a class="btn btn-primary" asp-action="Create">@Icons.Svg("plus", 18)Add a measurement</a>
    </div>
</div>

@if (Model.Latest is null)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("ruler", 24)</span>
        <p><span class="strong">No measurements yet.</span> Add your weight and height: your BMI is worked out for you, and your workout calories use your latest weight.</p>
        <a class="btn btn-primary" asp-action="Create">Add a measurement</a>
    </div>
}
else
{
    var latest = Model.Latest;
    <section class="card bmi-card">
        <div class="bmi-main">
            <div class="hrow gap-10"><span class="eyebrow">Latest BMI</span><span class="xs subtle">@latest.MeasuredAt.ToString("dd MMM yyyy · HH:mm")</span></div>
            <div class="hrow gap-10"><span class="kpi kpi-xl">@latest.Bmi.ToString("0.0")</span><span class="badge @StatusBadges.For(latest.BmiCategory)">@latest.BmiCategory.GetDisplayName()</span></div>
            <figure class="bmi-scale" aria-label="BMI @latest.Bmi.ToString("0.0") on a scale from underweight to obese">
                <div class="bmi-bands">
                    <span class="under"></span><span class="healthy"></span><span class="over"></span><span class="obese"></span>
                    <span class="bmi-marker" data-progress-left="@ScalePosition(latest.Bmi)"></span>
                </div>
                <div class="bmi-labels xs subtle"><span>Under</span><span>Healthy 18.5–24.9</span><span>Over 25</span><span>Obese 30+</span></div>
            </figure>
        </div>
        <dl class="figures">
            <div><dt class="small subtle">Weight</dt><dd class="h2">@latest.WeightKg.ToString("0.0") kg</dd></div>
            <div><dt class="small subtle">Height</dt><dd class="h2">@latest.HeightCm.ToString("0.#") cm</dd></div>
            @if (Model.First is { } first && first.MeasurementId != latest.MeasurementId)
            {
                var change = latest.WeightKg - first.WeightKg;
                var towardsTarget = Model.TargetWeightKg is { } goal ? (change < 0) == (goal < first.WeightKg) : change < 0;
                <div><dt class="small subtle">Since @first.MeasuredAt.ToString("d MMM")</dt><dd class="h2 @(change != 0 && towardsTarget ? "c-green" : string.Empty)">@(change > 0 ? "+" : change < 0 ? "−" : string.Empty)@Math.Abs(change).ToString("0.0") kg</dd></div>
            }
            @if (Model.TargetWeightKg is { } target)
            {
                <div><dt class="small subtle">Target</dt><dd class="h2">@target.ToString("0.0") kg</dd></div>
            }
        </dl>
    </section>

    <section class="card flush">
        <div class="card-head pad"><h2 class="h2">All measurements</h2><span class="small subtle">BMI = weight ÷ height²</span></div>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Measured</th>
                        <th scope="col" class="r">Weight (kg)</th>
                        <th scope="col">BMI</th>
                        <th scope="col" class="r">Body fat (%)</th>
                        <th scope="col" class="r">Waist (cm)</th>
                        <th scope="col" class="r">Heart rate</th>
                        <th scope="col" class="r">Blood pressure</th>
                        <th scope="col" class="r">Glucose</th>
                        <th scope="col">Notes</th>
                    </tr>
                </thead>
                <tbody class="num">
                    @foreach (var row in Model.Results.Items)
                    {
                        <tr>
                            <td class="nowrap">@row.MeasuredAt.ToString("dd MMM yyyy") <span class="sub">@row.MeasuredAt.ToString("HH:mm")</span></td>
                            <td class="r strong">@row.WeightKg.ToString("0.0")</td>
                            <td class="nowrap">@row.Bmi.ToString("0.0") <span class="badge ml-6 @StatusBadges.For(row.BmiCategory)">@row.BmiCategory.GetDisplayName()</span></td>
                            <td class="r">@(row.BodyFatPercent?.ToString("0.0") ?? "–")</td>
                            <td class="r">@(row.WaistCm?.ToString("0.0") ?? "–")</td>
                            <td class="r nowrap">@(row.RestingHeartRate is { } bpm ? bpm + " bpm" : "–")</td>
                            <td class="r">@(row.SystolicBp is { } sys && row.DiastolicBp is { } dia ? sys + "/" + dia : row.SystolicBp?.ToString() ?? "–")</td>
                            <td class="r subtle">@(row.BloodGlucose?.ToString("0.0") ?? "–")</td>
                            <td class="small muted">@(string.IsNullOrWhiteSpace(row.Notes) ? "–" : row.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    </section>
}
