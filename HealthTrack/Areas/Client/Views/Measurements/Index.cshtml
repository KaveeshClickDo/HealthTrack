@model MeasurementsPageViewModel
@{
    ViewData["Title"] = "Measurements";
    var pager = new PagerViewModel(Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalCount, new Dictionary<string, string?>());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Measurements</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Progress" asp-action="Index">Progress charts</a>
        <a class="btn btn-primary" asp-action="Create">Add a measurement</a>
    </div>
</div>

@if (Model.Latest is null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            No measurements yet. <a asp-action="Create">Add your weight and height</a>: your BMI is worked out for you,
            and your trainer's calorie suggestion and workout calories use your latest weight.
        </div>
    </div>
}
else
{
    var latest = Model.Latest;
    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <div>
                <div class="small text-muted">Latest BMI</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-3 fw-semibold">@latest.Bmi.ToString("0.0")</span>
                    <span class="badge @StatusBadges.For(latest.BmiCategory)">@latest.BmiCategory.GetDisplayName()</span>
                </div>
            </div>
            <div>
                <div class="small text-muted">Weight</div>
                <div class="fs-5">@latest.WeightKg.ToString("0.0") kg</div>
            </div>
            <div>
                <div class="small text-muted">Height</div>
                <div class="fs-5">@latest.HeightCm.ToString("0.#") cm</div>
            </div>
            @if (Model.First is { } first && first.MeasurementId != latest.MeasurementId)
            {
                var change = latest.WeightKg - first.WeightKg;
                <div>
                    <div class="small text-muted">Since @first.MeasuredAt.ToString("dd MMM yyyy")</div>
                    <div class="fs-5">@((change > 0 ? "+" : string.Empty) + change.ToString("0.0")) kg</div>
                </div>
            }
            @if (Model.TargetWeightKg is { } target)
            {
                <div>
                    <div class="small text-muted">Target</div>
                    <div class="fs-5">@target.ToString("0.0") kg</div>
                </div>
            }
            <div class="small text-muted ms-lg-auto">
                Measured @latest.MeasuredAt.ToString("dd MMM yyyy HH:mm").<br />
                BMI = weight &divide; height&sup2;; under 18.5 underweight, 25 overweight, 30 obese.
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Measured</th>
                        <th scope="col" class="text-end">Weight (kg)</th>
                        <th scope="col" class="text-end">BMI</th>
                        <th scope="col" class="text-end">Body fat (%)</th>
                        <th scope="col" class="text-end">Waist (cm)</th>
                        <th scope="col" class="text-end">Heart rate</th>
                        <th scope="col" class="text-end">Blood pressure</th>
                        <th scope="col" class="text-end">Glucose</th>
                        <th scope="col">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@row.MeasuredAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">@row.WeightKg.ToString("0.0")</td>
                            <td class="text-end">
                                @row.Bmi.ToString("0.0")
                                <span class="badge @StatusBadges.For(row.BmiCategory) ms-1">@row.BmiCategory.GetDisplayName()</span>
                            </td>
                            <td class="text-end">@row.BodyFatPercent?.ToString("0.0")</td>
                            <td class="text-end">@row.WaistCm?.ToString("0.0")</td>
                            <td class="text-end">@(row.RestingHeartRate is { } bpm ? bpm + " bpm" : null)</td>
                            <td class="text-end text-nowrap">@(row.SystolicBp is { } sys && row.DiastolicBp is { } dia ? sys + "/" + dia : row.SystolicBp?.ToString())</td>
                            <td class="text-end">@row.BloodGlucose?.ToString("0.0")</td>
                            <td class="small">@row.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_Pager" model="pager" />
