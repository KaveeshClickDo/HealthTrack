@model AvailabilityPageViewModel
@{
    ViewData["Title"] = "Availability";
    ViewData["Parent"] = "Coaching";
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Availability</h1>
        <p>Clients can book you only inside these weekly windows, from 2 hours to 60 days ahead.</p>
    </div>
    <div class="actions"><a class="btn btn-secondary" asp-controller="Appointments" asp-action="Index">@Icons.Svg("calendar", 18)Appointments</a></div>
</div>

<div class="split">
    <section class="main card gp-18">
        <div class="card-head">
            <h2 class="h2">Weekly windows</h2>
            <div class="hrow gp-8">
                <span class="badge b-accent">@Model.WeeklyHours.ToString("0.#") hours a week</span>
                <span class="small subtle">@Model.Windows.Count @(Model.Windows.Count == 1 ? "window" : "windows")</span>
            </div>
        </div>
        @if (Model.Windows.Count == 0)
        {
            <div class="alert alert-info">@Icons.Svg("info", 18)<span>You haven't published any availability yet, so clients can't book you. Add your first window.</span></div>
        }
        <div class="week-cols">
            @foreach (var day in WorkoutText.WeekFromMonday)
            {
                var windows = Model.Windows.Where(w => w.DayOfWeek == day).OrderBy(w => w.StartTime).ToList();
                <div class="week-col">
                    <span class="day">@day.ToString()[..3]</span>
                    @if (windows.Count == 0)
                    {
                        <span class="off">Off</span>
                    }
                    @foreach (var window in windows)
                    {
                        <div class="window-chip">
                            <span>@window.StartTime.ToString("hh\\:mm")</span>
                            <span>@window.EndTime.ToString("hh\\:mm")</span>
                            <form asp-action="Delete" asp-route-id="@window.AvailabilityId" method="post"
                                  data-confirm="Remove the @day @window.StartTime.ToString("hh\\:mm")–@window.EndTime.ToString("hh\\:mm") window? Appointments already booked in it are kept.">
                                <button type="submit" class="icon-btn" aria-label="Remove the @day @window.StartTime.ToString("hh\\:mm") window">@Icons.Svg("x", 14)</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
        <p class="small subtle hrow gp-8">@Icons.Svg("info", 16)Removing a window keeps any appointments already booked in it.</p>
    </section>

    <aside class="aside">
        <form class="card vs gp-16" asp-action="Create" method="post">
            <h2 class="h3">Add a window</h2>
            <div asp-validation-summary="All" role="alert"></div>
            <div class="field">
                <label asp-for="NewWindow.DayOfWeek" class="label"></label>
                <select asp-for="NewWindow.DayOfWeek" class="select">
                    <option value="">Choose…</option>
                    @foreach (var day in WorkoutText.WeekFromMonday)
                    {
                        <option value="@((int)day)">@day</option>
                    }
                </select>
                <span asp-validation-for="NewWindow.DayOfWeek" class="error-text"></span>
            </div>
            <div class="form-grid macros">
                <div class="field">
                    <label asp-for="NewWindow.StartTime" class="label"></label>
                    <input asp-for="NewWindow.StartTime" type="time" step="900" asp-format="{0:hh\:mm}" class="input" />
                    <span asp-validation-for="NewWindow.StartTime" class="error-text"></span>
                </div>
                <div class="field">
                    <label asp-for="NewWindow.EndTime" class="label"></label>
                    <input asp-for="NewWindow.EndTime" type="time" step="900" asp-format="{0:hh\:mm}" class="input" />
                    <span asp-validation-for="NewWindow.EndTime" class="error-text"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">@Icons.Svg("plus", 18)Add window</button>
            <p class="xs subtle">Windows on the same day can't overlap. Start times are offered every 15 minutes.</p>
        </form>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
