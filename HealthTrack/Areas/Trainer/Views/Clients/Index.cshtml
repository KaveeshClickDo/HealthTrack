@model IReadOnlyList<TrainerClientViewModel>
@inject IClock Clock
@{
    ViewData["Title"] = "My clients";
    ViewData["Parent"] = "Coaching";
    ViewData["Crumb"] = "Clients";
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">My clients</h1>
        <p>The clients an administrator has assigned to you. Adherence covers the last 7 days, and anyone with nothing logged for 7 days or more is flagged.</p>
    </div>
    <div class="actions"><a class="btn btn-secondary" asp-controller="WorkoutPlans" asp-action="Templates">@Icons.Svg("copy", 18)Routine templates</a></div>
</div>

@if (Model.Count == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("users", 24)</span>
        <p><span class="strong">No clients are assigned to you yet.</span> An administrator assigns clients, and you'll get a notification when they do. Meanwhile you can build routine templates.</p>
        <a class="btn btn-secondary" asp-controller="WorkoutPlans" asp-action="Templates">Routine templates</a>
    </div>
}
else
{
    <div class="grid g-3">
        @foreach (var client in Model)
        {
            <article class="card client-card @(client.IsInactive ? "is-inactive" : string.Empty)">
                <div class="hrow items-start gp-14">
                    <span class="avatar av-@(client.ClientId % 6 + 1)">@client.FullName.Initials()</span>
                    <div class="who vs gp-4">
                        <h2 class="h3">@client.FullName</h2>
                        <span class="small subtle">@client.Email</span>
                        @if (client.IsInactive)
                        {
                            <span class="badge b-red self-start">@Icons.Svg("alert-circle", 14)Inactive @client.DaysInactive days</span>
                        }
                        else
                        {
                            <span class="badge b-green self-start"><span class="dot"></span>Active</span>
                        }
                    </div>
                </div>
                <dl class="kv compact">
                    <dt>Goal</dt><dd>@client.FitnessGoal.GetDisplayName() <span class="subtle">· @client.ActivityLevel.GetDisplayName()</span></dd>
                    <dt>Workout plan</dt><dd>@(client.ActivePlanTitle ?? "No active plan")</dd>
                    <dt>Client since</dt><dd>@client.AssignedSince.ToString("d MMM yyyy")</dd>
                    <dt>Last activity</dt>
                    <dd>
                        @(client.LastActiveDay is { } last ? DateLabels.Day(last, Clock.Today) : "Nothing logged")
                        <span class="subtle">· @(client.LastWorkoutDate is { } workout ? "last workout " + workout.ToString("d MMM") : "no workout yet")</span>
                    </dd>
                </dl>
                <div class="vs gp-8">
                    <div class="between small"><span class="muted">Adherence, last 7 days</span><span class="num strong @(client.AdherencePercent is < 50 ? "c-amber" : string.Empty)">@(client.AdherencePercent is { } adherence ? adherence + "%" : "–")</span></div>
                    @if (client.AdherencePercent is { } percent)
                    {
                        <div class="bar thick" role="progressbar" aria-label="Adherence" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><i class="@(percent < 50 ? "amber" : string.Empty)" data-progress-width="@percent"></i></div>
                    }
                    else
                    {
                        <span class="xs subtle">Nothing scheduled this week.</span>
                    }
                </div>
                <div class="divider"></div>
                <a class="btn btn-primary btn-block" asp-action="Progress" asp-route-clientId="@client.ClientId">@Icons.Svg("trending-up", 18)View progress</a>
                <div class="two-col">
                    <a class="btn btn-ghost btn-sm" asp-controller="WorkoutPlans" asp-action="Create" asp-route-clientId="@client.ClientId">New plan</a>
                    <a class="btn btn-ghost btn-sm" asp-controller="DietPlans" asp-action="Create" asp-route-clientId="@client.ClientId">Diet plan</a>
                    <a class="btn btn-ghost btn-sm" asp-controller="WorkoutPlans" asp-action="Templates" asp-route-clientId="@client.ClientId">Assign template</a>
                    <a class="btn btn-ghost btn-sm" asp-controller="Feedback" asp-action="Create" asp-route-clientId="@client.ClientId">Give feedback</a>
                </div>
            </article>
        }
    </div>
    <p class="small subtle hrow gp-8">@Icons.Svg("info", 16)New clients are assigned by an administrator. You'll get a notification when it happens.</p>
}
