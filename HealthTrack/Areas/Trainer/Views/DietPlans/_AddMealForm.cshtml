@model PlanMealViewModel
@{
    var planId = (int)ViewData["PlanId"]!;
}
@* Its own form, so adding a meal doesn't post the plan's other fields. The field names come from this partial's model. *@
<form class="form-stack gp-16" asp-action="AddMeal" asp-route-id="@planId" method="post">
    <div class="grid-4">
        <div class="field">
            <label asp-for="DayOfWeek" class="label"></label>
            <select asp-for="DayOfWeek" class="select">
                <option value="">Every day</option>
                @foreach (var day in WorkoutText.WeekFromMonday)
                {
                    <option value="@((int)day)">@day only</option>
                }
            </select>
        </div>
        <div class="field">
            <label asp-for="MealType" class="label"></label>
            <select asp-for="MealType" asp-items="Html.GetEnumSelectList<MealType>()" class="select">
                <option value="">Choose…</option>
            </select>
            <span asp-validation-for="MealType" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="ScheduledTime" class="label"></label>
            <input asp-for="ScheduledTime" type="time" asp-format="{0:hh\:mm}" class="input" />
            <span asp-validation-for="ScheduledTime" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="TargetCalories" class="label"></label>
            <div class="input-wrap"><input asp-for="TargetCalories" type="number" min="50" max="2000" step="10" class="input" /><span class="unit">kcal</span></div>
            <span asp-validation-for="TargetCalories" class="error-text"></span>
        </div>
    </div>
    <div class="field">
        <label asp-for="MealDescription" class="label"></label>
        <input asp-for="MealDescription" class="input" placeholder="For example, oats 50 g, banana, 200 ml low-fat milk" />
        <span asp-validation-for="MealDescription" class="error-text"></span>
    </div>
    <div><button type="submit" class="btn btn-secondary">@Icons.Svg("plus", 18)Add the meal</button></div>
</form>
