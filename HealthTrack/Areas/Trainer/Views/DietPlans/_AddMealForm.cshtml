@model PlanMealViewModel
@{
    var planId = (int)ViewData["PlanId"]!;
}
@* Its own form, so adding a meal doesn't post the plan's other fields. The field names come from this partial's model. *@
<form asp-action="AddMeal" asp-route-id="@planId" method="post" class="row g-2 align-items-end">
    <div class="col-md-3">
        <label asp-for="DayOfWeek" class="form-label small"></label>
        <select asp-for="DayOfWeek" class="form-select">
            <option value="">Every day</option>
            @foreach (var day in WorkoutText.WeekFromMonday)
            {
                <option value="@((int)day)">@day only</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="MealType" class="form-label small"></label>
        <select asp-for="MealType" asp-items="Html.GetEnumSelectList<MealType>()" class="form-select">
            <option value="">Choose…</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="ScheduledTime" class="form-label small"></label>
        <input asp-for="ScheduledTime" type="time" asp-format="{0:hh\:mm}" class="form-control" />
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="TargetCalories" class="form-label small"></label>
        <input asp-for="TargetCalories" type="number" min="50" max="2000" step="10" class="form-control" />
    </div>
    <div class="col-md-10">
        <label asp-for="MealDescription" class="form-label small"></label>
        <input asp-for="MealDescription" class="form-control" placeholder="For example, oats 50 g, banana, 200 ml low-fat milk" />
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Add</button>
    </div>
    <div class="col-12">
        <span asp-validation-for="MealType" class="text-danger small d-block"></span>
        <span asp-validation-for="ScheduledTime" class="text-danger small d-block"></span>
        <span asp-validation-for="TargetCalories" class="text-danger small d-block"></span>
        <span asp-validation-for="MealDescription" class="text-danger small d-block"></span>
        <div class="form-text">The time also sets when the client's meal reminder is sent.</div>
    </div>
</form>
