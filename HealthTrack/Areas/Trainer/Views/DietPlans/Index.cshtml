@model PagedResult<DietPlanListItemViewModel>
@{
    ViewData["Title"] = "Diet plans";
    ViewData["Parent"] = "Planning";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());

    static string Macros(DietPlanListItemViewModel plan)
    {
        var parts = new List<string>();
        if (plan.ProteinTargetG is { } protein) { parts.Add($"Protein {protein} g"); }
        if (plan.CarbsTargetG is { } carbs) { parts.Add($"Carbohydrate {carbs} g"); }
        if (plan.FatTargetG is { } fat) { parts.Add($"Fat {fat} g"); }
        return parts.Count == 0 ? "Calories only" : string.Join(" · ", parts);
    }
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Diet plans</h1>
        <p>Daily calorie and macro targets with planned meals. The calorie target is suggested from each client's latest measurement and goal.</p>
    </div>
    <div class="actions"><a class="btn btn-primary" asp-action="Create">@Icons.Svg("plus", 18)New diet plan</a></div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card empty">
        <span class="icon">@Icons.Svg("apple", 24)</span>
        <p><span class="strong">You haven't written any diet plans yet.</span> Create one for a client; the calorie target is suggested from their latest measurement and goal.</p>
        <a class="btn btn-primary" asp-action="Create">New diet plan</a>
    </div>
}
else
{
    <section class="card flush">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Plan</th><th scope="col">Client</th><th scope="col">Status</th><th scope="col">Dates</th><th scope="col" class="r">kcal a day</th><th scope="col" class="r">Meals</th><th scope="col"><span class="visually-hidden">Open</span></th></tr></thead>
                <tbody>
                    @foreach (var plan in Model.Items)
                    {
                        <tr>
                            <th scope="row">
                                <span class="cell-person">
                                    <span class="stat-icon" data-tone="orange">@Icons.Svg("apple", 18)</span>
                                    <span><a class="strong row-link" asp-action="Edit" asp-route-id="@plan.DietPlanId">@plan.Title</a><span class="sub">@Macros(plan)</span></span>
                                </span>
                            </th>
                            <td><span class="cell-person"><span class="avatar av-sm av-@(plan.ClientId % 6 + 1)">@plan.ClientName.Initials()</span>@plan.ClientName</span></td>
                            <td><span class="badge @StatusBadges.For(plan.Status)">@if (plan.Status == PlanStatus.Draft) {@Icons.Svg("pencil", 12)} else {<span class="dot"></span>}@plan.Status.GetDisplayName()</span></td>
                            <td class="nowrap">From @plan.StartDate.ToString("d MMM yyyy")<span class="sub">@(plan.EndDate is { } end ? "to " + end.ToString("d MMM yyyy") : "No end date")</span></td>
                            <td class="r num">@plan.DailyCalorieTarget.ToString("N0")</td>
                            <td class="r num">@plan.MealCount</td>
                            <td class="r">
                                @if (plan.Status == PlanStatus.Draft)
                                {
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@plan.DietPlanId">Continue</a>
                                }
                                else
                                {
                                    <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@plan.DietPlanId">@(plan.Status == PlanStatus.Active ? "Edit" : "Open")</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="pager" />
    </section>
}
