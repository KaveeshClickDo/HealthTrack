@model int?
@* The suggested calorie target next to the daily target field, shared by the create and edit forms. *@
@if (Model is { } suggested)
{
    <div class="alert suggest">
        @Icons.Svg("sparkles", 18)
        <span class="small"><span class="strong">Suggested: @suggested.ToString("N0") kcal</span><br /><span class="muted">From the client's latest weight and height, age, activity level and goal (TDEE − 500 to lose weight, + 300 to gain muscle, never below 1,200).</span></span>
    </div>
}
else
{
    <div class="alert on-surface">
        @Icons.Svg("info", 18)
        <span class="small muted">No suggestion yet: the client hasn't recorded a measurement. Enter a target yourself.</span>
    </div>
}
