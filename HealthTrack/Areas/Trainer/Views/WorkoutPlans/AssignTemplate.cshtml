@model AssignTemplateViewModel
@{
    ViewData["Title"] = "Assign a template";
    ViewData["Parent"] = "Templates";
    ViewData["ParentUrl"] = Url.Action("Templates");
    ViewData["Crumb"] = "Assign " + Model.TemplateTitle;
    var clients = new SelectList(Model.ClientOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
    var trainingDays = Model.Days.Where(d => !d.IsRestDay).Select(d => d.DayOfWeek).ToHashSet();
    var restDays = WorkoutText.WeekFromMonday.Where(d => !trainingDays.Contains(d)).Select(d => d.ToString()).ToList();
}

<a class="back" asp-action="Templates">@Icons.Svg("arrow-left", 16)Templates</a>
<div class="page-head">
    <div class="intro">
        <h1 class="h1">Assign “@Model.TemplateTitle”</h1>
        <div class="hrow wrap gp-8">
            <span class="badge diff-@((int)Model.Difficulty)">@Model.Difficulty.GetDisplayName()</span>
            <span class="muted">By @Model.AuthorName · your client gets their own copy, which you can then adjust.</span>
        </div>
    </div>
</div>

<div class="split">
    <form class="aside card gp-18" asp-action="AssignTemplate" asp-route-id="@Model.TemplateId" method="post">
        <h2 class="h2">Who and when</h2>
        <div asp-validation-summary="All" role="alert"></div>
        <div class="field">
            <label asp-for="ClientId" class="label"></label>
            @if (Model.ClientOptions.Count == 0)
            {
                <div class="alert alert-info">@Icons.Svg("info", 18)<span>No clients are assigned to you yet, so there is nobody to assign the template to.</span></div>
            }
            else
            {
                <select asp-for="ClientId" asp-items="clients" class="select">
                    <option value="">Choose a client…</option>
                </select>
            }
            <span asp-validation-for="ClientId" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="StartDate" class="label"></label>
            <input asp-for="StartDate" class="input" />
            <span asp-validation-for="StartDate" class="error-text"></span>
        </div>
        <div class="divider"></div>
        <label class="check" for="ActivateNow">
            <input asp-for="ActivateNow" />
            <span><span class="strong d-block">Activate it now</span><span class="small subtle">Their current active workout plan is marked completed, and they're notified.</span></span>
        </label>
        <div class="actions">
            <button type="submit" class="btn btn-primary" disabled="@(Model.ClientOptions.Count == 0)">@Icons.Svg("user-plus", 18)Assign</button>
            <a class="btn btn-ghost" asp-action="Templates">Cancel</a>
        </div>
    </form>

    <section class="main gp-16">
        <div class="between wrap"><h2 class="h2">What's in it</h2><span class="small subtle">@Model.Days.Sum(d => d.Lines.Count) exercises · @trainingDays.Count @(trainingDays.Count == 1 ? "day" : "days") a week</span></div>
        <partial name="_PlanDays" model="Model.Days" />
        @if (restDays.Count > 0 && trainingDays.Count > 0)
        {
            <p class="small subtle">@(restDays.Count == 1 ? restDays[0] + " is a rest day." : string.Join(", ", restDays.Take(restDays.Count - 1)) + " and " + restDays[^1] + " are rest days.")</p>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
