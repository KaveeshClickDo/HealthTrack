@model WorkoutPlanViewModel
@{
    ViewData["Title"] = Model.IsTemplate ? "New template" : "New workout plan";
    var clients = new SelectList(Model.ClientOptions, nameof(SelectOptionViewModel.Id), nameof(SelectOptionViewModel.Label));
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <p><a asp-action="@(Model.IsTemplate ? "Templates" : "Index")">&larr; @(Model.IsTemplate ? "Templates" : "Workout plans")</a></p>
        <h1 class="h2 mb-2">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">
            @if (Model.IsTemplate)
            {
                <span>A template is a reusable routine. Any trainer can copy it to their own clients.</span>
            }
            else
            {
                <span>The plan starts as a draft. Add exercises next, then activate it for the client.</span>
            }
        </p>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <input asp-for="IsTemplate" type="hidden" />

                    <div class="row g-3">
                        @if (!Model.IsTemplate)
                        {
                            <div class="col-12">
                                <label asp-for="ClientId" class="form-label"></label>
                                @if (Model.ClientOptions.Count == 0)
                                {
                                    <div class="alert alert-warning mb-0">
                                        No clients are assigned to you yet. You can <a asp-action="Create" asp-route-template="true">create a template</a> instead.
                                    </div>
                                }
                                else
                                {
                                    <select asp-for="ClientId" asp-items="clients" class="form-select">
                                        <option value="">Choose a client…</option>
                                    </select>
                                }
                                <span asp-validation-for="ClientId" class="text-danger small"></span>
                            </div>
                        }
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Difficulty" class="form-label"></label>
                            <select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<DifficultyLevel>()" class="form-select"></select>
                            <span asp-validation-for="Difficulty" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label> <span class="text-muted small">(optional)</span>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="The goal of the plan and how to approach it"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        @if (!Model.IsTemplate)
                        {
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label"></label>
                                <input asp-for="StartDate" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label"></label> <span class="text-muted small">(optional)</span>
                                <input asp-for="EndDate" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Create and add exercises</button>
                        <a class="btn btn-outline-secondary" asp-action="@(Model.IsTemplate ? "Templates" : "Index")">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
