@model WorkoutPlanEditViewModel
@{
    ViewData["Title"] = Model.Title;
    var addFormData = new ViewDataDictionary(ViewData) { ["PlanId"] = Model.WorkoutPlanId, ["ExerciseOptions"] = Model.ExerciseOptions };
}

<p><a asp-action="@(Model.IsTemplate ? "Templates" : "Index")">&larr; @(Model.IsTemplate ? "Templates" : "Workout plans")</a></p>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">@Model.Title</h1>
        <span class="badge @StatusBadges.For(Model.Status)">@Model.Status.GetDisplayName()</span>
        @if (Model.IsTemplate)
        {
            <span class="text-muted small ms-1">Template &middot; assigned @Model.TimesAssigned @(Model.TimesAssigned == 1 ? "time" : "times")</span>
        }
        else
        {
            <span class="text-muted small ms-1">Plan for @Model.ClientName</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (!Model.IsTemplate && Model.Status == PlanStatus.Draft)
        {
            <form asp-action="Activate" asp-route-id="@Model.WorkoutPlanId" method="post"
                  data-confirm="Activate this plan for @Model.ClientName? Their current active workout plan will be completed.">
                <button type="submit" class="btn btn-primary">Activate</button>
            </form>
        }
        @if (Model.IsTemplate && Model.Status != PlanStatus.Archived)
        {
            <a class="btn btn-primary" asp-action="AssignTemplate" asp-route-id="@Model.WorkoutPlanId">Assign to a client</a>
        }
        @if (!Model.IsTemplate && Model.Lines.Count > 0)
        {
            <form asp-action="SaveAsTemplate" asp-route-id="@Model.WorkoutPlanId" method="post">
                <button type="submit" class="btn btn-outline-primary">Save as template</button>
            </form>
        }
        @if (Model.Status != PlanStatus.Archived)
        {
            <form asp-action="Archive" asp-route-id="@Model.WorkoutPlanId" method="post"
                  data-confirm="Archive this plan? It stays in the history but can't be changed or used again.">
                <button type="submit" class="btn btn-outline-danger">Archive</button>
            </form>
        }
    </div>
</div>

@if (!Model.CanEdit)
{
    <div class="alert alert-secondary">This plan is @Model.Status.GetDisplayName().ToLowerInvariant() and is kept as history, so it can't be changed.</div>
}

<form asp-action="Edit" asp-route-id="@Model.WorkoutPlanId" method="post">
    <fieldset disabled="@(!Model.CanEdit)">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input asp-for="IsTemplate" type="hidden" />

        <div class="card shadow-sm mb-3">
            <div class="card-body row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Difficulty" class="form-label"></label>
                    <select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<DifficultyLevel>()" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                @if (!Model.IsTemplate)
                {
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label"></label> <span class="text-muted small">(optional)</span>
                        <input asp-for="EndDate" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5">Exercises by day</h2>
                @if (Model.Lines.Count == 0)
                {
                    <p class="text-muted mb-0">No exercises yet. Add the first one below.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Exercise</th>
                                    <th scope="col">Sets</th>
                                    <th scope="col">Reps</th>
                                    <th scope="col">Minutes</th>
                                    <th scope="col">Rest (s)</th>
                                    <th scope="col">Notes</th>
                                    <th scope="col">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Lines.Count; i++)
                                {
                                    var line = Model.Lines[i];
                                    if (i == 0 || Model.Lines[i - 1].DayOfWeek != line.DayOfWeek)
                                    {
                                        <tr class="table-light">
                                            <th colspan="7" scope="rowgroup">@line.DayOfWeek</th>
                                        </tr>
                                    }
                                    <tr>
                                        <td>
                                            <input asp-for="Lines[i].WorkoutPlanExerciseId" type="hidden" />
                                            @line.ExerciseName
                                            <span asp-validation-for="Lines[i].Sets" class="text-danger small d-block"></span>
                                        </td>
                                        <td><input asp-for="Lines[i].Sets" type="number" min="1" max="20" class="form-control form-control-sm" aria-label="Sets" /></td>
                                        <td><input asp-for="Lines[i].Reps" type="number" min="1" max="100" class="form-control form-control-sm" aria-label="Reps" /></td>
                                        <td><input asp-for="Lines[i].DurationMinutes" type="number" min="1" max="300" class="form-control form-control-sm" aria-label="Minutes" /></td>
                                        <td><input asp-for="Lines[i].RestSeconds" type="number" min="0" max="600" step="15" class="form-control form-control-sm" aria-label="Rest in seconds" /></td>
                                        <td><input asp-for="Lines[i].Notes" class="form-control form-control-sm" aria-label="Notes" /></td>
                                        <td class="text-center"><input asp-for="Lines[i].Remove" class="form-check-input" aria-label="Remove @line.ExerciseName" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (Model.CanEdit)
        {
            <div class="mb-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        }
    </fieldset>
</form>

@if (Model.CanEdit)
{
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5">Add an exercise</h2>
            <partial name="_AddExerciseForm" model="Model.NewExercise" view-data="addFormData" />
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
