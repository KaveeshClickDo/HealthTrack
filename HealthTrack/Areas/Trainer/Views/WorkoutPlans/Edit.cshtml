@model WorkoutPlanEditViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Parent"] = Model.IsTemplate ? "Templates" : "Workout plans";
    ViewData["ParentUrl"] = Url.Action(Model.IsTemplate ? "Templates" : "Index");
    var addFormData = new ViewDataDictionary(ViewData) { ["PlanId"] = Model.WorkoutPlanId, ["ExerciseOptions"] = Model.ExerciseOptions };
    var days = Model.Lines.Select(l => l.DayOfWeek).Distinct().OrderBy(d => ((int)d + 6) % 7).Select(d => d.ToString()).ToList();
    var clientFirstName = Model.ClientName?.Split(' ')[0];
}

<a class="back" asp-action="@(Model.IsTemplate ? "Templates" : "Index")">@Icons.Svg("arrow-left", 16)@(Model.IsTemplate ? "Templates" : "Workout plans")</a>
<div class="page-head">
    <div class="intro">
        <div class="plan-meta">
            @if (Model.Status == PlanStatus.Draft)
            {
                <span class="badge">@Icons.Svg("pencil", 12)Draft</span>
            }
            else
            {
                <span class="badge @StatusBadges.For(Model.Status)"><span class="dot"></span>@Model.Status.GetDisplayName()</span>
            }
            @if (Model.IsTemplate)
            {
                <span class="small subtle">Template · assigned @Model.TimesAssigned @(Model.TimesAssigned == 1 ? "time" : "times")</span>
            }
            else
            {
                <span class="small subtle">Plan for</span>
                <span class="avatar av-sm av-client">@Model.ClientName.Initials()</span>
                <span class="small strong">@Model.ClientName</span>
            }
        </div>
        <h1 class="h1">@Model.Title</h1>
    </div>
    <div class="actions">
        @if (Model.Status != PlanStatus.Archived)
        {
            <form class="inline" asp-action="Archive" asp-route-id="@Model.WorkoutPlanId" method="post"
                  data-confirm="Archive this plan? It stays in the history but can't be changed or used again.">
                <button type="submit" class="btn btn-danger">@Icons.Svg("archive", 18)Archive</button>
            </form>
        }
        @if (!Model.IsTemplate && Model.Lines.Count > 0)
        {
            <form class="inline" asp-action="SaveAsTemplate" asp-route-id="@Model.WorkoutPlanId" method="post">
                <button type="submit" class="btn btn-secondary">@Icons.Svg("copy-plus", 18)Save as template</button>
            </form>
        }
        @if (Model.IsTemplate && Model.Status != PlanStatus.Archived)
        {
            <a class="btn btn-primary" asp-action="AssignTemplate" asp-route-id="@Model.WorkoutPlanId">@Icons.Svg("user-plus", 18)Assign to a client</a>
        }
        @if (!Model.IsTemplate && Model.Status == PlanStatus.Draft)
        {
            <form class="inline" asp-action="Activate" asp-route-id="@Model.WorkoutPlanId" method="post"
                  data-confirm="Activate this plan for @Model.ClientName? Their current active workout plan will be completed.">
                <button type="submit" class="btn btn-primary">@Icons.Svg("play-circle", 18)Activate</button>
            </form>
        }
    </div>
</div>

@if (!Model.IsTemplate && Model.Status == PlanStatus.Draft)
{
    <div class="alert alert-info">@Icons.Svg("eye-off", 18)<span><span class="strong">@clientFirstName can't see this yet.</span> When you activate it, they're notified and their current workout plan is marked completed.</span></div>
}
@if (!Model.CanEdit)
{
    <div class="alert on-surface">@Icons.Svg("info", 18)<span class="muted">This plan is @Model.Status.GetDisplayName().ToLowerInvariant() and is kept as history, so it can't be changed.</span></div>
}

<form class="form-stack" asp-action="Edit" asp-route-id="@Model.WorkoutPlanId" method="post">
    <fieldset class="form-stack" disabled="@(!Model.CanEdit)">
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="IsTemplate" type="hidden" />

        <section class="card form-card">
            <h2 class="h2">Plan details</h2>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Title" class="label"></label>
                    <input asp-for="Title" class="input" />
                    <span asp-validation-for="Title" class="error-text"></span>
                </div>
                <div class="field">
                    <label asp-for="Difficulty" class="label"></label>
                    <select asp-for="Difficulty" asp-items="Html.GetEnumSelectList<DifficultyLevel>()" class="select"></select>
                </div>
                <div class="field full">
                    <label asp-for="Description" class="label"></label>
                    <textarea asp-for="Description" class="textarea"></textarea>
                    <span asp-validation-for="Description" class="error-text"></span>
                </div>
                @if (!Model.IsTemplate)
                {
                    <div class="field">
                        <label asp-for="StartDate" class="label"></label>
                        <input asp-for="StartDate" class="input" />
                        <span asp-validation-for="StartDate" class="error-text"></span>
                    </div>
                    <div class="field">
                        <label asp-for="EndDate" class="label">End date <span class="opt">Optional</span></label>
                        <input asp-for="EndDate" class="input" />
                        <span asp-validation-for="EndDate" class="error-text"></span>
                    </div>
                }
            </div>
        </section>

        <section class="card flush">
            <div class="card-head pad">
                <div class="vs gp-4">
                    <h2 class="h2">Exercises by day</h2>
                    <span class="small subtle">@Model.Lines.Count @(Model.Lines.Count == 1 ? "exercise" : "exercises")@(days.Count > 0 ? " · " + (days.Count == 1 ? days[0] : string.Join(", ", days.Take(days.Count - 1)) + " and " + days[^1]) : string.Empty)</span>
                </div>
            </div>
            @if (Model.Lines.Count == 0)
            {
                <p class="small muted card-pad-bottom">No exercises yet. Add the first one below.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table compact lines">
                        <thead><tr><th scope="col">Exercise</th><th scope="col">Sets</th><th scope="col">Reps</th><th scope="col">Minutes</th><th scope="col">Rest (s)</th><th scope="col">Notes</th><th scope="col" class="c">Remove</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Lines.Count; i++)
                            {
                                var line = Model.Lines[i];
                                if (i == 0 || Model.Lines[i - 1].DayOfWeek != line.DayOfWeek)
                                {
                                    <tr class="group"><th colspan="7" scope="rowgroup">@line.DayOfWeek</th></tr>
                                }
                                <tr>
                                    <th scope="row">
                                        <input asp-for="Lines[i].WorkoutPlanExerciseId" type="hidden" />
                                        <span class="cell-person"><img class="thumb thumb-sm" src="@ExercisePhotos.For(line.ExerciseName)" alt="" /><span class="strong">@line.ExerciseName</span></span>
                                        <span asp-validation-for="Lines[i].Sets" class="error-text d-block"></span>
                                    </th>
                                    <td><input asp-for="Lines[i].Sets" type="number" min="1" max="20" class="input input-sm" aria-label="Sets" /></td>
                                    <td><input asp-for="Lines[i].Reps" type="number" min="1" max="100" class="input input-sm" aria-label="Reps" /></td>
                                    <td><input asp-for="Lines[i].DurationMinutes" type="number" min="1" max="300" class="input input-sm" aria-label="Minutes" /></td>
                                    <td><input asp-for="Lines[i].RestSeconds" type="number" min="0" max="600" step="15" class="input input-sm" aria-label="Rest in seconds" /></td>
                                    <td><input asp-for="Lines[i].Notes" class="input input-sm note" aria-label="Notes" placeholder="Add a coaching cue" /></td>
                                    <td class="c"><input asp-for="Lines[i].Remove" class="remove" aria-label="Remove @line.ExerciseName" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.CanEdit)
            {
                <div class="foot-note">
                    <span class="small subtle">Tick Remove, then save, to take an exercise out.</span>
                    <button type="submit" class="btn btn-primary btn-sm">Save changes</button>
                </div>
            }
        </section>
    </fieldset>
</form>

@if (Model.CanEdit)
{
    <section class="card form-card">
        <div class="vs gp-4">
            <h2 class="h2">Add an exercise</h2>
            <p class="small subtle">Give sets and reps for strength, minutes for cardio and stretching — or both.</p>
        </div>
        <partial name="_AddExerciseForm" model="Model.NewExercise" view-data="addFormData" />
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/exercise-preview.js" asp-append-version="true"></script>
}
