@model IReadOnlyList<TemplateListItemViewModel>
@{
    ViewData["Title"] = "Routine templates";
    ViewData["Parent"] = "Planning";
    ViewData["Crumb"] = "Templates";
    var clientId = ViewData["ClientId"] as int?;
}

<div class="page-head">
    <div class="intro">
        <h1 class="h1">Routine templates</h1>
        <p>Reusable routines from every trainer. Assigning one gives your client their own copy — the template itself never changes.</p>
    </div>
    <div class="actions"><a class="btn btn-primary" asp-action="Create" asp-route-template="true">@Icons.Svg("plus", 18)New template</a></div>
</div>

<div class="grid g-3">
    @foreach (var template in Model)
    {
        var days = template.Days.OrderBy(d => ((int)d + 6) % 7).Select(d => d.ToString()[..3]).ToList();
        <article class="card flush template-card">
            <div class="frame">
                <img class="photo photo-fill" src="@(template.FirstExerciseName is null ? null : ExercisePhotos.For(template.FirstExerciseName, template.FirstExerciseCategory ?? ExerciseCategory.Strength))" alt="" />
                <div class="shade"></div>
                <span class="badge diff-@((int)template.Difficulty)">@template.Difficulty.GetDisplayName()</span>
            </div>
            <div class="body">
                <div class="between items-start gp-8"><h2 class="h2">@template.Title</h2><span class="small subtle nowrap">By @(template.IsOwn ? "you" : template.AuthorName)</span></div>
                @if (!string.IsNullOrEmpty(template.Description))
                {
                    <p class="small muted">@template.Description</p>
                }
                <div class="facts xs subtle">
                    <span>@Icons.Svg("dumbbell", 14)@template.ExerciseCount @(template.ExerciseCount == 1 ? "exercise" : "exercises")</span>
                    @if (days.Count > 0)
                    {
                        <span>@Icons.Svg("calendar", 14)@string.Join(", ", days)</span>
                    }
                    <span>@Icons.Svg("users", 14)@(template.TimesAssigned == 0 ? "Not assigned yet" : template.TimesAssigned == 1 ? "Assigned once" : $"Assigned {template.TimesAssigned} times")</span>
                </div>
                <div class="actions">
                    <a class="btn btn-primary btn-sm" asp-action="AssignTemplate" asp-route-id="@template.WorkoutPlanId" asp-route-clientId="@clientId">Assign to a client</a>
                    @if (template.IsOwn)
                    {
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@template.WorkoutPlanId">Edit</a>
                    }
                </div>
            </div>
        </article>
    }
    <a class="card add-card" asp-action="Create" asp-route-template="true">
        <span class="stat-icon">@Icons.Svg("plus", 24)</span>
        <span class="strong">Create a template</span>
        <span class="small muted">Or open one of your client plans and save it as a template.</span>
    </a>
</div>
