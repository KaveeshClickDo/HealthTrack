@model PagedResult<WorkoutPlanListItemViewModel>
@{
    ViewData["Title"] = "Workout plans";
    var pager = new PagerViewModel(Model.Page, Model.TotalPages, Model.TotalCount, new Dictionary<string, string?>());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Workout plans</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Templates">Templates</a>
        <a class="btn btn-outline-primary" asp-action="Create" asp-route-template="true">New template</a>
        <a class="btn btn-primary" asp-action="Create">New client plan</a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            You haven't written any client plans yet. <a asp-action="Create">Create one</a> or
            <a asp-action="Templates">assign a template</a> to one of your clients.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Plan</th>
                        <th scope="col">Client</th>
                        <th scope="col">Status</th>
                        <th scope="col">Dates</th>
                        <th scope="col" class="text-end">Exercises</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Edit" asp-route-id="@plan.WorkoutPlanId">@plan.Title</a>
                                @if (plan.SourceTemplateTitle is not null)
                                {
                                    <div class="small text-muted">From the template @plan.SourceTemplateTitle</div>
                                }
                            </td>
                            <td>@plan.ClientName</td>
                            <td><span class="badge @StatusBadges.For(plan.Status)">@plan.Status.GetDisplayName()</span></td>
                            <td class="text-nowrap small">
                                @plan.StartDate?.ToString("dd MMM yyyy")
                                @if (plan.EndDate is { } end)
                                {
                                    <span>to @end.ToString("dd MMM yyyy")</span>
                                }
                            </td>
                            <td class="text-end">@plan.ExerciseCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_Pager" model="pager" />
