@model AppointmentDetailsViewModel
@{
    var appointment = Model.Appointment;
    ViewData["Title"] = "Appointment with " + appointment.ClientName;
    ViewData["Parent"] = "Appointments";
    ViewData["ParentUrl"] = Url.Action("Index");
    ViewData["Crumb"] = (appointment.Status == AppointmentStatus.Pending ? "Request" : appointment.AppointmentType.GetDisplayName()) + ", " + appointment.StartDateTime.ToString("d MMM");
    var summaryData = new ViewDataDictionary(ViewData) { ["ShowClient"] = true };
    var clientFirstName = appointment.ClientName.Split(' ')[0];
}

<a class="back" asp-action="Index">@Icons.Svg("arrow-left", 16)Appointments</a>
<div class="page-head">
    <div class="intro">
        <span class="badge @StatusBadges.For(appointment.Status) self-start"><span class="dot"></span>@(appointment.Status == AppointmentStatus.Pending ? "Pending — waiting for you" : appointment.Status.GetDisplayName())</span>
        <h1 class="h1">@appointment.AppointmentType.GetDisplayName() with @appointment.ClientName</h1>
        <p>@appointment.StartDateTime.ToString("dddd d MMMM") · @appointment.StartDateTime.ToString("HH:mm") – @appointment.EndDateTime.ToString("HH:mm") · @appointment.Mode.GetDisplayName()</p>
    </div>
</div>

<div class="split">
    <section class="main card gp-20">
        <h2 class="h2">Details</h2>
        <partial name="_AppointmentSummary" model="appointment" view-data="summaryData" />
        @if (Model.ProfessionalNotes is not null)
        {
            <div class="divider"></div>
            <div class="vs gp-6"><h3 class="h3">Your consultation notes</h3><p class="text-prewrap">@Model.ProfessionalNotes</p></div>
        }
        <div class="divider"></div>
        <p class="xs subtle">
            Requested @Model.CreatedAt.ToString("d MMM yyyy 'at' HH:mm")@if (Model.UpdatedAt is { } updated)
            {
                <text> · last changed @updated.ToString("d MMM yyyy 'at' HH:mm")</text>
            }
        </p>
    </section>

    <div class="aside">
        @if (Model.CanDecide)
        {
            <form class="card vs gp-14" asp-action="Approve" asp-route-id="@appointment.AppointmentId" method="post">
                <div class="hrow gp-12"><span class="stat-icon i-green">@Icons.Svg("check", 18)</span><h2 class="h3">Approve</h2></div>
                <input type="hidden" name="RowVersion" value="@Model.Action.RowVersion" />
                <div class="field">
                    <label for="approve-location" class="label">@(appointment.Mode == AppointmentMode.Online ? "Meeting link" : "Room") <span class="opt">Optional</span></label>
                    <input id="approve-location" name="Location" class="input" maxlength="200" placeholder="@(appointment.Mode == AppointmentMode.Online ? "https://meet.example.com/…" : "For example, Studio 2")" />
                </div>
                <button type="submit" class="btn btn-success btn-block">Approve request</button>
            </form>
            <form class="card vs gp-14" asp-action="Reject" asp-route-id="@appointment.AppointmentId" method="post"
                  data-confirm="Decline this request? @appointment.ClientName will be told your reason.">
                <div class="hrow gp-12"><span class="stat-icon danger">@Icons.Svg("x", 18)</span><h2 class="h3">Decline</h2></div>
                <input type="hidden" name="RowVersion" value="@Model.Action.RowVersion" />
                <div class="field">
                    <label for="reject-reason" class="label">Reason</label>
                    <textarea id="reject-reason" name="Reason" class="textarea" maxlength="500" required placeholder="For example, I'm away that week"></textarea>
                    <span class="hint">@clientFirstName will see this, so they can pick another time.</span>
                </div>
                <button type="submit" class="btn btn-danger btn-block">Decline request</button>
            </form>
        }

        @if (Model.CanReschedule)
        {
            <div class="card between wrap gp-12">
                <div class="vs gp-4"><h2 class="h3">Move it</h2><p class="small subtle">Pick another free time; the client is told.</p></div>
                <a class="btn btn-secondary" asp-action="Reschedule" asp-route-id="@appointment.AppointmentId">@Icons.Svg("calendar-clock", 18)Reschedule</a>
            </div>
        }

        @if (Model.CanRecordOutcome)
        {
            <div class="card vs gp-14">
                <h2 class="h3">Record the outcome</h2>
                <form class="vs gp-12" asp-action="Complete" asp-route-id="@appointment.AppointmentId" method="post">
                    <input type="hidden" name="RowVersion" value="@Model.Action.RowVersion" />
                    <div class="field">
                        <label for="complete-notes" class="label">Consultation notes <span class="opt">Optional · stored encrypted</span></label>
                        <textarea id="complete-notes" name="Notes" class="textarea" maxlength="4000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success btn-block">Mark as completed</button>
                </form>
                <form asp-action="NoShow" asp-route-id="@appointment.AppointmentId" method="post" data-confirm="Record that @appointment.ClientName didn't attend?">
                    <input type="hidden" name="RowVersion" value="@Model.Action.RowVersion" />
                    <button type="submit" class="btn btn-ghost btn-block">@clientFirstName didn't attend</button>
                </form>
            </div>
        }

        @if (appointment.CanCancel)
        {
            <form class="card vs gp-14" asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post"
                  data-confirm="Cancel this appointment? @appointment.ClientName will be told your reason.">
                <h2 class="h3">Cancel</h2>
                <input type="hidden" name="RowVersion" value="@Model.Action.RowVersion" />
                <div class="field">
                    <label for="cancel-reason" class="label">Reason</label>
                    <textarea id="cancel-reason" name="Reason" class="textarea" maxlength="500" required></textarea>
                </div>
                <button type="submit" class="btn btn-danger btn-block">Cancel appointment</button>
            </form>
        }

        @if (!appointment.IsOpen)
        {
            <div class="alert on-surface">@Icons.Svg("info", 18)<span class="small muted">This appointment is @appointment.Status.GetDisplayName().ToLowerInvariant() and can no longer change.</span></div>
        }
        else if (!Model.CanDecide && !Model.CanReschedule && !Model.CanRecordOutcome && !appointment.CanCancel)
        {
            <div class="alert on-surface">@Icons.Svg("clock", 18)<span class="small muted">Nothing to do until the appointment starts.</span></div>
        }
    </div>
</div>
