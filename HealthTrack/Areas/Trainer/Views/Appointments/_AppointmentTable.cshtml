@model IEnumerable<AppointmentListItemViewModel>
@{
    var today = ViewData["Today"] as DateTime?;
}
@* One table of the professional's appointments; each row opens the appointment, where the actions are. *@
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">When</th>
                <th scope="col">Client</th>
                <th scope="col">Type</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="visually-hidden">Open</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td class="text-nowrap">
                        @appointment.StartDateTime.ToString("ddd dd MMM yyyy")
                        @if (appointment.StartDateTime.Date == today)
                        {
                            <span class="badge text-bg-info ms-1">Today</span>
                        }
                        <div class="small text-muted">@appointment.StartDateTime.ToString("HH:mm")&ndash;@appointment.EndDateTime.ToString("HH:mm")</div>
                    </td>
                    <td>@appointment.ClientName</td>
                    <td>
                        @appointment.AppointmentType.GetDisplayName()
                        <div class="small text-muted">@appointment.Mode.GetDisplayName()</div>
                    </td>
                    <td><span class="badge @StatusBadges.For(appointment.Status)">@appointment.Status.GetDisplayName()</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm @(appointment.Status == AppointmentStatus.Pending ? "btn-primary" : "btn-outline-primary")"
                           asp-action="Details" asp-route-id="@appointment.AppointmentId">@(appointment.Status == AppointmentStatus.Pending ? "Review" : "Open")</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
