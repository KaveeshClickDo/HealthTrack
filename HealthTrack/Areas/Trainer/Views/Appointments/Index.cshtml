@model TrainerAppointmentsViewModel
@{
    ViewData["Title"] = "Appointments";
    ViewData["Today"] = Model.Today;
    var pager = new PagerViewModel(Model.Past.Page, Model.Past.TotalPages, Model.Past.TotalCount, new Dictionary<string, string?>());
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Appointments</h1>
    <a class="btn btn-outline-primary" asp-controller="Availability" asp-action="Index">My availability</a>
</div>

<section class="card shadow-sm mb-4">
    <div class="card-body pb-0">
        <h2 class="h5">
            Requests waiting for you
            @if (Model.Pending.Count > 0)
            {
                <span class="badge text-bg-secondary ms-1">@Model.Pending.Count</span>
            }
        </h2>
    </div>
    @if (Model.Pending.Count == 0)
    {
        <p class="text-muted px-3 pb-3 mb-0">No requests to decide on. New bookings appear here and in your notifications.</p>
    }
    else
    {
        <partial name="_AppointmentTable" model="Model.Pending" />
    }
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body pb-0">
        <h2 class="h5">Today and upcoming</h2>
    </div>
    @if (Model.Upcoming.Count == 0)
    {
        <p class="text-muted px-3 pb-3 mb-0">
            Nothing booked from today on. Clients can book you inside your <a asp-controller="Availability" asp-action="Index">availability windows</a>.
        </p>
    }
    else
    {
        <partial name="_AppointmentTable" model="Model.Upcoming" />
    }
</section>

<section class="card shadow-sm">
    <div class="card-body pb-0">
        <h2 class="h5">Past</h2>
    </div>
    @if (Model.Past.TotalCount == 0)
    {
        <p class="text-muted px-3 pb-3 mb-0">No past appointments yet.</p>
    }
    else
    {
        <partial name="_AppointmentTable" model="Model.Past.Items" />
    }
</section>

<partial name="_Pager" model="pager" />
