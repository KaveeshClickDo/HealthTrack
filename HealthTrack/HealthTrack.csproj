<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Run as "dotnet HealthTrack.dll" instead of a HealthTrack.exe launcher: Windows Smart App Control blocks
         freshly built, unsigned .exe files ("An Application Control policy has blocked this file"), while dotnet.exe
         is signed by Microsoft. Visual Studio and dotnet run both start the app through dotnet this way. -->
    <UseAppHost>false</UseAppHost>
    <!-- Every public member has an XML comment (a marked convention); generating the file makes a missing one a CS1591 warning. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pins the patched version: Microsoft.Data.SqlClient 6.1.7 (via EF Core SqlServer) pulls in
         9.0.11, which has advisories GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. Remove once EF Core
         depends on a SqlClient that no longer needs it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
